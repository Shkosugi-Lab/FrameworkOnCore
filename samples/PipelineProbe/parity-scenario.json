    { "action": "snapshot", "name": "transfer-Response.End: what ran after it" },
    { "action": "goto", "path": "/Throw.aspx" },
    { "action": "snapshot", "name": "error-an exception: the error page" },
    { "action": "goto", "path": "/Throw.aspx?kind=403" },
    { "action": "snapshot", "name": "error-HttpException 403: the error page" },
    { "action": "goto", "path": "/Throw.aspx?kind=404" },
    { "action": "snapshot", "name": "error-HttpException 404: the 404 page" },
    { "action": "goto", "path": "/Missing.aspx" },
    { "action": "snapshot", "name": "error-a page that is not: the 404 page" },
    { "action": "goto", "path": "/Throw.aspx?clear=1" },
    { "action": "snapshot", "name": "error-handled by Application_Error" },
    { "action": "goto", "path": "/Handled.aspx" },
    { "action": "snapshot", "name": "error-handled by Page_Error" },
    { "action": "goto", "path": "/Check.htm?h=x-probe-module,content-type,cache-control,x-aspnet-version&u=/Events.aspx&u=/x.probe&u=/a.aprobe&u=/Check.htm&u=/Throw.aspx&u=/Throw.aspx%3Fkind%3D404&u=/Missing.aspx&u=/missing.txt&u=/Throw.aspx%3Fclear%3D1&u=/Handled.aspx" },
    { "action": "snapshot", "name": "check-the answers' status and headers" }
  ],
  "crawl": {
    "max": 30,
