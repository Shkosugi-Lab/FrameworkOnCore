From 53d14a10d9b71d9b7ddc1f84154c609283ef5c1c Mon Sep 17 00:00:00 2001
From: shkosugi <sin.kosugi@gmail.com>
Date: Sat, 26 Sep 2026 21:44:28 +0900
Subject: [PATCH 4/7] ApplicationServices: find System.Web types by the runtime
 assembly name; friends with the runtime keys

Type.GetType looked for MembershipAdapter / WebBaseEvent in WebFormsForCore.Web, but the
assembly is named System.Web (MembershipUser threw 'Client Profile'). InternalsVisibleTo
checks the friend's full public key at run time, and FakeStrongName stamps the Microsoft
keys on System.Web / System.Web.Extensions, so the friends carry those keys too.
---
 .../System/Configuration/SettingsPropertyValue.cs               | 2 +-
 .../Properties/AssemblyInfo.cs                                  | 2 ++
 .../Util/SystemWebProxy.cs                                      | 2 +-
 .../Properties/AssemblyInfo.cs                                  | 2 ++
 src/WebFormsForCore.Web/Properties/AssemblyInfo.cs              | 2 ++
 5 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/WebFormsForCore.Configuration/System/Configuration/SettingsPropertyValue.cs b/src/WebFormsForCore.Configuration/System/Configuration/SettingsPropertyValue.cs
index 0a7df24..cb4128c 100644
--- a/src/WebFormsForCore.Configuration/System/Configuration/SettingsPropertyValue.cs
+++ b/src/WebFormsForCore.Configuration/System/Configuration/SettingsPropertyValue.cs
@@ -157,7 +157,7 @@ namespace System.Configuration
 #if NETFRAMEWORK
                             Type.GetType("System.Web.Management.WebBaseEvent, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a", true).InvokeMember("RaisePropertyDeserializationWebErrorEvent", BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.InvokeMethod, (Binder) null, (object) null, args, CultureInfo.InvariantCulture);
 #else
-							Type.GetType("System.Web.Management.WebBaseEvent, WebFormsForCore.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a", true).InvokeMember("RaisePropertyDeserializationWebErrorEvent", BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.InvokeMethod, (Binder)null, (object)null, args, CultureInfo.InvariantCulture);
+							Type.GetType("System.Web.Management.WebBaseEvent, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a", true).InvokeMember("RaisePropertyDeserializationWebErrorEvent", BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.InvokeMethod, (Binder)null, (object)null, args, CultureInfo.InvariantCulture);
 #endif
 						}
 					}
diff --git a/src/WebFormsForCore.Web.ApplicationServices/Properties/AssemblyInfo.cs b/src/WebFormsForCore.Web.ApplicationServices/Properties/AssemblyInfo.cs
index 699f547..bd99e6c 100644
--- a/src/WebFormsForCore.Web.ApplicationServices/Properties/AssemblyInfo.cs
+++ b/src/WebFormsForCore.Web.ApplicationServices/Properties/AssemblyInfo.cs
@@ -9,6 +9,8 @@ using System.Security;
 [assembly: InternalsVisibleTo("System.Web, ")]
 #else
 [assembly: InternalsVisibleTo("System.Web, ")]
+// At run time the friend carries the key FakeStrongName stamps on it (the original Microsoft key), not the build signing key above; both are needed.
+[assembly: InternalsVisibleTo("System.Web, ")]
 [assembly: InternalsVisibleTo("WebFormsForCore.Web, ")]
 #endif
 
diff --git a/src/WebFormsForCore.Web.ApplicationServices/Util/SystemWebProxy.cs b/src/WebFormsForCore.Web.ApplicationServices/Util/SystemWebProxy.cs
index cc7150c..18a7a23 100644
--- a/src/WebFormsForCore.Web.ApplicationServices/Util/SystemWebProxy.cs
+++ b/src/WebFormsForCore.Web.ApplicationServices/Util/SystemWebProxy.cs
@@ -18,7 +18,7 @@ namespace System.Web.Util
 #if NETFRAMEWORK
             Type type = Type.GetType("System.Web.Security.MembershipAdapter, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a", false);
 #else
-			Type type = Type.GetType("System.Web.Security.MembershipAdapter, WebFormsForCore.Web", false);
+			Type type = Type.GetType("System.Web.Security.MembershipAdapter, System.Web", false); // the package WebFormsForCore.Web ships the assembly System.Web
 #endif
 			return type != (Type)null ? (IMembershipAdapter)SystemWebProxy.DangerousCreateInstance(type) : (IMembershipAdapter)null;
 		}
diff --git a/src/WebFormsForCore.Web.RegularExpressions/Properties/AssemblyInfo.cs b/src/WebFormsForCore.Web.RegularExpressions/Properties/AssemblyInfo.cs
index 53fe7a5..953ae16 100644
--- a/src/WebFormsForCore.Web.RegularExpressions/Properties/AssemblyInfo.cs
+++ b/src/WebFormsForCore.Web.RegularExpressions/Properties/AssemblyInfo.cs
@@ -10,6 +10,8 @@ using System.Security;
 #else
 [assembly: InternalsVisibleTo("WebFormsForCore.Web, ")]
 [assembly: InternalsVisibleTo("System.Web, ")]
+// At run time the friend carries the key FakeStrongName stamps on it (the original Microsoft key), not the build signing key above; both are needed.
+[assembly: InternalsVisibleTo("System.Web, ")]
 //[assembly: InternalsVisibleTo("System.Web, ")]
 #endif
 
diff --git a/src/WebFormsForCore.Web/Properties/AssemblyInfo.cs b/src/WebFormsForCore.Web/Properties/AssemblyInfo.cs
index 463324e..8c2bd0d 100644
--- a/src/WebFormsForCore.Web/Properties/AssemblyInfo.cs
+++ b/src/WebFormsForCore.Web/Properties/AssemblyInfo.cs
@@ -21,6 +21,8 @@ using System.Web.Security;
 [assembly: InternalsVisibleTo("System.Design, ")]
 [assembly: InternalsVisibleTo("System.Web.Extensions, ")]
 [assembly: InternalsVisibleTo("System.Web.Extensions, ")]
+// At run time the friend carries the key FakeStrongName stamps on it (the original Microsoft key), not the build signing key above; both are needed.
+[assembly: InternalsVisibleTo("System.Web.Extensions, ")]
 [assembly: InternalsVisibleTo("System.Web.Extensions.Test, ")]
 [assembly: InternalsVisibleTo("System.Web.Test, ")]
 [assembly: InternalsVisibleTo("System.Web.Routing.Test, ")]
