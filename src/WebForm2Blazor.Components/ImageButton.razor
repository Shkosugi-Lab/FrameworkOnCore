@namespace WebForm2Blazor.Components
@implements IButtonControl
@inherits WebControl
@inject IJSRuntime JSRuntime

@if (Visible)
{
    @* WebForms ImageButton renders <input type="image" src alt>. The event pipeline
       mirrors Button (client click / validation / Click / Command). *@
    <input @attributes="ExtraAttributes" style="@ComputedStyle" type="image" id="@ClientID" class="@CssClass"
           src="@UrlMapper.ResolveUrl(ImageUrl)"
           alt="@(string.IsNullOrEmpty(AlternateText) ? null : AlternateText)"
           disabled="@(!Enabled)" @onclick="HandleClick" @onclick:preventDefault />
}

@code {
    private string _imageUrl;

    [Parameter]
    public string ImageUrl
    {
        get => _imageUrl;
        set => SetAndRefresh(ref _imageUrl, value);
    }

    [Parameter] public string AlternateText { get; set; }

    /// <summary>WebForms ImageButton.Click equivalent ((object, ImageClickEventArgs)).</summary>
    [Parameter] public ImageClickEventHandler OnClick { get; set; }

    /// <summary>
    /// WebForms Click as a CLR event: code-behind wires handlers imperatively
    /// (control.Click += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event ImageClickEventHandler Click;

    /// <summary>WebForms OnClick (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void ClickHandler(ImageClickEventArgs e)
    {
        OnClick?.Invoke(this, e);
        Click?.Invoke(this, e);
    }

    [Parameter] public bool CausesValidation { get; set; } = true;
    [Parameter] public string ValidationGroup { get; set; }
    [Parameter] public string OnClientClick { get; set; }
    [Parameter] public string CommandName { get; set; }
    [Parameter] public string CommandArgument { get; set; }

    /// <summary>WebForms PostBackUrl. Carried and inert - there is no postback to target.</summary>
    [Parameter] public string PostBackUrl { get; set; }

    /// <summary>
    /// IButtonControl.Text. An ImageButton has no text of its own in WebForms either -
    /// AlternateText is what it renders - so this maps onto that rather than inventing a
    /// second caption the control would never draw.
    /// </summary>
    public string Text { get => AlternateText; set => AlternateText = value; }
    [Parameter] public CommandEventHandler OnCommand { get; set; }

    /// <summary>
    /// WebForms Command as a CLR event: code-behind wires handlers imperatively
    /// (control.Command += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event CommandEventHandler Command;

    /// <summary>WebForms OnCommand (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void CommandHandler(CommandEventArgs e)
    {
        OnCommand?.Invoke(this, e);
        Command?.Invoke(this, e);
    }

    [CascadingParameter] protected ICommandSink CommandSink { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!string.IsNullOrWhiteSpace(OnClientClick))
        {
            var result = await JSRuntime.InvokeAsync<bool?>("eval", $"(function() {{ {OnClientClick} }})()");
            if (result == false)
            {
                return;
            }
        }

        if (CausesValidation)
        {
            Host?.HostCore.Validate(ValidationGroup ?? "");
        }
        else if (Host is not null)
        {
            Host.HostCore.IsValid = true;
        }

        ClickHandler(new ImageClickEventArgs((int)e.OffsetX, (int)e.OffsetY));

        var args = new CommandEventArgs(CommandName ?? "", CommandArgument);
        CommandHandler(args);
        CommandSink?.RaiseCommand(this, args);

        Host?.HostCore.NotifyPostBackEvent();
    }
}
