@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms MultiView equivalent: renders the View at ActiveViewIndex and nothing else.

   Every View stays in the tree - only the inactive ones render no markup - so an @ref
   field pointing at a control inside a hidden View is still assigned, which is what
   WebForms did (the control existed; it just was not rendered). *@
@if (Visible)
{
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
}

@code {
    private readonly List<View> _views = new();
    private int _activeViewIndex = -1;
    private bool _viewsChanged;

    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// WebForms ActiveViewIndex. -1 (the default) shows nothing, as in WebForms.
    /// </summary>
    [Parameter]
    public int ActiveViewIndex
    {
        get => _activeViewIndex;
        set
        {
            if (_activeViewIndex != value)
            {
                SetAndRefresh(ref _activeViewIndex, value);
                NotifyViews();
            }
        }
    }

    /// <summary>WebForms Views collection.</summary>
    public IReadOnlyList<View> Views => _views;

    /// <summary>WebForms GetActiveView().</summary>
    public View GetActiveView()
        => _activeViewIndex >= 0 && _activeViewIndex < _views.Count ? _views[_activeViewIndex] : null;

    /// <summary>WebForms SetActiveView(View).</summary>
    public void SetActiveView(View view)
    {
        var index = _views.IndexOf(view);
        if (index >= 0)
        {
            ActiveViewIndex = index;
        }
    }

    /// <summary>Called by View on initialization; returns the view's index.</summary>
    internal int RegisterView(View view)
    {
        _views.Add(view);
        _viewsChanged = true;
        return _views.Count - 1;
    }

    internal bool IsActive(int index) => index == _activeViewIndex;

    /// <summary>
    /// Views freeze their parameters once touched (WebFormsControlBase), so a parent
    /// re-render does not reach them; visibility changes are pushed explicitly.
    /// </summary>
    private void NotifyViews()
    {
        foreach (var view in _views)
        {
            view.RefreshVisibility();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // ActiveViewIndex may name a view that had not registered yet on the first pass.
        if (_viewsChanged)
        {
            _viewsChanged = false;
            StateHasChanged();
        }
    }
}
