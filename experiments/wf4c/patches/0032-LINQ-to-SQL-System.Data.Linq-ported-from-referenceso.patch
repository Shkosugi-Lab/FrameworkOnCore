+            ParameterExpression p = Expression.Parameter(value.Type, "p");
+            LambdaExpression lambda = Expression.Lambda(Expression.Equal(p, value), p);
+            return this.VisitQuantifier(this.CoerceToSequence(seqNode), lambda, true);
