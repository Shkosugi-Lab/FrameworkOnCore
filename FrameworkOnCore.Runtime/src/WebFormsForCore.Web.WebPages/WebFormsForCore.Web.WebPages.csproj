<Project Sdk="Microsoft.NET.Sdk">
    <!-- System.Web.WebPages of AspNetWebStack v3.3.0 (github.com/aspnet/AspNetWebStack, Apache 2.0: LICENSE-AspNetWebStack.txt), ported
         to .NET 10 on FrameworkOnCore's System.Web (experiments/wf4c/port-aspnetwebstack.py writes this file). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>13</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);1591;CS0618;CS0672;SYSLIB0003;SYSLIB0011;SYSLIB0012;SYSLIB0050;SYSLIB0051</NoWarn>
        <DefineConstants>$(DefineConstants);ASPNETWEBPAGES;WebFormsForCore</DefineConstants>
        <RootNamespace>System.Web.WebPages</RootNamespace>
        <AssemblyName>System.Web.WebPages</AssemblyName>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <PackageId>FrameworkOnCore.Web.WebPages</PackageId>
        <Description>System.Web.WebPages (AspNetWebStack v3.3.0) on .NET 10, for FrameworkOnCore</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/aspnet/AspNetWebStack</PackageProjectUrl>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Shared/CommonResources.resx" LogicalName="System.Web.WebPages.Common.CommonResources.resources" />
        <EmbeddedResource Include="Resources/WebPageResources.resx" LogicalName="System.Web.WebPages.Resources.WebPageResources.resources" />
        <None Include="LICENSE-AspNetWebStack.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Data.Linq\WebFormsForCore.Data.Linq.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Web.Infrastructure\WebFormsForCore.Web.Infrastructure.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Web.Razor\WebFormsForCore.Web.Razor.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Web.WebPages.Deployment\WebFormsForCore.Web.WebPages.Deployment.csproj" />
        <PackageReference Include="System.CodeDom" Version="10.0.0" />
    </ItemGroup>
    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>31bf3856ad364e35</StrongNamePublicKeyToken>
    </PropertyGroup>
    <Target Name="ChangeAliasesOfNugetRefs" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- .NET's System.Web (HttpUtility's type forwards): FrameworkOnCore's is the one -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND '%(ReferencePath.FrameworkReferenceName)' != ''" />
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Drawing' AND '%(ReferencePath.FrameworkReferenceName)' != ''" />
            <!-- .NET's System.Configuration.ConfigurationManager (a package other references bring): FrameworkOnCore's port is the one -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[/\x5C]system\.configuration\.configurationmanager[/\x5C]'))" />
        </ItemGroup>
    </Target>
    <Import Project="..\FrameworkOnCore.Translations.targets" />
</Project>
