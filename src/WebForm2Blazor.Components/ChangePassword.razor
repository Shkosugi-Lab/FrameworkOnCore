@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms ChangePassword equivalent.

   Same bargain as Login: the application's own ChangePasswordTemplate is rendered when
   there is one, and the default form otherwise, so the page shows a form instead of
   nothing. Changing the password is NOT done here - membership is gone - but
   ChangingPassword / ChangedPassword / ChangePasswordError are raised, so an application
   that did the work in those handlers keeps working. *@
@if (Visible)
{
    <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">
        @if (_succeeded && SuccessTemplate is not null)
        {
            @SuccessTemplate
        }
        else if (ChangePasswordTemplate is not null)
        {
            @ChangePasswordTemplate
        }
        else if (_succeeded)
        {
            <span class="changepassword-success">@SuccessText</span>
        }
        else
        {
            @if (DisplayUserName)
            {
                <div class="changepassword-username">
                    <label for="@(ClientID)_UserName">@UserNameLabelText</label>
                    <input id="@(ClientID)_UserName" type="text" value="@UserName"
                           @onchange="e => UserName = e.Value?.ToString()" />
                </div>
            }
            <div class="changepassword-current">
                <label for="@(ClientID)_Current">@PasswordLabelText</label>
                <input id="@(ClientID)_Current" type="password" value="@CurrentPassword"
                       @onchange="e => CurrentPassword = e.Value?.ToString()" />
            </div>
            <div class="changepassword-new">
                <label for="@(ClientID)_New">@NewPasswordLabelText</label>
                <input id="@(ClientID)_New" type="password" value="@NewPassword"
                       @onchange="e => NewPassword = e.Value?.ToString()" />
            </div>
            <div class="changepassword-confirm">
                <label for="@(ClientID)_Confirm">@ConfirmNewPasswordLabelText</label>
                <input id="@(ClientID)_Confirm" type="password" value="@ConfirmNewPassword"
                       @onchange="e => ConfirmNewPassword = e.Value?.ToString()" />
            </div>
            <button type="button" @onclick="Submit">@ChangePasswordButtonText</button>
            <button type="button" @onclick="Cancel">@CancelButtonText</button>
            @if (!string.IsNullOrEmpty(_failure))
            {
                <span class="changepassword-failure">@_failure</span>
            }
        }
    </div>
}

@code {
    private string _failure;
    private bool _succeeded;

    [Parameter] public RenderFragment ChangePasswordTemplate { get; set; }
    [Parameter] public RenderFragment SuccessTemplate { get; set; }

    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public bool DisplayUserName { get; set; }
    [Parameter] public string MembershipProvider { get; set; } = string.Empty;
    [Parameter] public string ContinueDestinationPageUrl { get; set; } = string.Empty;
    [Parameter] public string CancelDestinationPageUrl { get; set; } = string.Empty;
    [Parameter] public string SuccessPageUrl { get; set; } = string.Empty;

    [Parameter] public string UserNameLabelText { get; set; } = "User Name:";
    [Parameter] public string PasswordLabelText { get; set; } = "Password:";
    [Parameter] public string NewPasswordLabelText { get; set; } = "New Password:";
    [Parameter] public string ConfirmNewPasswordLabelText { get; set; } = "Confirm New Password:";
    [Parameter] public string ChangePasswordButtonText { get; set; } = "Change Password";
    [Parameter] public string CancelButtonText { get; set; } = "Cancel";
    [Parameter] public string SuccessText { get; set; } = "Your password has been changed!";
    [Parameter] public string ChangePasswordFailureText { get; set; } = "Password incorrect or New Password invalid.";

    /// <summary>
    /// WebForms ChangePassword.RenderOuterTable. Same terms as Login: the compat control
    /// renders a div rather than the 4.8 table either way, so this is carried and not acted
    /// on - turning off a table that is not rendered has nothing to turn off.
    /// </summary>
    [Parameter] public bool RenderOuterTable { get; set; } = true;

    /// <summary>
    /// WebForms ChangePassword.ChangePasswordTemplateContainer equivalent: the container
    /// the ChangePasswordTemplate is instantiated into.
    ///
    /// Code-behind reaches the template's own controls through it -
    /// "ChangePassword1.ChangePasswordTemplateContainer.FindControl("NewPasswordRequired")"
    /// - which mojoPortal does 34 times to wire up its validators. The lookup is answered
    /// by this control, whose FindControl already resolves through the owning host, so the
    /// template's controls are found where they actually are.
    ///
    /// Where it differs from the original: WebForms searches the template's own subtree,
    /// so an id declared elsewhere on the page would be found here and not there. Handing
    /// back null instead was the alternative and it is worse - it reads as "the template
    /// has no such control" for the one lookup this property exists to serve.
    /// </summary>
    public IWebFormsControl ChangePasswordTemplateContainer => this;

    /// <summary>
    /// WebForms SuccessTemplateContainer equivalent, on the same terms.
    /// </summary>
    public IWebFormsControl SuccessTemplateContainer => this;

    // --- The rest of the WebForms ChangePassword declaration surface.
    //
    //     Text, URL and button-type slots. The compat control renders its own default form
    //     and does not read most of these; mojoPortal replaces the rendering entirely with
    //     a ChangePasswordAdapter that reads all of them. Carrying the values is therefore
    //     the whole job here - and the DEFAULTS are the job's substance, because an
    //     adapter that finds an empty string where 4.8 put "Change Password" renders a
    //     button with no label. Every default below is the one the original declares. ---
    [Parameter] public string ChangePasswordTitleText { get; set; } = "Change Your Password";
    [Parameter] public string SuccessTitleText { get; set; } = "Change Password Complete";
    [Parameter] public string InstructionText { get; set; } = string.Empty;
    [Parameter] public string ContinueButtonText { get; set; } = "Continue";

    [Parameter] public ButtonType ChangePasswordButtonType { get; set; } = ButtonType.Button;
    [Parameter] public ButtonType CancelButtonType { get; set; } = ButtonType.Button;
    [Parameter] public ButtonType ContinueButtonType { get; set; } = ButtonType.Button;

    [Parameter] public string ChangePasswordButtonImageUrl { get; set; } = string.Empty;
    [Parameter] public string CancelButtonImageUrl { get; set; } = string.Empty;
    [Parameter] public string ContinueButtonImageUrl { get; set; } = string.Empty;

    [Parameter] public string CreateUserText { get; set; } = string.Empty;
    [Parameter] public string CreateUserUrl { get; set; } = string.Empty;
    [Parameter] public string CreateUserIconUrl { get; set; } = string.Empty;
    [Parameter] public string HelpPageText { get; set; } = string.Empty;
    [Parameter] public string HelpPageUrl { get; set; } = string.Empty;
    [Parameter] public string HelpPageIconUrl { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryText { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryUrl { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryIconUrl { get; set; } = string.Empty;

    // Validation messages. WebForms shows these when its own validators fire; the compat
    // control has no validators of its own, so they are carried for the adapter that does.
    [Parameter] public string PasswordRequiredErrorMessage { get; set; } = "Password is required.";
    [Parameter] public string NewPasswordRequiredErrorMessage { get; set; } = "New Password is required.";
    [Parameter] public string ConfirmPasswordRequiredErrorMessage { get; set; } = "Confirm New Password is required.";
    [Parameter] public string ConfirmPasswordCompareErrorMessage { get; set; }
        = "The Confirm New Password must match the New Password entry.";
    [Parameter] public string UserNameRequiredErrorMessage { get; set; } = "User Name is required.";
    [Parameter] public string NewPasswordRegularExpression { get; set; } = string.Empty;
    [Parameter] public string NewPasswordRegularExpressionErrorMessage { get; set; } = string.Empty;

    // --- Style slots. The compat control renders none of them; mojoPortal's
    //     ChangePasswordAdapter does its own rendering and reads the CssClass off each.
    //     Plain objects with the original's empty default: this control has no flattened
    //     style parameter for them, so there is nothing to be a view over, and markup that
    //     declares one is reported as an unmapped attribute rather than silently absorbed. ---
    public TableItemStyle LabelStyle { get; } = new();
    public TableItemStyle TextBoxStyle { get; } = new();
    public TableItemStyle ValidatorTextStyle { get; } = new();
    public TableItemStyle TitleTextStyle { get; } = new();
    public TableItemStyle InstructionTextStyle { get; } = new();
    public TableItemStyle SuccessTextStyle { get; } = new();
    public TableItemStyle FailureTextStyle { get; } = new();
    public TableItemStyle HyperLinkStyle { get; } = new();
    public TableItemStyle ChangePasswordButtonStyle { get; } = new();
    public TableItemStyle CancelButtonStyle { get; } = new();
    public TableItemStyle ContinueButtonStyle { get; } = new();
    public TableItemStyle PasswordHintStyle { get; } = new();

    /// <summary>Settable here, unlike the WebForms control - the template's textboxes are
    /// the application's own, so it is the page that fills these in.</summary>
    public string CurrentPassword { get; set; } = string.Empty;
    public string NewPassword { get; set; } = string.Empty;
    public string ConfirmNewPassword { get; set; } = string.Empty;

    [Parameter] public EventHandler<LoginCancelEventArgs> OnChangingPassword { get; set; }
    [Parameter] public EventHandler OnChangedPassword { get; set; }
    [Parameter] public EventHandler OnChangePasswordError { get; set; }
    [Parameter] public EventHandler OnCancelButtonClick { get; set; }
    [Parameter] public EventHandler OnContinueButtonClick { get; set; }

    public event EventHandler<LoginCancelEventArgs> ChangingPassword
    {
        add => OnChangingPassword += value;
        remove => OnChangingPassword -= value;
    }

    public event EventHandler ChangedPassword
    {
        add => OnChangedPassword += value;
        remove => OnChangedPassword -= value;
    }

    public event EventHandler ChangePasswordError
    {
        add => OnChangePasswordError += value;
        remove => OnChangePasswordError -= value;
    }

    public event EventHandler CancelButtonClick
    {
        add => OnCancelButtonClick += value;
        remove => OnCancelButtonClick -= value;
    }

    public event EventHandler ContinueButtonClick
    {
        add => OnContinueButtonClick += value;
        remove => OnContinueButtonClick -= value;
    }

    /// <summary>
    /// WebForms order: ChangingPassword (cancellable), then ChangedPassword or
    /// ChangePasswordError. With no handler the attempt fails - there is no membership
    /// provider behind this, and reporting success would be a lie.
    /// </summary>
    private void Submit()
    {
        _failure = null;

        var args = new LoginCancelEventArgs();
        OnChangingPassword?.Invoke(this, args);

        if (args.Cancel || OnChangedPassword is null)
        {
            _failure = ChangePasswordFailureText;
            OnChangePasswordError?.Invoke(this, EventArgs.Empty);
        }
        else
        {
            _succeeded = true;
            OnChangedPassword.Invoke(this, EventArgs.Empty);
        }

        Host?.HostCore.NotifyPostBackEvent();
    }

    private void Cancel()
    {
        OnCancelButtonClick?.Invoke(this, EventArgs.Empty);
        if (!string.IsNullOrEmpty(CancelDestinationPageUrl))
        {
            HttpContext.Current?.Response?.Redirect(CancelDestinationPageUrl);
        }
        Host?.HostCore.NotifyPostBackEvent();
    }
}
