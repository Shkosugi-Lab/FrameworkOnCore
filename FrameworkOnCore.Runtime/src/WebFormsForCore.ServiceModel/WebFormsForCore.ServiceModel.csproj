<Project Sdk="Microsoft.NET.Sdk">

    <!-- WCF's services of a converted application (.svc files, web.config's system.serviceModel) served by CoreWCF in its
         ASP.NET Core host, as IIS's WCF activation served them on .NET Framework (System.ServiceModel.Activation's identity:
         its AspNetCompatibilityRequirementsAttribute, which CoreWCF has not, is here). net10.0 only: the converted
         applications'. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>13</LangVersion>
        <AssemblyName>System.ServiceModel.Activation</AssemblyName>
        <RootNamespace>System.ServiceModel.Activation</RootNamespace>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <SignAssembly>True</SignAssembly>
        <AssemblyVersion>4.0.0.0</AssemblyVersion>
        <FileVersion>4.8.4084.0</FileVersion>

        <PackageId>FrameworkOnCore.ServiceModel</PackageId>
        <Title>FrameworkOnCore.ServiceModel</Title>
        <Authors>simonegli8</Authors>
        <Company>Estrellas de Esperanza</Company>
        <Product>WebFormsForCore.ServiceModel</Product>
        <Description>WCF services of ASP.NET applications (.svc, system.serviceModel) on .NET 10 with CoreWCF</Description>
        <Copyright>Estrellas de Esperanza</Copyright>
        <PackageProjectUrl>https://github.com/webformsforcore/WebFormsForCore</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/webformsforcore/WebFormsForCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>WCF;CoreWCF;svc;WebForms;NET 10</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!-- The versions FrameworkOnCore.Web.Extensions has. -->
        <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
        <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
        <PackageReference Include="CoreWCF.WebHttp" Version="1.9.1" />
        <!-- The contracts' attributes and the FaultException the converted services are compiled against (.NET's WCF client:
             CoreWCF takes those contracts; their faults are made CoreWCF's here). -->
        <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    </ItemGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <!-- .NET Framework's System.ServiceModel.Activation: the key of ASP.NET's shared libraries (31bf3856ad364e35). -->
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>31bf3856ad364e35</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
