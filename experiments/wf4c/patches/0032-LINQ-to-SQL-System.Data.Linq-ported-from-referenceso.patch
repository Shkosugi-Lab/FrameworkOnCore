+                        MethodInfo miFirst = TypeSystem.FindSequenceMethod("SingleOrDefault", new Type[] { seqType }, expectedType);
+                        System.Diagnostics.Debug.Assert(miFirst != null);
+                        gen.Emit(OpCodes.Call, miFirst);
