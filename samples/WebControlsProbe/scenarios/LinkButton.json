{
  "_comment": "The LinkButton's scenario layer (BasicsScenario.aspx; tests/WebControlsParity/README.md). A snapshot's tags are the mechanisms it covers. The log's request number is kept in view state: a click the browser cancelled leaves it as it was.",
  "ignorePatterns": [],
  "steps": [
    {
      "action": "goto",
      "path": "/BasicsScenario.aspx"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [render][databind][dynamic] first request"
    },
    {
      "action": "click",
      "target": "lnkSubmit"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [postbackevent][command][viewstate] a link: Click, then Command"
    },
    {
      "action": "click",
      "target": "lnkConfirmNo"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [clientclick] OnClientClick returns false: no request"
    },
    {
      "action": "click",
      "target": "lnkValidate"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [causesvalidation][postbackevent] validating g1 (empty)"
    },
    {
      "action": "click",
      "target": "lnkPick"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [command][databind] Command bubbled from a repeater item"
    },
    {
      "action": "fill",
      "target": "txtDefaultLink",
      "value": "enter"
    },
    {
      "action": "press",
      "target": "txtDefaultLink",
      "value": "Enter"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [defaultbutton] Enter in a panel whose DefaultButton is the link"
    },
    {
      "action": "click",
      "target": "lnkDynamic"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [dynamic][postbackevent] a dynamically created link"
    },
    {
      "action": "click",
      "target": "btnShow"
    },
    {
      "action": "click",
      "target": "lnkHidden"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [visible][viewstate][postbackevent] the link shown before raises Click"
    },
    {
      "action": "fill",
      "target": "txtCross",
      "value": "cross"
    },
    {
      "action": "click",
      "target": "lnkCross"
    },
    {
      "action": "snapshot",
      "name": "LinkButton [crosspage] cross-page postback (PostBackUrl)"
    }
  ]
}
