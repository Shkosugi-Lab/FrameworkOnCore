@namespace WebForm2Blazor.Components
@inherits ValidatorBase

@if (ShowError)
{
    <span @attributes="ExtraAttributes" style="@SpanStyle" id="@ClientID" class="@ResolvedCssClass">@DisplayText</span>
}

@code {
    [Parameter] public string MinimumValue { get; set; }
    [Parameter] public string MaximumValue { get; set; }

    /// <summary>String / Integer / Double / Date / Currency.</summary>
    [Parameter] public string Type { get; set; } = "String";

    protected override bool EvaluateIsValid(string value, WebFormsHostCore host)
    {
        // Empty input is valid, as in WebForms (RequiredFieldValidator owns the required check)
        if (string.IsNullOrEmpty(value.Trim()))
        {
            return true;
        }

        if (!TryConvert(value, Type, out var converted)
            || !TryConvert(MinimumValue ?? "", Type, out var minimum)
            || !TryConvert(MaximumValue ?? "", Type, out var maximum))
        {
            return false;
        }

        return converted.CompareTo(minimum) >= 0 && converted.CompareTo(maximum) <= 0;
    }
}
