{
  "_comment": "The session state (InProc, as IIS keeps it by default) against the converted application's: a new session, an object that is not serializable stored and changed in place, read-only and session-less pages and handlers, Remove, Clear, Abandon (Session_End) and the next session.",
  "ignorePatterns": [],
  "steps": [
    { "action": "goto", "path": "/Default.aspx" },
    { "action": "snapshot", "name": "session-first request: a new session, Session_Start" },
    { "action": "click", "target": "btnStore" },
    { "action": "snapshot", "name": "session-an object that is not serializable stored" },
    { "action": "click", "target": "btnSubmit" },
    { "action": "snapshot", "name": "session-the next request: the object kept" },
    { "action": "click", "target": "btnMutate" },
    { "action": "snapshot", "name": "session-the object changed in place" },
    { "action": "click", "target": "btnSubmit" },
    { "action": "snapshot", "name": "session-the next request: the change kept" },
    { "action": "goto", "path": "/ReadOnly.aspx" },
    { "action": "snapshot", "name": "session-a read-only page writes" },
    { "action": "goto", "path": "/Default.aspx" },
    { "action": "snapshot", "name": "session-after the read-only page's write" },
    { "action": "goto", "path": "/NoSession.aspx" },
    { "action": "snapshot", "name": "session-a page without session" },
    { "action": "goto", "path": "/Handler.ashx" },
    { "action": "snapshot", "name": "session-a handler with IRequiresSessionState" },
    { "action": "goto", "path": "/NoSessionHandler.ashx" },
    { "action": "snapshot", "name": "session-a handler without" },
    { "action": "goto", "path": "/Default.aspx" },
    { "action": "click", "target": "btnRemove" },
    { "action": "snapshot", "name": "session-an item removed" },
    { "action": "click", "target": "btnClear" },
    { "action": "snapshot", "name": "session-cleared" },
    { "action": "click", "target": "btnStore" },
    { "action": "click", "target": "btnAbandon" },
    { "action": "snapshot", "name": "session-abandoned: Session_End" },
    { "action": "click", "target": "btnSubmit" },
    { "action": "snapshot", "name": "session-after Abandon: a new session" }
  ]
}
