+                    break;
+                case SqlNodeType.Exists:
+                    clrType = typeof(bool);
+                    sqlType = typeProvider.From(typeof(bool));
+                    break;
+            }
+            return new SqlSubSelect(nt, clrType, sqlType, select);
+        }
