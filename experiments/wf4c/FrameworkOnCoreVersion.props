<Project>
  <!-- FrameworkOnCore's package version, from the one place it is written: src/FrameworkOnCore.Converter/rules/packages.json
       (frameworkOnCoreVersion). Given (-p:FrameworkOnCoreVersion=..., a shim's reference from a converted project), that
       one; without the rules (the shims alone, in a container), none. -->
  <PropertyGroup>
    <FrameworkOnCoreRules>$(MSBuildThisFileDirectory)../../src/FrameworkOnCore.Converter/rules/packages.json</FrameworkOnCoreRules>
    <FrameworkOnCoreVersion Condition="'$(FrameworkOnCoreVersion)' == '' And Exists('$(FrameworkOnCoreRules)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(FrameworkOnCoreRules)')), '(?s)^.*?"frameworkOnCoreVersion"\s*:\s*"([^"]+)".*$', '$1'))</FrameworkOnCoreVersion>
  </PropertyGroup>
</Project>
