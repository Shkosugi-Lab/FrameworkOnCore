@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase
@* WebForms Literal IS an ITextControl, and ported code passes one where that interface
   is asked for - YAF hands its literals to a helper typed against ITextControl. *@
@implements ITextControl

@if (Visible)
{
    @* WebForms Literal emits Text as raw HTML without any wrapping tag *@
    @((MarkupString)(Text ?? string.Empty))
}

@code {
    private string _text = string.Empty;

    [Parameter]
    public string Text
    {
        get => _text;
        set => SetAndRefresh(ref _text, value ?? string.Empty);
    }
}
