+            {
+                status = Gdip.GdipTranslateMatrix(new HandleRef(this, NativeMatrix), point.X, point.Y, order);
+                status |= Gdip.GdipRotateMatrix(new HandleRef(this, NativeMatrix), angle, order);
+                status |= Gdip.GdipTranslateMatrix(new HandleRef(this, NativeMatrix), -point.X, -point.Y, order);
+            }
+            else
+            {
+                status = Gdip.GdipTranslateMatrix(new HandleRef(this, NativeMatrix), -point.X, -point.Y, order);
+                status |= Gdip.GdipRotateMatrix(new HandleRef(this, NativeMatrix), angle, order);
+                status |= Gdip.GdipTranslateMatrix(new HandleRef(this, NativeMatrix), point.X, point.Y, order);
+            }
