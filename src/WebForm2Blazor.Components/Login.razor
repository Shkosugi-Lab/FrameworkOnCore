@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms Login equivalent.

   The application's own LayoutTemplate is rendered when there is one, which is the
   common case - the markup in the template IS the login form the site shows, and until
   now none of it reached the page. Without a template, the default form WebForms
   generated is rendered instead.

   Authenticating is NOT done here. Membership is gone and the converted application signs
   people in through ASP.NET Core, so this raises Authenticate / LoggingIn / LoginError
   and lets the page decide: an application that handled Authenticate itself - which is
   how a custom user store was always done - keeps working unchanged. One that relied on
   the membership provider gets FailureText and a residual saying so. *@
@if (Visible && !(VisibleWhenLoggedIn is false && IsAuthenticated))
{
    <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">
        @if (LayoutTemplate is not null)
        {
            @LayoutTemplate
        }
        else
        {
            <div class="login-username">
                <label for="@(ClientID)_UserName">@UserNameLabelText</label>
                <input id="@(ClientID)_UserName" type="text" value="@UserName"
                       @onchange="e => UserName = e.Value?.ToString()" />
            </div>
            <div class="login-password">
                <label for="@(ClientID)_Password">@PasswordLabelText</label>
                <input id="@(ClientID)_Password" type="password" value="@Password"
                       @onchange="e => Password = e.Value?.ToString()" />
            </div>
            @if (DisplayRememberMe)
            {
                <div class="login-rememberme">
                    <input id="@(ClientID)_RememberMe" type="checkbox" checked="@RememberMeSet"
                           @onchange="e => RememberMeSet = e.Value is true" />
                    <label for="@(ClientID)_RememberMe">@RememberMeText</label>
                </div>
            }
            <button type="button" @onclick="Submit">@LoginButtonText</button>
        }

        @if (!string.IsNullOrEmpty(_failure))
        {
            <span class="login-failure">@_failure</span>
        }
    </div>
}

@code {
    private string _failure;

    [Parameter] public RenderFragment LayoutTemplate { get; set; }

    [Parameter] public string UserName { get; set; }
    [Parameter] public string Password { get; set; }
    [Parameter] public bool RememberMeSet { get; set; }
    [Parameter] public bool DisplayRememberMe { get; set; } = true;
    [Parameter] public bool? VisibleWhenLoggedIn { get; set; }

    [Parameter] public string FailureText { get; set; } = "Your login attempt was not successful. Please try again.";
    [Parameter] public string UserNameLabelText { get; set; } = "User Name:";
    [Parameter] public string PasswordLabelText { get; set; } = "Password:";
    [Parameter] public string RememberMeText { get; set; } = "Remember me next time.";
    [Parameter] public string LoginButtonText { get; set; } = "Log In";
    [Parameter] public string DestinationPageUrl { get; set; }
    [Parameter] public string MembershipProvider { get; set; }

    // --- The rest of the WebForms Login declaration surface, on the same terms as
    //     ChangePassword: carried for whoever renders, with 4.8's defaults. mojoPortal's
    //     SiteLogin derives from this control and drives all of them. ---
    [Parameter] public string TitleText { get; set; } = "Log In";
    [Parameter] public string InstructionText { get; set; } = string.Empty;
    [Parameter] public string CreateUserText { get; set; } = string.Empty;
    [Parameter] public string CreateUserUrl { get; set; } = string.Empty;
    [Parameter] public string CreateUserIconUrl { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryText { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryUrl { get; set; } = string.Empty;
    [Parameter] public string PasswordRecoveryIconUrl { get; set; } = string.Empty;
    [Parameter] public string HelpPageText { get; set; } = string.Empty;
    [Parameter] public string HelpPageUrl { get; set; } = string.Empty;
    [Parameter] public string HelpPageIconUrl { get; set; } = string.Empty;
    [Parameter] public string UserNameRequiredErrorMessage { get; set; } = "User Name is required.";
    [Parameter] public string PasswordRequiredErrorMessage { get; set; } = "Password is required.";
    [Parameter] public ButtonType LoginButtonType { get; set; } = ButtonType.Button;
    [Parameter] public string LoginButtonImageUrl { get; set; } = string.Empty;
    [Parameter] public string Orientation { get; set; } = "Vertical";
    [Parameter] public string TextLayout { get; set; } = "TextOnLeft";

    /// <summary>
    /// WebForms Login.RenderOuterTable. The compat control renders a div rather than the
    /// 4.8 table either way, so this is carried and not acted on - turning off a table
    /// that is not rendered has nothing to turn off.
    /// </summary>
    [Parameter] public bool RenderOuterTable { get; set; } = true;

    // Style slots. Nothing here renders them; a ported Login that draws itself reads the
    // CssClass off each (see ChangePassword for why these are plain objects).
    public TableItemStyle LabelStyle { get; } = new();
    public TableItemStyle TextBoxStyle { get; } = new();
    public TableItemStyle ValidatorTextStyle { get; } = new();
    public TableItemStyle TitleTextStyle { get; } = new();
    public TableItemStyle InstructionTextStyle { get; } = new();
    public TableItemStyle FailureTextStyle { get; } = new();
    public TableItemStyle HyperLinkStyle { get; } = new();
    public TableItemStyle LoginButtonStyle { get; } = new();
    public TableItemStyle CheckBoxStyle { get; } = new();

    [Parameter] public EventHandler<AuthenticateEventArgs> OnAuthenticate { get; set; }
    [Parameter] public EventHandler OnLoggingIn { get; set; }
    [Parameter] public EventHandler OnLoggedIn { get; set; }
    [Parameter] public EventHandler OnLoginError { get; set; }

    public event EventHandler<AuthenticateEventArgs> Authenticate;

    /// <summary>WebForms OnAuthenticate (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void AuthenticateHandler(AuthenticateEventArgs e)
    {
        OnAuthenticate?.Invoke(this, e);
        Authenticate?.Invoke(this, e);
    }

    public event EventHandler LoggingIn;

    /// <summary>WebForms OnLoggingIn (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void LoggingInHandler(EventArgs e)
    {
        OnLoggingIn?.Invoke(this, e);
        LoggingIn?.Invoke(this, e);
    }

    public event EventHandler LoggedIn;

    /// <summary>WebForms OnLoggedIn (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void LoggedInHandler(EventArgs e)
    {
        OnLoggedIn?.Invoke(this, e);
        LoggedIn?.Invoke(this, e);
    }

    public event EventHandler LoginError;

    /// <summary>WebForms OnLoginError (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void LoginErrorHandler(EventArgs e)
    {
        OnLoginError?.Invoke(this, e);
        LoginError?.Invoke(this, e);
    }

    private static bool IsAuthenticated
        => HttpContext.Current?.User?.Identity?.IsAuthenticated == true;

    /// <summary>
    /// The WebForms order: LoggingIn, then Authenticate (which decides), then LoggedIn or
    /// LoginError. With no Authenticate handler the attempt fails - there is no membership
    /// provider behind this to ask, and reporting success would be a lie.
    /// </summary>
    private void Submit()
    {
        _failure = null;
        LoggingInHandler(EventArgs.Empty);

        var args = new AuthenticateEventArgs();
        AuthenticateHandler(args);

        if (args.Authenticated)
        {
            LoggedInHandler(EventArgs.Empty);
            if (!string.IsNullOrEmpty(DestinationPageUrl))
            {
                HttpContext.Current?.Response?.Redirect(DestinationPageUrl);
            }
        }
        else
        {
            _failure = FailureText;
            LoginErrorHandler(EventArgs.Empty);
        }

        Host?.HostCore.NotifyPostBackEvent();
    }
}
