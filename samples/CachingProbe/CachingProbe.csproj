      <DependentUpon>CacheApi.aspx</DependentUpon>
    </Compile>
    <Compile Include="Counter.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
