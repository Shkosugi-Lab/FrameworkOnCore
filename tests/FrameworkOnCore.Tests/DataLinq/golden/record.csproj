<Project Sdk="Microsoft.NET.Sdk">
  <!-- Records dlinq-sql.golden.json against .NET Framework's System.Data.Linq: run record.ps1 (Windows,
       needs a reachable SQL Server). Not part of the test build (the tests' csproj removes golden\**). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- 9, not net48's default 7.3: the shared sources carry #nullable disable for the tests' build. -->
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\TestStoreModel.cs" />
    <Compile Include="..\SqlCases.cs" />
    <Reference Include="System.Data.Linq" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
