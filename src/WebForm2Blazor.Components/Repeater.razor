@namespace WebForm2Blazor.Components
@inherits Control

@* Like the WebForms Repeater, Header/Footer are not rendered when there is no data *@
@if (Visible && _containers.Count > 0)
{
    if (WrapperTemplate is not null)
    {
        @WrapperTemplate(RenderItems)
    }
    else
    {
        @HeaderTemplate
        @RenderItems
        @FooterTemplate
    }
}

@code {
    private readonly List<RepeaterItem> _containers = new();
    private bool _pendingItemDataBound;

    [Parameter] public RenderFragment HeaderTemplate { get; set; }
    [Parameter] public RenderFragment<RepeaterItem> ItemTemplate { get; set; }
    [Parameter] public RenderFragment<RepeaterItem> AlternatingItemTemplate { get; set; }
    [Parameter] public RenderFragment SeparatorTemplate { get; set; }
    [Parameter] public RenderFragment FooterTemplate { get; set; }

    /// <summary>
    /// The WebForms pattern of opening a tag in HeaderTemplate and closing it in
    /// FooterTemplate, merged by the converter into a single template. Receives the
    /// rendered items as its context.
    /// </summary>
    [Parameter] public RenderFragment<RenderFragment> WrapperTemplate { get; set; }

    /// <summary>
    /// WebForms ItemCommand event equivalent. Commands from Button / LinkButton inside the
    /// templates bubble here ((object source, RepeaterCommandEventArgs e)).
    /// </summary>
    [Parameter] public RepeaterCommandEventHandler OnItemCommand { get; set; }

    /// <summary>
    /// WebForms ItemCommand as a CLR event: code-behind wires handlers imperatively
    /// (control.ItemCommand += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event RepeaterCommandEventHandler ItemCommand;

    /// <summary>WebForms OnItemCommand (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void ItemCommandHandler(RepeaterCommandEventArgs e)
    {
        OnItemCommand?.Invoke(this, e);
        ItemCommand?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms ItemDataBound equivalent. In WebForms it fires during DataBind; here the
    /// row's controls exist only after the row has rendered, so it fires right after the
    /// first render following DataBind (handlers using e.Item.FindControl see the row's
    /// controls either way). Fires for data items only - Header/Footer items are not
    /// separate items in this runtime.
    /// </summary>
    [Parameter] public RepeaterItemEventHandler OnItemDataBound { get; set; }

    /// <summary>
    /// WebForms ItemDataBound as a CLR event: code-behind wires handlers imperatively
    /// (control.ItemDataBound += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event RepeaterItemEventHandler ItemDataBound;

    /// <summary>WebForms OnItemDataBound (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void ItemDataBoundHandler(RepeaterItemEventArgs e)
    {
        OnItemDataBound?.Invoke(this, e);
        ItemDataBound?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms DataSource equivalent. Applied by DataBind() - explicitly from code-behind,
    /// or automatically (see OnParametersSet below) when the markup declares it
    /// declaratively (DataSource="&lt;%# Expr %&gt;"), the same idiom DataSourceID below
    /// already established: that markup has no code-behind DataBind() call to rely on.
    /// </summary>
    [Parameter] public object DataSource { get; set; }

    private bool _dataSourceBoundFromMarkup;

    /// <summary>
    /// WebForms declarative binding, as GridView and ListView already had.
    /// A Repeater with DataSourceID and no code-behind DataBind() call is how WebForms
    /// bound most lists, and dropping the attribute left the control rendering nothing at
    /// all - thirteen of them across the corpora, silently empty.
    /// </summary>
    [Parameter] public string DataSourceID { get; set; }

    /// <summary>
    /// WebForms DataMember equivalent: which table of a DataSet to bind. Accepted and
    /// unused - the compat data sources return one result set.
    /// </summary>
    [Parameter] public string DataMember { get; set; }

    /// <summary>
    /// WebForms Repeater.Items: the ROWS, not the data behind them.
    ///
    /// This used to hand back the DataItems, which reads naturally and is not what
    /// WebForms means. A RepeaterItem is a control: ported code walks Items and calls
    /// FindControl on each row to read the inputs it rendered - YAF's EditUsersGroups
    /// collects a checkbox and a label per group that way, and against a list of data
    /// items there is nothing to find. The data is still one step away, on
    /// Items[i].DataItem, exactly as it was in WebForms.
    /// </summary>
    public IReadOnlyList<RepeaterItem> Items => _containers;

    internal void RaiseItemCommand(object commandSource, RepeaterItem item, CommandEventArgs args)
        => ItemCommandHandler(new RepeaterCommandEventArgs(item, commandSource, args));

    private RenderFragment RenderItems => __builder =>
    {
        for (var index = 0; index < _containers.Count; index++)
        {
            var container = _containers[index];
            var commandContext = new RepeaterCommandContext(this, container);

            if (index > 0 && SeparatorTemplate is not null)
            {
                @SeparatorTemplate
            }

            <CascadingValue TValue="RepeaterItem" Value="container" IsFixed="true">
                <CascadingValue TValue="ICommandSink" Value="commandContext" IsFixed="true">
                    @(DataItemScope.Render(container, SelectTemplate(index)?.Invoke(container)))
                </CascadingValue>
            </CascadingValue>
        }
    };

    private RenderFragment<RepeaterItem> SelectTemplate(int index)
        => index % 2 == 1 && AlternatingItemTemplate is not null ? AlternatingItemTemplate : ItemTemplate;

    /// <summary>WebForms DataBind() equivalent.</summary>
    public override void DataBind()
    {
        RowContainers.Rebind(_containers, DataSourceHelper.Materialize(DataSource), namingContainerId: ID, owner: this);
        _pendingItemDataBound = true;
        StateHasChanged();
    }

    /// <summary>
    /// Binds a markup-declared DataSource once, on the FIRST call only - OnParametersSet
    /// runs again on every later re-render (e.g. the one DataBind() itself schedules via
    /// StateHasChanged), and by then the DataSourceID path below may have populated
    /// DataSource too; gating on "DataSource is not null yet" instead of a first-call flag
    /// re-fired on that later call and rebuilt the rows a second time.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_dataSourceBoundFromMarkup)
        {
            return;
        }
        _dataSourceBoundFromMarkup = true;
        if (DataSource is not null)
        {
            DataBind();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Declarative binding, the same shape ListView uses: the data source control is a
        // sibling in the page, so it can only be found once the tree has rendered once.
        if (firstRender && DataSource is null && !string.IsNullOrEmpty(DataSourceID)
            && Host?.HostCore.FindControl(DataSourceID) is ObjectDataSource dataSourceControl)
        {
            DataSource = dataSourceControl.Select();
            DataBind();
        }

        // The row controls have initialized by now; fire ItemDataBound once per DataBind
        if (_pendingItemDataBound)
        {
            _pendingItemDataBound = false;
            foreach (var container in _containers)
            {
                ItemDataBoundHandler(new RepeaterItemEventArgs(container));
            }
        }
    }
}
