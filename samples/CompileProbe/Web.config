<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- The culture of the browser's languages (Accept-Language), en-US when it asks none this has. -->
    <globalization culture="auto:en-US" uiCulture="auto:en-US" />
    <customErrors mode="Off" />
    <pages>
      <controls>
        <add tagPrefix="probe" tagName="Widget" src="~/Controls/Widget.ascx" />
      </controls>
    </pages>
  </system.web>
</configuration>
