<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- a folder's web.config: a header of the root's removed, one of its own -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Frame-Options" />
        <add name="X-Secure" value="secure" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
