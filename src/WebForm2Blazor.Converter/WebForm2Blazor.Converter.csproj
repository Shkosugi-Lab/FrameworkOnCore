<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebForm2Blazor.Converter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code-behind conversion works on the syntax tree (text replacement would break it) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Travels with the build. Without it the catalog was only found when the caller's
         current directory happened to be the repository root, and the conversion quietly
         produced different residuals depending on where the shell stood. -->
    <None Include="..\..\webforms-property-catalog.json"
          Link="webforms-property-catalog.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- References the compatibility components' public API via reflection, used by the
         code-behind used-API inventory and the property coverage audit -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\WebForm2Blazor.Components\WebForm2Blazor.Components.csproj" />
  </ItemGroup>

</Project>
