@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@if (Visible)
{
    <tr @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">@ChildContent</tr>
}

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <inheritdoc cref="Table.Rows"/>
    public List<TableCell> Cells { get; } = [];
}
