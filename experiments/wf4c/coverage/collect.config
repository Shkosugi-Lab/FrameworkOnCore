<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet-coverage settings (measure.py): FrameworkOnCore.Runtime's assemblies only, by the DLL's name. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*\\System\.Web(\.[A-Za-z.]+)?\.dll$</ModulePath>
        <ModulePath>.*\\System\.Drawing(\.Common)?\.dll$</ModulePath>
        <ModulePath>.*\\System\.Data\.(SqlClient|Linq)\.dll$</ModulePath>
        <ModulePath>.*\\System\.ServiceModel[A-Za-z.]*\.dll$</ModulePath>
        <ModulePath>.*\\System\.Configuration\.dll$</ModulePath>
        <ModulePath>.*\\AjaxControlToolkit\.dll$</ModulePath>
        <ModulePath>.*\\WebGrease\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*\\dotnet\\shared\\.*</ModulePath>
      </Exclude>
    </ModulePaths>
    <EnableStaticNativeInstrumentation>False</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
  </CodeCoverage>
</Configuration>
