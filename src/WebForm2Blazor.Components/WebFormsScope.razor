@namespace WebForm2Blazor.Components

@* Scope that lets the compatibility controls below register with their owning page /
   user control / layout. Used for FindControl and validator target resolution.
   A user control establishes its own scope so its children do not leak into the
   parent page's scope.

   A user control is also a WebForms NAMING CONTAINER, so its ID joins the ClientID
   prefix of everything inside it. Pages and layouts are not: the framework skips
   their auto-generated IDs (measured: "cphMain_cphBody_pLabel", never "ctl00_..."). *@
<CascadingValue Value="Owner" IsFixed="true">
    <CascadingValue Name="NamingContainerPrefix" Value="@ScopePrefix" IsFixed="true">
        @ChildContent
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public IWebFormsHost Owner { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    [CascadingParameter(Name = "NamingContainerPrefix")]
    private string AmbientPrefix { get; set; }

    private string ScopePrefix
        => Owner is WebFormsUserControl control && !string.IsNullOrEmpty(control.ID)
            ? AmbientPrefix + control.ID + "_"
            : AmbientPrefix;
}
