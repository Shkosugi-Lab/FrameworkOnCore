+            private Type GenerateClientQuery(SqlClientQuery cq, LocalBuilder locInstance) {
+                Type clientElementType = cq.Query.NodeType == SqlNodeType.Multiset ? TypeSystem.GetElementType(cq.ClrType) : cq.ClrType;
