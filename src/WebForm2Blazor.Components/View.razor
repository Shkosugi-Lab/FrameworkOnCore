@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms View equivalent: one page of a MultiView or Wizard. Renders its children only
   while it is the active one, and renders no wrapper element of its own - WebForms' View
   emits nothing around its content either. *@
@if (Visible && IsActive)
{
    @ChildContent
}

@code {
    private int _index;

    [Parameter] public RenderFragment ChildContent { get; set; }

    [CascadingParameter] internal MultiView OwnerMultiView { get; set; }

    /// <summary>
    /// True when this view is the one the owner is showing. A View outside a MultiView
    /// renders normally: ported markup does use one on its own as a plain container.
    /// </summary>
    private bool IsActive => OwnerMultiView is null || OwnerMultiView.IsActive(_index);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _index = OwnerMultiView?.RegisterView(this) ?? 0;
    }

    /// <summary>Called by the owning MultiView when the active view changes.</summary>
    internal void RefreshVisibility() => StateHasChanged();
}
