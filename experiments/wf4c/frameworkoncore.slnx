<Solution>
  <!-- The WebFormsForCore projects the experiment packs (pack-frameworkoncore.ps1). Not the AjaxControlToolkit submodule's control
       library: pack-frameworkoncore.ps1 builds it after them, for net10.0 only (its net8.0 build fails in the solution, CS7069). Built as a solution: built one by one, Web.Extensions fails.
       Not WebFormsForCore.Build: build it once beforehand. Rebuilt here, copying its task DLL
       collides with the MSBuild nodes that have it loaded. -->
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Compilers/WebFormsForCore.Compilers.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Configuration/WebFormsForCore.Configuration.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Drawing.Common/WebFormsForCore.Drawing.Common.csproj" />
