<Project Sdk="Microsoft.NET.Sdk">
  <!-- Types .NET Framework had that DLLs without source refer to and the sources must not see: a converted project does
       not compile against this assembly, its build copies it to the output (the converter's ProjectReference:
       ReferenceOutputAssembly false), and the DLLs' references to its types are retargeted to it (AssemblyRetargeter).
       System.Data.EntityState (EF 1-4): in the sources, EF 6's System.Data.Entity.EntityState would be ambiguous with it
       (using System.Data; using System.Data.Entity;). System.Data.Linq.Binary was here until the LINQ to SQL port
       (FrameworkOnCore.Data.Linq) brought the whole assembly; a DLL's reference now binds to it (ReferencedMissing). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FrameworkOnCore.Compat.ForDlls</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
</Project>
