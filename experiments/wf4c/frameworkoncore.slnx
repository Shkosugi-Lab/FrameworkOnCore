  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web.RegularExpressions/WebFormsForCore.Web.RegularExpressions.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web.Services/WebFormsForCore.Web.Services.csproj" />
