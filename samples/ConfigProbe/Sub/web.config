<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A folder's settings: after the root's and its <location path="Sub">. -->
  <appSettings>
    <add key="SubOnly" value="sub" />
    <remove key="Empty" />
    <add key="Override" value="from Sub/web.config" />
  </appSettings>
  <plainValues>
    <add key="a" value="sub-a" />
  </plainValues>
  <probe>
    <shop name="Sub" maxItems="1">
      <products>
        <add sku="s1" price="9" />
      </products>
    </shop>
  </probe>
  <system.web>
    <globalization culture="de-DE" uiCulture="de-DE" />
    <httpRuntime maxRequestLength="1024" />
  </system.web>
</configuration>
