+                    // no conversion necessary
+                    return expr;
+                } else {
+                    expr = ConvertToDateTime(expr);
+                }
+            }
+
+            return UnaryConvert(clrType, typeProvider.From(clrType), expr, expr.SourceExpression);
+        }
