@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* AjaxControlToolkit TabContainer equivalent. The DOM approximates the toolkit's
   structure (ajax__tab_* classes) but is not pixel/markup identical - the original is a
   JS-composed widget. All panels stay rendered (inactive ones display:none) so @ref
   fields for controls inside inactive tabs keep working, as in WebForms. *@
@if (Visible)
{
    <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="ajax__tab_container @CssClass">
        <div class="ajax__tab_header">
            @for (var index = 0; index < _panels.Count; index++)
            {
                var panel = _panels[index];
                if (!panel.Visible)
                {
                    continue;
                }
                var targetIndex = index;
                <span class="@(index == ActiveTabIndex ? "ajax__tab_active" : "ajax__tab_inactive")">
                    <a href="javascript:void(0)" @onclick="() => SetActiveTab(targetIndex)">
                        @if (panel.HeaderTemplate is not null)
                        {
                            @panel.HeaderTemplate
                        }
                        else
                        {
                            @panel.HeaderText
                        }
                    </a>
                </span>
            }
        </div>
        <div class="ajax__tab_body">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </div>
    </div>
}

@code {
    private readonly List<TabPanel> _panels = new();
    private int _activeTabIndex;
    private bool _panelsChanged;

    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>The active tab (zero-based). Assigning from code-behind switches tabs.</summary>
    [Parameter]
    public int ActiveTabIndex
    {
        get => _activeTabIndex;
        set
        {
            if (_activeTabIndex != value)
            {
                SetAndRefresh(ref _activeTabIndex, value);
                NotifyPanels();
            }
        }
    }

    /// <summary>WebForms-style ActiveTab access (the TabPanel at ActiveTabIndex).</summary>
    public TabPanel ActiveTab
    {
        get => ActiveTabIndex >= 0 && ActiveTabIndex < _panels.Count ? _panels[ActiveTabIndex] : null;
        set
        {
            var index = _panels.IndexOf(value);
            if (index >= 0)
            {
                ActiveTabIndex = index;
            }
        }
    }

    /// <summary>Called by TabPanel on initialization; returns the panel's index.</summary>
    internal int RegisterPanel(TabPanel panel)
    {
        _panels.Add(panel);
        _panelsChanged = true;
        return _panels.Count - 1;
    }

    private void SetActiveTab(int index)
    {
        ActiveTabIndex = index;
        Host?.HostCore.NotifyPostBackEvent();
    }

    /// <summary>
    /// Panels freeze their parameters once touched (WebFormsControlBase), so a parent
    /// re-render does not reach them; visibility changes are pushed explicitly.
    /// </summary>
    private void NotifyPanels()
    {
        foreach (var panel in _panels)
        {
            panel.RefreshVisibility();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The header row can only be built after the panels have registered (first render)
        if (_panelsChanged)
        {
            _panelsChanged = false;
            StateHasChanged();
        }
    }
}
