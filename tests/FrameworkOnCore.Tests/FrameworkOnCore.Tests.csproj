<Project Sdk="Microsoft.NET.Sdk">
  <!-- The converter's analyzers (what they find: src/FrameworkOnCore.Analyzers), its rewrites (what it writes, in C# and
       Visual Basic: SourceEdits) and the compatibility assembly's helpers (what the rewritten code calls:
       experiments/wf4c/shims/FrameworkOnCore.Compat). The helpers behave by platform: run on Windows and on Linux
       (run-tests-linux.ps1). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
    <!-- Skip.If: the parity cases that need a SQL Server are reported skipped, not passed, without one. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameworkOnCore.Analyzers\FrameworkOnCore.Analyzers.csproj" />
    <!-- The rewrites (SourceEdits, SourceLanguage) and the rules they read (rules\packages.json, copied here). -->
    <ProjectReference Include="..\..\src\FrameworkOnCore.Converter\FrameworkOnCore.Converter.csproj" />
    <!-- Studio's logic that needs no browser (Runs.RestartingAnswer): StudioRunsTests.cs. -->
    <ProjectReference Include="..\..\src\FrameworkOnCore.Studio\FrameworkOnCore.Studio.csproj" />
    <ProjectReference Include="..\..\experiments\wf4c\shims\FrameworkOnCore.Compat\FrameworkOnCore.Compat.csproj" />
    <!-- The LINQ to SQL port (FrameworkOnCore's System.Data.Linq): DataLinq\*Tests.cs. -->
    <ProjectReference Include="..\..\FrameworkOnCore.Runtime\src\WebFormsForCore.Data.Linq\WebFormsForCore.Data.Linq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- golden\ is its own net48 project (record.csproj, run by record.ps1), not part of the tests. -->
    <Compile Remove="DataLinq\golden\**\*.cs" />
    <!-- Forward slashes: on Linux a backslash Link becomes part of the file's name. -->
    <None Include="DataLinq/golden/dlinq-sql.golden.json" Link="DataLinq/dlinq-sql.golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- (DataLinqParityData: on Linux the project's apphost is a file named DataLinqParity.) Every System.Data.Linq API against .NET Framework (DataLinq\DataLinqParityTests.cs): the cases (run here on the
         port), their goldens from .NET Framework, and their sources (which APIs they use: Every_API_has_a_case). -->
    <ProjectReference Include="..\DataLinqParity\DataLinqParity.csproj" />
    <None Include="../DataLinqParity/golden/*" LinkBase="DataLinqParityData" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../DataLinqParity/**/*.cs;../Parity.Core/*.cs" Exclude="../DataLinqParity/bin/**;../DataLinqParity/obj/**" LinkBase="DataLinqParityData/sources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every System.Drawing API against .NET Framework (Drawing\DrawingParityTests.cs): the cases (run here on the port,
         FrameworkOnCore's System.Drawing.Common: its Windows build on Windows, its libgdiplus one on Linux), their goldens, the
         differences known with their reasons, what .NET added to the API. -->
    <ProjectReference Include="..\DrawingParity\DrawingParity.csproj" />
    <None Include="../DrawingParity/golden/*;../DrawingParity/known-differences.json;../DrawingParity/api-additions.txt" LinkBase="DrawingParityData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Chart control's port against .NET Framework (DataVisualization\DataVisualizationParityTests.cs): the cases'
         program, built for net10.0 against FrameworkOnCore's packages and run in its own process (it needs FrameworkOnCore's System.Web
         over .NET's facade of the same name), copied under DataVisualizationParityData\program; its goldens and known
         differences. -->
    <ProjectReference Include="..\DataVisualizationParity\DataVisualizationParity.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0" SkipGetTargetFrameworkProperties="true" />
    <None Include="../DataVisualizationParity/golden/*;../DataVisualizationParity/known-differences.json" LinkBase="DataVisualizationParityData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mobile controls' port against .NET Framework (Mobile\MobileParityTests.cs): as the Chart control's, its cases'
         program copied under MobileParityData\program; its goldens and known differences. -->
    <ProjectReference Include="..\MobileParity\MobileParity.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net10.0" SkipGetTargetFrameworkProperties="true" />
    <None Include="../MobileParity/golden/*;../MobileParity/known-differences.json" LinkBase="MobileParityData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyMobileParityProgram" AfterTargets="Build">
    <ItemGroup>
      <FocMobileParity Include="$(MSBuildThisFileDirectory)../MobileParity/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FocMobileParity)" DestinationFiles="@(FocMobileParity->'$(OutDir)MobileParityData/program/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>  <Target Name="CopyDataVisualizationParityProgram" AfterTargets="Build">
    <ItemGroup>
      <FocDataVisualizationParity Include="$(MSBuildThisFileDirectory)../DataVisualizationParity/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FocDataVisualizationParity)" DestinationFiles="@(FocDataVisualizationParity->'$(OutDir)DataVisualizationParityData/program/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>