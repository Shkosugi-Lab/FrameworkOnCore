+            get { return this.isModified; }
+        }
+
+        /// <summary>
+        /// Returns true if the set has been loaded from the database.
+        /// </summary>
+        internal bool HasLoadedValues {
+            get { return this.isLoaded; }
+        }
+
+        /// <summary>
