<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/E/NotFound.aspx?from=httpErrors" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
