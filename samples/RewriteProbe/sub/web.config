<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- A folder's rules: after the root's, their URL the folder's (without "sub/"), their relative URLs in the folder;
         a rewrite map from a file of its own (configSource). -->
    <rewrite>
      <rewriteMaps configSource="sub-maps.config" />
      <rules>
        <remove name="everywhere" />
        <rule name="sub-item" stopProcessing="true">
          <match url="^item/([0-9]+)$" />
          <action type="Rewrite" url="/Show.aspx?sub={R:1}&amp;r0={R:0}" />
        </rule>
        <rule name="sub-go" stopProcessing="true">
          <match url="^go$" />
          <action type="Redirect" url="item/7" redirectType="Found" />
        </rule>
        <rule name="sub-map" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{SubMap:{R:0}}" pattern="(.+)" />
          </conditions>
          <action type="Rewrite" url="{C:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
