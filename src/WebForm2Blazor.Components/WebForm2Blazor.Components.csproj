<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nullable is disabled to match the semantics of the conversion source (.NET Framework WebForms) -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BL0007: the compatibility controls intentionally rewrite parameter properties from
         code-behind (WebForms style), so parameters cannot be auto-properties.
         BL0005: GridView assembles BoundField columns for AutoGenerateColumns etc.,
         intentionally setting parameters from outside for WebForms compatibility. -->
    <NoWarn>$(NoWarn);BL0007;BL0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- ConfigurationManager.GetSection binds an application's own ConfigurationSection
         subclass out of the App.config the converter carries over from Web.config. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.*" />
    <!-- IDataContractSurrogate (Compat/SerializationShims.cs) declares two CodeDom types in
         its signature. They are part of the original interface, so they cannot be dropped:
         a member left out of the shim is CS0539 on the application class that implements
         it. CodeDom moved out of the box on .NET and is only reachable as a package. -->
    <PackageReference Include="System.CodeDom" Version="10.0.*" />
    <!-- CodeAccessPermission, the return type of the removed DbProviderFactory.CreatePermission
         (Compat/RemotingServicesShims.cs, RemovedFrameworkMembers). Forwarded out of the box
         to this package on .NET, which converted projects already reference. -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.*" />
  </ItemGroup>

</Project>
