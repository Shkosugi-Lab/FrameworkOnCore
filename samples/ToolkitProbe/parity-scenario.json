{
  "ignorePatterns": [],
  "_crawlComment": "After the steps, the links of the pages (two deep): each one's status and redirect target as the original's (sample-parity.ps1 -Record -LinksOnly).",
  "crawl": { "exclude": [ "log ?(off|out)|sign ?out" ] },
  "steps": [
    { "action": "goto", "path": "/Default.aspx" },
    { "action": "snapshot", "name": "toolkit-first page" },

    { "action": "fill", "target": "txtName", "value": "Taro" },
    { "action": "click", "target": "btnGreet" },
    { "action": "snapshot", "name": "toolkit-greeted (asynchronous postback)" },

    { "action": "click", "target": "btnGreet" },
    { "action": "snapshot", "name": "toolkit-greeted again" },

    { "action": "click", "target": "pnlHeader" },
    { "action": "snapshot", "name": "toolkit-panel opened" }
  ]
}
