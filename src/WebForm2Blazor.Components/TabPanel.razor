@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* AjaxControlToolkit TabPanel equivalent. Inactive panels are rendered hidden so the
   controls inside keep their @ref wiring and state, matching WebForms behavior. *@
@if (Visible)
{
    <div @attributes="ExtraAttributes" id="@ClientID" class="ajax__tab_panel @CssClass"
         style="@(IsActive ? ComputedStyle : (ComputedStyle + "display:none;"))">
        @(ContentTemplate ?? ChildContent)
    </div>
}

@code {
    private int _index;

    /// <summary>The tab title shown in the container's header row.</summary>
    [Parameter] public string HeaderText { get; set; }

    /// <summary>AjaxControlToolkit HeaderTemplate equivalent (wins over HeaderText).</summary>
    [Parameter] public RenderFragment HeaderTemplate { get; set; }

    /// <summary>The panel body (the toolkit markup wraps it in &lt;ContentTemplate&gt;).</summary>
    [Parameter] public RenderFragment ContentTemplate { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    [CascadingParameter] internal TabContainer OwnerContainer { get; set; }

    private bool IsActive => OwnerContainer is null || OwnerContainer.ActiveTabIndex == _index;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _index = OwnerContainer?.RegisterPanel(this) ?? 0;
    }

    /// <summary>Called by the owning TabContainer when the active tab changes.</summary>
    internal void RefreshVisibility() => StateHasChanged();
}
