  "steps": [
    { "action": "goto", "path": "/" },
    { "action": "snapshot", "name": "home" },

    { "action": "goto", "path": "/About" },
    { "action": "snapshot", "name": "about" },

    { "action": "goto", "path": "/Contact" },
    { "action": "snapshot", "name": "contact" },

    { "action": "goto", "path": "/ProductList" },
    { "action": "snapshot", "name": "product-list" },

    { "action": "goto", "path": "/ProductDetails" },
    { "action": "snapshot", "name": "product-details" },

    { "action": "goto", "path": "/ShoppingCart" },
    { "action": "snapshot", "name": "shopping-cart" },

    { "action": "goto", "path": "/AddToCart" },
    { "action": "snapshot", "name": "add-to-cart" },

    { "action": "goto", "path": "/ErrorPage" },
    { "action": "snapshot", "name": "error-page" }
  ]
}
