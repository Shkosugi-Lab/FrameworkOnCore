+            if (method.IsGenericMethod) {
+                Type[] parameterTypes = method.GetGenericArguments();
+                foreach (Type type in parameterTypes) {
+                    if (!type.IsVisible) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
