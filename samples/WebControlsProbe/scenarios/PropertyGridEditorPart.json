{
  "_comment": "The PropertyGridEditorPart's scenario layer (WebPartsScenario.aspx; tests/WebControlsParity/README.md; written by more-scenarios.py). A snapshot's tags are the mechanisms it covers.",
  "ignorePatterns": [],
  "steps": [
    {
      "action": "goto",
      "path": "/WebPartsScenario.aspx?reset=1"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [render][databind][dynamic] first request (browse): the parts in their zones, a zone made in code"
    },
    {
      "action": "click",
      "target": "btnDesign"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] the design mode"
    },
    {
      "action": "click",
      "target": "btnCatalog"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] the catalog mode: the catalog zone and its parts"
    },
    {
      "action": "evaluate",
      "target": "czCatalog",
      "value": "e.querySelector('input[type=checkbox]').checked = true;"
    },
    {
      "action": "clicktextin",
      "target": "czCatalog",
      "value": "Add"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] a part added from the catalog (its check box posted, the zone's Add)"
    },
    {
      "action": "click",
      "target": "btnEditPart"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate][templates] the edit mode: the editor zone and its parts for the first part"
    },
    {
      "action": "evaluate",
      "target": "ezEditor",
      "value": "e.querySelector('input[type=text]').value = 'Renamed part';"
    },
    {
      "action": "clicktextin",
      "target": "ezEditor",
      "value": "OK"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] the first part's title edited (the editor zone's OK)"
    },
    {
      "action": "click",
      "target": "btnConnectPart"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] the connect mode for the first part"
    },
    {
      "action": "clicktextin",
      "target": "cnzConnections",
      "value": "Close"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] the connections zone closed"
    },
    {
      "action": "click",
      "target": "btnBrowse"
    },
    {
      "action": "clicktextin",
      "target": "wpzMain",
      "value": "Minimize"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] a part minimized by its zone's verb"
    },
    {
      "action": "clicktextin",
      "target": "wpzMain",
      "value": "Restore"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] restored"
    },
    {
      "action": "clicktextin",
      "target": "wpzDynamic",
      "value": "Minimize"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [viewstate] a part of the zone made in code minimized"
    },
    {
      "action": "click",
      "target": "btnShow"
    },
    {
      "action": "snapshot",
      "name": "PropertyGridEditorPart [visible][viewstate] a hidden zone shown"
    }
  ],
  "maskIds": [
    "wp-?[0-9]+"
  ]
}
