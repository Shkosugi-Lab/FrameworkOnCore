<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="plainValues" type="System.Configuration.NameValueSectionHandler, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <section name="dictValues" type="System.Configuration.DictionarySectionHandler, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <section name="singleTag" type="System.Configuration.SingleTagSectionHandler, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <section name="legacyHandler" type="ConfigProbe.LegacyHandler, ConfigProbe" />
    <section name="external" type="ConfigProbe.ShopSection, ConfigProbe" />
    <sectionGroup name="probe">
      <section name="shop" type="ConfigProbe.ShopSection, ConfigProbe" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ConfigProbe.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <!-- The file's values override these (file=); keys repeated, cased differently, padded, empty, multi-line. -->
  <appSettings file="AppSettings.config">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="Mode" value="root" />
    <add key="dup" value="first" />
    <add key="DUP" value="second" />
    <add key="Number" value=" 42 " />
    <add key="Flag" value="True" />
    <add key="Ratio" value="0.5" />
    <add key="Empty" value="" />
    <add key="Multi" value="line1&#xA;line2&#x9;tab" />
    <add key="Override" value="from web.config" />
    <add key="Removed" value="gone" />
    <remove key="Removed" />
  </appSettings>

  <!-- Without <clear />: machine.config's LocalSqlServer comes first on IIS. -->
  <connectionStrings configSource="ConnectionStrings.config" />

  <plainValues>
    <add key="a" value="1" />
    <add key="A" value="2" />
    <add key="b" value="3" />
    <remove key="b" />
  </plainValues>
  <dictValues>
    <add key="x" value="10" />
    <add key="y" value="20" />
    <add key="X" value="11" />
  </dictValues>
  <singleTag color="red" Size="12" empty="" />
  <legacyHandler version="2">
    <!-- a comment the handler sees -->
    <item name="one">1</item>
    <item name="two"><![CDATA[<two> & more]]></item>
  </legacyHandler>
  <external configSource="External.config" />
  <probe>
    <shop name="Main" maxItems="5" opened="2020-01-02" ratio="0.1" kind="Retail" timeout="00:01:30">
      <products>
        <add sku="p1" price="1.5" />
        <add sku="p2" price="2" />
        <add sku="p3" price="3.25" />
        <remove sku="p2" />
      </products>
    </shop>
  </probe>
  <applicationSettings>
    <ConfigProbe.Properties.Settings>
      <setting name="Greeting" serializeAs="String">
        <value>Hello from web.config</value>
      </setting>
      <setting name="Limit" serializeAs="String">
        <value>7</value>
      </setting>
    </ConfigProbe.Properties.Settings>
  </applicationSettings>

  <location path="Sub">
    <appSettings>
      <add key="Mode" value="location" />
      <add key="LocationOnly" value="yes" />
    </appSettings>
  </location>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" executionTimeout="77" requestPathInvalidCharacters="&lt;,&gt;,*,%,:,\,?" />
    <globalization culture="en-US" uiCulture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="Off" />
    <sessionState mode="InProc" timeout="33" cookieName="ProbeSession" />
    <pages clientIDMode="Predictable" validateRequest="true" maintainScrollPositionOnPostBack="true" />
  </system.web>
</configuration>
