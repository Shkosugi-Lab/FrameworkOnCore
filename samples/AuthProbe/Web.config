<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Made afresh before each run (database.json, experiments/wf4c/sample-parity.ps1), with aspnet_regsql's schema. -->
    <add name="ProbeDb" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=FocAuthProbe;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- The Login control's validators without jQuery (4.5's unobtrusive validation needs a script mapping for it). -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
    <!-- Keys of its own (not generated per machine): the forms ticket and the view state the same on every run. -->
    <machineKey validationKey="3CFD9CC5860FFB8DB5DBC512D42F4CCC03CE5BDCB676040D39CA00E04DCE048AF98FCD9C5BEB0C30BB4EFDBFA127249B9D1C3B79A84508046E7FF51B6B9FCED9"
                decryptionKey="532D1B679D8254BAE1130BAA6DE4CC91E1BA4C451294CA0FA1D04B1C759D4E14" validation="HMACSHA256" decryption="AES" />
    <authentication mode="Forms">
      <forms name=".PROBEAUTH" loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <membership defaultProvider="ProbeMembership">
      <providers>
        <clear />
        <add name="ProbeMembership" type="System.Web.Security.SqlMembershipProvider" connectionStringName="ProbeDb" applicationName="/AuthProbe"
             enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="true"
             maxInvalidPasswordAttempts="3" passwordAttemptWindow="10" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0"
             passwordFormat="Hashed" />
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="ProbeRoles">
      <providers>
        <clear />
        <add name="ProbeRoles" type="System.Web.Security.SqlRoleProvider" connectionStringName="ProbeDb" applicationName="/AuthProbe" />
      </providers>
    </roleManager>
    <profile enabled="true" defaultProvider="ProbeProfile">
      <providers>
        <clear />
        <add name="ProbeProfile" type="System.Web.Profile.SqlProfileProvider" connectionStringName="ProbeDb" applicationName="/AuthProbe" />
      </providers>
      <properties>
        <add name="Nickname" type="System.String" defaultValue="(none)" />
        <add name="Visits" type="System.Int32" defaultValue="0" />
        <group name="Prefs">
          <add name="Color" type="System.String" defaultValue="blue" />
        </group>
      </properties>
    </profile>
  </system.web>
  <!-- Signed-in users only; the Admin role only. -->
  <location path="Members">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
