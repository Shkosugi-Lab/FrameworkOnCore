@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase
@implements IValueControl
@implements IListItemContainer

@* Collects the declarative <ListItem> children. The ListItem itself renders nothing. *@
<CascadingValue Value="(IListItemContainer)this" IsFixed="true">@ChildContent</CascadingValue>

@if (Visible)
{
    @* Renders as a table, matching the WebForms default (RepeatLayout=Table) *@
    <table @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">
        <tbody>
            @* RepeatColumns grid: Vertical (default) fills column-major, Horizontal row-major.
               RepeatColumns=0 keeps the classic single-row / single-column layouts. *@
            @for (var rowIndex = 0; rowIndex < RowCount; rowIndex++)
            {
                <tr>
                    @for (var columnIndex = 0; columnIndex < ColumnCount; columnIndex++)
                    {
                        var index = IsHorizontal
                            ? rowIndex * ColumnCount + columnIndex
                            : columnIndex * RowCount + rowIndex;
                        @* Trailing cells pad with an empty td (measured on 4.8) *@
                        <td>
                            @if (index < Items.Count)
                            {
                                @RenderItem(Items[index], index)
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _itemsChanged;

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string DataTextField { get; set; }
    [Parameter] public string DataValueField { get; set; }

    /// <summary>Vertical (default) / Horizontal.</summary>
    [Parameter] public string RepeatDirection { get; set; } = "Vertical";

    /// <summary>
    /// WebForms RepeatLayout equivalent. Only Table (the WebForms default) is rendered,
    /// so the value is accepted and does not change the markup; Flow / UnorderedList
    /// would emit a different DOM and are a deliberate follow-up rather than a silent
    /// approximation.
    /// </summary>
    [Parameter] public string RepeatLayout { get; set; } = "Table";

    [Parameter] public EventHandler OnSelectedIndexChanged { get; set; }

    /// <summary>
    /// WebForms SelectedIndexChanged as a CLR event: code-behind wires handlers imperatively
    /// (control.SelectedIndexChanged += Handler), which a markup-only parameter cannot express.
    /// The accessors chain onto the parameter so the existing raise site fires both.
    /// </summary>
    public event EventHandler SelectedIndexChanged
    {
        add => OnSelectedIndexChanged += value;
        remove => OnSelectedIndexChanged -= value;
    }

    /// <summary>WebForms ValidationGroup equivalent; accepted as a no-op (see TextBox.ValidationGroup).</summary>
    [Parameter] public string ValidationGroup { get; set; }

    public ListItemCollection Items { get; } = new();

    public object DataSource { get; set; }

    /// <summary>0 (the WebForms default) keeps a single row (Horizontal) or column (Vertical).</summary>
    [Parameter] public int RepeatColumns { get; set; }

    private bool IsHorizontal
        => string.Equals(RepeatDirection, "Horizontal", StringComparison.OrdinalIgnoreCase);

    private int ColumnCount
        => RepeatColumns > 0 ? RepeatColumns : (IsHorizontal ? Math.Max(1, Items.Count) : 1);

    private int RowCount => (Items.Count + ColumnCount - 1) / ColumnCount;

    /// <summary>The first selected item, as in WebForms.</summary>
    public ListItem SelectedItem => Items.FirstOrDefault(item => item.Selected);

    public string SelectedValue => SelectedItem?.ResolvedValue ?? string.Empty;

    public int SelectedIndex => Items.FindIndex(item => item.Selected);

    private RenderFragment RenderItem(ListItem item, int index) => __builder =>
    {
        @* ClientID, not ID: the per-item ids carry the naming-container prefix too
           (measured: "MainContent_rblStatus_0") *@
        var inputId = $"{ClientID}_{index}";
        <input type="checkbox" id="@inputId" disabled="@(!Enabled)"
               checked="@item.Selected" @onchange="e => HandleToggle(item, e)" />
        <label for="@inputId">@item.ResolvedText</label>
    };

    void IListItemContainer.AddItem(ListItem item)
    {
        Items.Add(item);
        _itemsChanged = true;
    }

    /// <summary>When true, DataBind keeps declarative ListItems and appends (WebForms compatible).</summary>
    [Parameter] public bool AppendDataBoundItems { get; set; }

    /// <summary>WebForms DataBind() equivalent.</summary>
    public void DataBind()
    {
        if (!AppendDataBoundItems)
        {
            Items.Clear();
        }
        foreach (var row in DataSourceHelper.Materialize(DataSource))
        {
            var text = string.IsNullOrEmpty(DataTextField)
                ? row?.ToString()
                : DataBinder.Eval(row, DataTextField)?.ToString();
            var value = string.IsNullOrEmpty(DataValueField)
                ? text
                : DataBinder.Eval(row, DataValueField)?.ToString();
            Items.Add(new ListItem(text, value));
        }
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_itemsChanged)
        {
            _itemsChanged = false;
            StateHasChanged();
        }
    }

    private void HandleToggle(ListItem item, ChangeEventArgs e)
    {
        // Code-behind reads the result via Items[i].Selected, as in WebForms
        item.Selected = e.Value is bool boolValue && boolValue;
        MarkStateTouched();
        OnSelectedIndexChanged?.Invoke(this, EventArgs.Empty);
        Host?.HostCore.NotifyPostBackEvent();
    }

    public string GetControlValue() => SelectedValue;
}
