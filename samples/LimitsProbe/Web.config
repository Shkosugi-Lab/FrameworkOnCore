<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- debug false: executionTimeout counts only then. -->
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="100" executionTimeout="3" />
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
  </system.web>
  <!-- A folder that takes more (100 MB): what is over IIS's own limit (request filtering's 30,000,000 bytes) there. -->
  <location path="Big">
    <system.web>
      <httpRuntime maxRequestLength="102400" />
    </system.web>
  </location>
</configuration>
