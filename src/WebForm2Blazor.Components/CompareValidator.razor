@namespace WebForm2Blazor.Components
@* A BaseCompareValidator, as in System.Web. *@
@inherits BaseCompareValidator

@if (ShowError)
{
    <span @attributes="ExtraAttributes" style="@SpanStyle" id="@ClientID" class="@ResolvedCssClass">@DisplayText</span>
}

@code {
    /// <summary>ID of the control to compare against (takes precedence over ValueToCompare).</summary>
    [Parameter] public string ControlToCompare { get; set; }

    [Parameter] public string ValueToCompare { get; set; }

    /// <summary>Equal / NotEqual / GreaterThan / GreaterThanEqual / LessThan / LessThanEqual / DataTypeCheck.</summary>
    [Parameter] public string Operator { get; set; } = "Equal";

    protected override bool EvaluateIsValid(string value, WebFormsHostCore host)
    {
        if (string.IsNullOrEmpty(value.Trim()))
        {
            return true;
        }

        if (!TryConvert(value, Type, out var converted))
        {
            return false;
        }

        if (string.Equals(Operator, "DataTypeCheck", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var compareTo = !string.IsNullOrEmpty(ControlToCompare)
            ? (host.FindControl(ControlToCompare) as IValueControl)?.GetControlValue() ?? string.Empty
            : ValueToCompare ?? string.Empty;

        if (!TryConvert(compareTo, Type, out var comparand))
        {
            return false;
        }

        var comparison = converted.CompareTo(comparand);
        return (Operator ?? "Equal").Trim().ToLowerInvariant() switch
        {
            "notequal" => comparison != 0,
            "greaterthan" => comparison > 0,
            "greaterthanequal" => comparison >= 0,
            "lessthan" => comparison < 0,
            "lessthanequal" => comparison <= 0,
            _ => comparison == 0,
        };
    }
}
