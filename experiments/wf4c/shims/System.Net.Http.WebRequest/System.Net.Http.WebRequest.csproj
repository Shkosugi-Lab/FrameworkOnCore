<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework's System.Net.Http.WebRequest.dll, which .NET does not ship. .NET Framework
       packages reference it (Katana's Microsoft.Owin.Security.* create a WebRequestHandler as
       their back channel), so it has to exist under its own name and at least its version. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Net.Http.WebRequest</AssemblyName>
    <RootNamespace>System.Net.Http</RootNamespace>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
  <!-- The identity .NET Framework's System.Net.Http.WebRequest has (its public key: ..\keys, extract-keys.ps1), which assemblies built against it reference. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\keys\b03f5f7f11d50a3a.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
