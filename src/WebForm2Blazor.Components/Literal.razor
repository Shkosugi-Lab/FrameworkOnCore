@namespace WebForm2Blazor.Components
@inherits Control
@* WebForms Literal IS an ITextControl, and ported code passes one where that interface
   is asked for - YAF hands its literals to a helper typed against ITextControl. *@
@implements ITextControl

@if (Visible)
{
    @* WebForms Literal emits Text as raw HTML without any wrapping tag *@
    @((MarkupString)(Text ?? string.Empty))
}

@code {
    /// <summary>
    /// A Literal CAN be written to a text writer, unlike a compat component in general:
    /// its entire rendering is its Text, so there is nothing about it that only the Blazor
    /// renderer knows.
    ///
    /// That matters where a ported legacy control builds its content in code and renders
    /// it to a writer. BlogEngine's WidgetZone adds one Literal per widget and then writes
    /// itself out; without this, every widget zone rendered as an empty div.
    /// </summary>
    public override void RenderControl(HtmlTextWriter writer)
    {
        if (Visible)
        {
            writer?.Write(Text ?? string.Empty);
        }
    }

    private string _text = string.Empty;

    [Parameter]
    public string Text
    {
        get => _text;
        set => SetAndRefresh(ref _text, value ?? string.Empty);
    }
}
