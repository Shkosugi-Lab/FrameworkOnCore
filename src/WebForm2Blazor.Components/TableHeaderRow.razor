@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* System.Web.UI.WebControls.TableHeaderRow. Renders <tr> exactly as TableRow does - in
   WebForms the difference is the row's TableSection (it lands in <thead> when the table
   renders sections) and that its cells default to TableHeaderCell, which is what emits
   <th>. The cells are their own components here, so this row's own markup is a <tr>. *@

@if (Visible)
{
    <tr @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">@ChildContent</tr>
}

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// WebForms TableHeaderRow.TableSection equivalent. Recorded, not acted on: the
    /// converted markup keeps the rows in the order the source had them, so moving a row
    /// into a different section would change the DOM rather than preserve it.
    /// </summary>
    [Parameter] public string TableSection { get; set; } = "TableHeader";
}
