@namespace WebForm2Blazor.Components
@inherits WebControl

@if (Visible)
{
    <a @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
       href="@UrlMapper.ResolveUrl(NavigateUrl)" target="@Target">
        @if (!string.IsNullOrEmpty(ImageUrl))
        {
            @* WebForms HyperLink with ImageUrl renders an img (alt = Text) instead of the text *@
            <img src="@UrlMapper.ResolveUrl(ImageUrl)"
                 alt="@(string.IsNullOrEmpty(Text) ? null : Text)" title="@ToolTip" />
        }
        else if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    </a>
}

@code {
    private string _navigateUrl;
    private string _text;

    /// <summary>
    /// WebForms-style URLs such as "~/Edit.aspx" keep working as written.
    /// Assignable from code-behind (the ItemDataBound pattern) with self re-render.
    /// </summary>
    [Parameter]
    public string NavigateUrl
    {
        get => _navigateUrl;
        set => SetAndRefresh(ref _navigateUrl, value);
    }

    [Parameter]
    public string Text
    {
        get => _text;
        set => SetAndRefresh(ref _text, value);
    }

    [Parameter] public string Target { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private string _imageUrl;

    /// <summary>WebForms HyperLink.ImageUrl equivalent (renders an image link).</summary>
    [Parameter]
    public string ImageUrl
    {
        get => _imageUrl;
        set => SetAndRefresh(ref _imageUrl, value);
    }
}
