<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net10.0 only: the charts draw with the System.Drawing.Common port, which is built for net10.0. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>11</LangVersion>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <!-- SQLRS_CONTROL: the shipped assembly's. Its two blocks (#if !SQLRS_CONTROL) name a field the sources do not
             have (emptyPointAttributes), and .NET Framework's Series leaves the empty point colors unset, as without
             them. The other symbols the sources test (SUBAXES, WEB_OLAP, VS_BUILD, ASPPERM_35...) are features and
             build variants the shipped assembly does not have (no SubAxis types, no CAS). -->
        <DefineConstants>$(DefineConstants);SQLRS_CONTROL;WebFormsForCore</DefineConstants>
        <SignAssembly>True</SignAssembly>
        <AssemblyName>System.Web.DataVisualization</AssemblyName>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <!-- The sources as they are, where .NET warns of what works:
             CS8073: a struct compared with null (always false, as it was).
             SYSLIB0014: WebRequest, for an image or data given by URL (it works; HttpClient would be a rewrite).
             SYSLIB0021: SHA256CryptoServiceProvider (it works, as SHA256.Create would).
             SYSLIB0003: Code Access Security attributes (.NET ignores them).
             CS0618: System.Data.SqlClient, obsolete in favor of Microsoft.Data.SqlClient: the package the converter
             gives converted applications, whose SqlCommand the chart binds to.
             CA1416: OleDb data sources, Windows only on .NET (the System.Data.OleDb package's). -->
        <NoWarn>$(NoWarn);CS8073;SYSLIB0014;SYSLIB0021;SYSLIB0003;CS0618;CA1416</NoWarn>

        <PackageId>FrameworkOnCore.Web.DataVisualization</PackageId>
        <Title>FrameworkOnCore.Web.DataVisualization</Title>
        <Authors>simonegli8</Authors>
        <Company>Estrellas de Esperanza</Company>
        <Product>WebFormsForCore.Web.DataVisualization</Product>
        <Description>A port of ASP.NET's Chart control (System.Web.DataVisualization) to .NET 10</Description>
        <Copyright>Estrellas de Esperanza</Copyright>
        <PackageProjectUrl>https://github.com/webformsforcore/WebFormsForCore</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/webformsforcore/WebFormsForCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>WebForms;Chart;System.Web.DataVisualization;NET Core;NET 10</PackageTags>
        <AssemblyVersion>10.0.29.0</AssemblyVersion>
        <FileVersion>10.0.29.0</FileVersion>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
        <!-- As System.Web: .NET's ConfigurationManager under an alias, the fork's System.Configuration in the global
             namespace (SettingsPropertyWrongTypeException is in both). -->
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" Aliases="NET" />
        <ProjectReference Include="..\WebFormsForCore.Drawing.Common\WebFormsForCore.Drawing.Common.csproj" />
        <!-- The System.Drawing facade (System.Web references it) has its own ToolboxBitmapAttribute and FontConverter:
             under an alias, System.Drawing.Common's are the ones the sources name. -->
        <ProjectReference Include="..\WebFormsForCore.Drawing\WebFormsForCore.Drawing.csproj" Aliases="DrawingFacade" />
        <!-- The chart binds to SqlCommand / SqlDataReader data sources: the package the converter gives converted
             applications for their own System.Data.SqlClient use. -->
        <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- .NET Framework's texts, which referencesource does not have (generate-dataviz-resources.ps1 of the
             FrameworkOnCore repository), under the name SR.Keys' ResourceManager looks for. -->
        <EmbeddedResource Update="Core\SR.resx" LogicalName="System.Web.UI.DataVisualization.Charting.SR.resources" />
    </ItemGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />

    <!-- Without DEBUG in every configuration, as .NET Framework's assembly was built: on .NET a failed Debug.Assert ends
         the process. -->
    <Target Name="FocWithoutDebugConstant" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace(';$(DefineConstants);', ';DEBUG;', ';').Trim(';'))</DefineConstants>
        </PropertyGroup>
    </Target>

    <PropertyGroup>
        <!-- The key of ASP.NET's shared libraries (31bf3856ad364e35), System.Web.DataVisualization's original identity. -->
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>31bf3856ad364e35</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
