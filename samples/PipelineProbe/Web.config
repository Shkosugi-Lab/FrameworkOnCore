<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" />
    <!-- On for every request (local ones too): the errors go to the error pages, a 404 to its own. -->
    <customErrors mode="On" defaultRedirect="~/Errors/Oops.aspx">
      <error statusCode="404" redirect="~/Errors/NotFound.aspx" />
    </customErrors>
  </system.web>
  <system.webServer>
    <modules>
      <add name="ProbeModule" type="PipelineProbe.ProbeModule" />
    </modules>
    <handlers>
      <add name="ProbeHandler" path="*.probe" verb="*" type="PipelineProbe.ProbeHandler" preCondition="integratedMode" />
      <add name="AsyncProbeHandler" path="*.aprobe" verb="*" type="PipelineProbe.AsyncProbeHandler" preCondition="integratedMode" />
    </handlers>
  </system.webServer>
</configuration>
