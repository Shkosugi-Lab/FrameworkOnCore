<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <!-- IIS's URL Rewrite module (2.1): the rules applications commonly have. -->
    <rewrite>
      <rewriteMaps>
        <rewriteMap name="StaticRewrites">
          <add key="/promo" value="/Show.aspx?map=promo" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <!-- a value taken from the URL, rewritten to a page (the query string appended) -->
        <rule name="product" stopProcessing="true">
          <match url="^products/([0-9]+)$" />
          <action type="Rewrite" url="Show.aspx?id={R:1}" />
        </rule>
        <!-- redirects: permanent, found -->
        <rule name="old" stopProcessing="true">
          <match url="^old/(.*)$" />
          <action type="Redirect" url="products/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="temp" stopProcessing="true">
          <match url="^temp$" />
          <action type="Redirect" url="Show.aspx?from=temp" redirectType="Found" />
        </rule>
        <!-- a case-sensitive match, the lower case of a back-reference -->
        <rule name="lower" stopProcessing="true">
          <match url="^LOWER/(.*)$" ignoreCase="false" />
          <action type="Redirect" url="lower/{ToLower:{R:1}}" redirectType="Permanent" />
        </rule>
        <!-- a single-page application's fallback: not a file, not a folder -->
        <rule name="spa" stopProcessing="true">
          <match url="^app/(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?spa={R:1}" />
        </rule>
        <!-- conditions on the host and the query string, a condition's back-reference, the query string not appended -->
        <rule name="host" stopProcessing="true">
          <match url="^host-check$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?host=yes" />
        </rule>
        <rule name="query" stopProcessing="true">
          <match url="^q$" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="^a=(\d+)" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?a2={C:1}" appendQueryString="false" />
        </rule>
        <!-- a rewrite map -->
        <rule name="map" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{StaticRewrites:{REQUEST_URI}}" pattern="(.+)" />
          </conditions>
          <action type="Rewrite" url="{C:1}" appendQueryString="false" />
        </rule>
        <!-- rules in a chain: the second sees the first's URL -->
        <rule name="chain1">
          <match url="^chain$" />
          <action type="Rewrite" url="chain2" />
        </rule>
        <rule name="chain2" stopProcessing="true">
          <match url="^chain2$" />
          <action type="Rewrite" url="Show.aspx?chain=2" />
        </rule>
        <!-- the scheme -->
        <rule name="scheme" stopProcessing="true">
          <match url="^scheme$" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?https=off" />
        </rule>
        <!-- the other pattern syntaxes -->
        <rule name="wildcard" patternSyntax="Wildcard" stopProcessing="true">
          <match url="files/*/*" />
          <action type="Rewrite" url="Show.aspx?w1={R:1}&amp;w2={R:2}" appendQueryString="false" />
        </rule>
        <rule name="exact" patternSyntax="ExactMatch" stopProcessing="true">
          <match url="exact" />
          <action type="Rewrite" url="Show.aspx?exact=1" />
        </rule>
        <!-- any of the conditions; the captures of all of them -->
        <rule name="any" stopProcessing="true">
          <match url="^any$" />
          <conditions logicalGrouping="MatchAny">
            <add input="{QUERY_STRING}" pattern="^x=(\d+)" />
            <add input="{HTTP_USER_AGENT}" pattern="^(curl)" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?any={C:1}" appendQueryString="false" />
        </rule>
        <rule name="track" stopProcessing="true">
          <match url="^track$" />
          <conditions trackAllCaptures="true">
            <add input="{HTTP_HOST}" pattern="^(localhost)" />
            <add input="{QUERY_STRING}" pattern="^n=(\d+)" />
          </conditions>
          <action type="Rewrite" url="Show.aspx?t={C:1}-{C:2}" appendQueryString="false" />
        </rule>
        <!-- server variables ASP.NET Core's rewriter does not have, the functions -->
        <rule name="vars" stopProcessing="true">
          <match url="^vars$" />
          <action type="Rewrite" url="Show.aspx?url={URL}&amp;port={SERVER_PORT}&amp;proto={HTTP_X_FORWARDED_PROTO}&amp;uri={UrlEncode:{REQUEST_URI}}&amp;method={REQUEST_METHOD}" appendQueryString="false" />
        </rule>
        <!-- the rewritten URL in the log -->
        <rule name="logged" stopProcessing="true">
          <match url="^logged$" />
          <action type="Rewrite" url="Show.aspx?logged=1" logRewrittenUrl="true" />
        </rule>
        <!-- the other redirects, a status IIS has no page for -->
        <rule name="see" stopProcessing="true">
          <match url="^see$" />
          <action type="Redirect" url="/Show.aspx?see=1" redirectType="SeeOther" />
        </rule>
        <rule name="tmp" stopProcessing="true">
          <match url="^tmp307$" />
          <action type="Redirect" url="Show.aspx?tmp=1" redirectType="Temporary" appendQueryString="false" />
        </rule>
        <rule name="gone" stopProcessing="true">
          <match url="^gone$" />
          <action type="CustomResponse" statusCode="410" subStatusCode="0" statusReason="Gone" statusDescription="It is gone" />
        </rule>
        <!-- server variables set by a rule (allowed by the server: allowedServerVariables), one the server does not allow -->
        <rule name="setvars" stopProcessing="true">
          <match url="^setvars$" />
          <serverVariables>
            <set name="PROBE_VAR" value="v-{QUERY_STRING}" />
            <set name="HTTP_X_PROBE" value="probe" />
            <set name="RESPONSE_X_Probe" value="answered" />
          </serverVariables>
          <action type="Rewrite" url="Show.aspx" />
        </rule>
        <rule name="denied" stopProcessing="true">
          <match url="^denied$" />
          <serverVariables>
            <set name="NOT_ALLOWED_VAR" value="x" />
          </serverVariables>
          <action type="Rewrite" url="Show.aspx" />
        </rule>
        <!-- a rule a folder's web.config removes -->
        <rule name="everywhere" stopProcessing="true">
          <match url="^(.*)/here$" />
          <action type="Rewrite" url="Show.aspx?here={R:1}" />
        </rule>
        <!-- an answer of the rule's own, a request aborted -->
        <rule name="blocked" stopProcessing="true">
          <match url="^blocked$" />
          <action type="CustomResponse" statusCode="403" subStatusCode="0" statusReason="Forbidden" statusDescription="Blocked by a rule" />
        </rule>
        <rule name="abort" stopProcessing="true">
          <match url="^abort$" />
          <action type="AbortRequest" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
