diff --git a/src/WebFormsForCore.Drawing.Common/System/Drawing/BufferedGraphicsManager.Windows.cs b/src/WebFormsForCore.Drawing.Common/System/Drawing/BufferedGraphicsManager.Windows.cs
new file mode 100644
