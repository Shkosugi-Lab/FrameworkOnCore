<Project Sdk="Microsoft.NET.Sdk">
  <!-- QuickIO.NET (SchwabenCode.QuickIO) on .NET: the package calls Win32's file API with \\?\ paths (long paths on
       .NET Framework) and cannot read a Linux path (DNN's FileSystemUtils: "Unable to parse path"). Its API, as the
       applications use it, over System.IO, which has long paths itself. The converter removes the package
       (rules/packages.json shimPackages). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SchwabenCode.QuickIO</AssemblyName>
    <RootNamespace>SchwabenCode.QuickIO</RootNamespace>
    <Version>2.6.2.0</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
