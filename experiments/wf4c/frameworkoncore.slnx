  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web/WebFormsForCore.Web.csproj" />
