  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web/WebFormsForCore.Web.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web.ApplicationServices/WebFormsForCore.Web.ApplicationServices.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web.RegularExpressions/WebFormsForCore.Web.RegularExpressions.csproj" />
  <Project Path="../../FrameworkOnCore.Runtime/src/WebFormsForCore.Web.Services/WebFormsForCore.Web.Services.csproj" />
