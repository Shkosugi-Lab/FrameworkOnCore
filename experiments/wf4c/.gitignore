# Every top-level subfolder is generated by run-sample.ps1 / convert-project.ps1 or is the
# upstream clone / local feed - except the fork's patches and the compatibility shims.
/*/
# The original build's log (FrameworkOnCore --build-original: <out>.original.build.log).
/*.original.build.log
!/patches/
!/shims/
shims/*/bin/
shims/*/obj/
!/icu/
icu/*/bin/
icu/*/obj/
!/casefs/
casefs/out/
casefs/test/*/bin/
casefs/test/*/obj/
