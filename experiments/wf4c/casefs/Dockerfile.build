# The build image of libfoccase.so: an old glibc (Ubuntu 20.04, 2.31), so that the library loads on the distributions
# .NET 10 runs on (it needs no newer symbol than the ones it names), for x64 and, cross-compiled, arm64.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev binutils \
    gcc-aarch64-linux-gnu libc6-dev-arm64-cross binutils-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/*
