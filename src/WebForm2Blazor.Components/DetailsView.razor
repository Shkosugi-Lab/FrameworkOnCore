@namespace WebForm2Blazor.Components
@inherits WebControl
@implements IColumnContainer

@* Collects the <BoundField> declared inside <Fields>. The fields render nothing themselves. *@
<CascadingValue Value="(IColumnContainer)this" IsFixed="true">@Fields</CascadingValue>

@if (Visible && _dataItem is not null)
{
    @* One row per field: header cell + value cell (measured against the 4.8 runtime
       via the DefaultsProbe conformance suite, like the GridView shell) *@
    <table @attributes="ExtraAttributes" style="@TableStyle" id="@ClientID" class="@CssClass"
           cellspacing="@CellSpacing"
           cellpadding="@(CellPadding >= 0 ? CellPadding : (int?)null)"
           border="@(IsGridLinesNone ? 0 : 1)" rules="@RulesValue">
        <tbody>
            @foreach (var field in _fields)
            {
                <tr>
                    <td>@field.HeaderText</td>
                    <td>
                        @if (field is BoundField boundField)
                        {
                            @boundField.GetCellText(_dataItem)
                        }
                        else if (field is TemplateField { ItemTemplate: not null } templateField)
                        {
                            @(DataItemScope.Render(_dataItem, templateField.ItemTemplate(new RepeaterItem(_dataItem, 0))))
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<DataControlField> _fields = new();
    private object _dataItem;
    private bool _fieldsChanged;

    [Parameter] public RenderFragment Fields { get; set; }
    [Parameter] public bool AutoGenerateRows { get; set; } = true;
    [Parameter] public string GridLines { get; set; } = "Both";
    [Parameter] public int CellPadding { get; set; } = -1;
    [Parameter] public int CellSpacing { get; set; }

    /// <summary>WebForms 4.5 model binding: the item type (informational here).</summary>
    [Parameter] public string ItemType { get; set; }

    /// <summary>WebForms 4.5 model binding: parameterless page method invoked for the data.</summary>
    [Parameter] public string SelectMethod { get; set; }

    /// <summary>WebForms DataSource equivalent. Displays the first row.</summary>
    public object DataSource { get; set; }

    /// <summary>
    /// WebForms DetailsView.CommandRowStyle.BorderStyle (markup attribute form
    /// CommandRowStyle-BorderStyle). Carried, not rendered: this compat control has no
    /// edit/insert/delete command row at all (see AutoGenerateRows above), so there is
    /// nothing for the style to apply to.
    /// </summary>
    [Parameter] public string CommandRowStyleBorderStyle { get; set; }

    public object DataItem => _dataItem;

    private bool IsGridLinesNone
        => string.Equals(GridLines, "None", StringComparison.OrdinalIgnoreCase);

    private string RulesValue => (GridLines ?? "Both").Trim().ToLowerInvariant() switch
    {
        "horizontal" => "rows",
        "vertical" => "cols",
        "none" => null,
        _ => "all",
    };

    private string TableStyle
    {
        get
        {
            var style = ComputedStyle ?? string.Empty;
            if (CellSpacing == 0)
            {
                style += "border-collapse:collapse;";
            }
            return style.Length == 0 ? null : style;
        }
    }

    void IColumnContainer.AddColumn(DataControlField column)
    {
        _fields.Add(column);
        _fieldsChanged = true;
    }

    /// <summary>WebForms DataBind() equivalent.</summary>
    public override void DataBind()
    {
        _dataItem = DataSourceHelper.Materialize(DataSource).FirstOrDefault();

        if (AutoGenerateRows && _fields.Count == 0 && _dataItem is not null)
        {
            if (_dataItem is System.Data.DataRowView rowView)
            {
                foreach (System.Data.DataColumn column in rowView.Row.Table.Columns)
                {
                    _fields.Add(new BoundField { DataField = column.ColumnName, HeaderText = column.ColumnName });
                }
            }
            else
            {
                foreach (var property in _dataItem.GetType().GetProperties())
                {
                    _fields.Add(new BoundField { DataField = property.Name, HeaderText = property.Name });
                }
            }
        }
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && DataSource is null && !string.IsNullOrEmpty(SelectMethod))
        {
            DataSource = ModelBinding.InvokeSelectMethod(Host, SelectMethod);
            DataBind();
        }

        if (_fieldsChanged)
        {
            _fieldsChanged = false;
            StateHasChanged();
        }
    }
}
