<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <!-- IIS's error pages as a remote client gets them (errorMode Custom: the same from this machine) -->
    <httpErrors errorMode="Custom" />
  </system.webServer>
  <!-- the application's own pages: a page run (ExecuteURL), a file, a redirect -->
  <location path="custom">
    <system.webServer>
      <httpErrors errorMode="Custom">
        <remove statusCode="404" subStatusCode="-1" />
        <error statusCode="404" path="/errors/404.aspx" responseMode="ExecuteURL" />
        <remove statusCode="500" subStatusCode="-1" />
        <error statusCode="500" path="errors\500.htm" responseMode="File" />
        <remove statusCode="403" subStatusCode="-1" />
        <error statusCode="403" path="http://example.com/forbidden" responseMode="Redirect" />
      </httpErrors>
    </system.webServer>
  </location>
  <!-- what is done to the application's own error answers -->
  <location path="pass">
    <system.webServer>
      <httpErrors errorMode="Custom" existingResponse="PassThrough" />
    </system.webServer>
  </location>
  <location path="replace">
    <system.webServer>
      <httpErrors errorMode="Custom" existingResponse="Replace" />
    </system.webServer>
  </location>
  <!-- IIS's default: detailed errors for a local client -->
  <location path="detailed">
    <system.webServer>
      <httpErrors errorMode="DetailedLocalOnly" />
    </system.webServer>
  </location>
</configuration>
