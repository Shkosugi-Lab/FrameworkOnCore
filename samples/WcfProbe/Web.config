<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Where the page calls the site's services: empty, the address the request came to. -->
    <add key="ServiceBase" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- The same numbers and messages wherever it runs (the server's culture otherwise). -->
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
  </system.web>
  <system.serviceModel>
    <services>
      <!-- SOAP: an endpoint of web.config, its binding's configuration named. -->
      <service name="WcfProbe.Calculator">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="large" contract="WcfProbe.ICalculator" />
      </service>
      <!-- REST: webHttpBinding with the webHttp behavior. -->
      <service name="WcfProbe.Catalog">
        <endpoint address="" binding="webHttpBinding" behaviorConfiguration="web" contract="WcfProbe.ICatalog" />
      </service>
      <!-- WcfProbe.Greeter has none: WCF 4's default endpoint (basicHttpBinding), at its activation's address. -->
    </services>
    <bindings>
      <basicHttpBinding>
        <binding name="large" maxReceivedMessageSize="1048576">
          <readerQuotas maxStringContentLength="1048576" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <!-- Every service's (WCF 4's default behavior: no name). -->
        <behavior>
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
      <endpointBehaviors>
        <behavior name="web">
          <webHttp />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true">
      <serviceActivations>
        <!-- A service without a .svc file. -->
        <add relativeAddress="Greeter.svc" service="WcfProbe.Greeter" />
      </serviceActivations>
    </serviceHostingEnvironment>
  </system.serviceModel>
</configuration>
