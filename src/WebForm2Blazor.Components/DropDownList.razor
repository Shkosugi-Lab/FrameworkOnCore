@namespace WebForm2Blazor.Components
@* A ListControl, as in System.Web: code that builds one and returns it as a ListControl
   (n2cms's editors) gets this component, and it renders and posts back as one. *@
@inherits ListControl
@implements IValueControl
@implements IListItemContainer

@* Collects the declarative <ListItem> children. The ListItem itself renders nothing. *@
<CascadingValue Value="(IListItemContainer)this" IsFixed="true">@ChildContent</CascadingValue>

@if (Visible)
{
    <select @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
            value="@SelectedValue" disabled="@(!Enabled)" @onchange="HandleChange">
        @foreach (var item in Items)
        {
            <option value="@item.ResolvedValue">@item.ResolvedText</option>
        }
    </select>
}

@code {
    private string _selectedValue;
    private bool _itemsChanged;

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string DataTextField { get; set; }
    [Parameter] public string DataValueField { get; set; }
    [Parameter] public EventHandler OnSelectedIndexChanged { get; set; }

    /// <summary>
    /// WebForms SelectedIndexChanged as a CLR event: code-behind wires handlers imperatively
    /// (control.SelectedIndexChanged += Handler), which a markup-only parameter cannot express.
    /// The accessors chain onto the parameter so the existing raise site fires both.
    /// </summary>
    public event EventHandler SelectedIndexChanged
    {
        add => OnSelectedIndexChanged += value;
        remove => OnSelectedIndexChanged -= value;
    }

    /// <summary>WebForms Items equivalent (Items.Add / FindByValue are available).</summary>
    public override ListItemCollection Items { get; } = new();

    /// <summary>
    /// WebForms DataSource equivalent. Applied by DataBind() - explicitly from code-behind,
    /// or automatically (see OnParametersSet below) when the markup declares it
    /// declaratively (DataSource="&lt;%# Expr %&gt;"), the same idiom DataSourceID already
    /// established on Repeater/ListView: that markup has no code-behind DataBind() call to
    /// rely on.
    /// </summary>
    [Parameter] public object DataSource { get; set; }

    private bool _dataSourceBoundFromMarkup;

    [Parameter]
    public override string SelectedValue
    {
        get => _selectedValue ?? Items.FirstOrDefault()?.ResolvedValue ?? string.Empty;
        set => SetAndRefresh(ref _selectedValue, value);
    }

    /// <summary>WebForms 4.5 model binding: the item type (informational here).</summary>
    [Parameter] public string ItemType { get; set; }

    /// <summary>WebForms 4.5 model binding: parameterless page method invoked for the data.</summary>
    [Parameter] public string SelectMethod { get; set; }

    public override int SelectedIndex
    {
        get => Items.FindIndex(item => item.ResolvedValue == SelectedValue);
        set
        {
            if (value >= 0 && value < Items.Count)
            {
                SelectedValue = Items[value].ResolvedValue;
            }
        }
    }

    public ListItem SelectedItem => Items.FirstOrDefault(item => item.ResolvedValue == SelectedValue);

    /// <summary>
    /// WebForms ListControl.Text. It is NOT a caption: on a ListControl, Text reads and
    /// writes the SELECTED VALUE, which is why code-behind sets "ddl.Text = savedValue" to
    /// restore a selection. Mapping it to anything else would silently change what the
    /// list shows as chosen.
    /// </summary>
    [Parameter]
    public string Text
    {
        get => SelectedValue;
        set => SelectedValue = value;
    }

    /// <summary>
    /// WebForms AutoPostBack. A Blazor @onchange already raises
    /// SelectedIndexChanged on every change, so the list behaves as AutoPostBack="true"
    /// always did; setting it false does NOT suppress the event, because the compat list
    /// has no deferred postback to hold it until.
    /// </summary>
    [Parameter] public bool AutoPostBack { get; set; } = true;

    /// <summary>
    /// WebForms ListControl.ClearSelection equivalent. Code-behind calls it before
    /// selecting a new item; the selection here is the value, so clearing it is enough.
    /// </summary>
    public override void ClearSelection()
    {
        foreach (var item in Items)
        {
            item.Selected = false;
        }
        SelectedValue = string.Empty;
    }

    void IListItemContainer.AddItem(ListItem item)
    {
        Items.Add(item);
        if (item.Selected)
        {
            _selectedValue = item.ResolvedValue;
        }
        _itemsChanged = true;
    }

    /// <summary>When true, DataBind keeps declarative ListItems and appends (WebForms compatible).</summary>
    [Parameter] public bool AppendDataBoundItems { get; set; }

    /// <summary>WebForms DataBind() equivalent.</summary>
    public override void DataBind()
    {
        if (!AppendDataBoundItems)
        {
            Items.Clear();
        }
        foreach (var row in DataSourceHelper.Materialize(DataSource))
        {
            var text = string.IsNullOrEmpty(DataTextField)
                ? row?.ToString()
                : DataBinder.Eval(row, DataTextField)?.ToString();
            var value = string.IsNullOrEmpty(DataValueField)
                ? text
                : DataBinder.Eval(row, DataValueField)?.ToString();
            Items.Add(new ListItem(text, value));
        }
        StateHasChanged();
    }

    /// <summary>
    /// Binds a markup-declared DataSource once, on the FIRST call only - OnParametersSet
    /// runs again on every later re-render (e.g. the one DataBind() itself schedules via
    /// StateHasChanged), and by then the SelectMethod path above may have populated
    /// DataSource too; gating on "DataSource is not null yet" instead of a first-call flag
    /// re-fired on that later call and doubled every bound item.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_dataSourceBoundFromMarkup)
        {
            return;
        }
        _dataSourceBoundFromMarkup = true;
        if (DataSource is not null)
        {
            DataBind();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && DataSource is null && !string.IsNullOrEmpty(SelectMethod))
        {
            DataSource = ModelBinding.InvokeSelectMethod(Host, SelectMethod);
            DataBind();
        }

        // Declarative <ListItem> children register during the first render,
        // so render once more after collecting them
        if (_itemsChanged)
        {
            _itemsChanged = false;
            StateHasChanged();
        }
    }

    private void HandleChange(ChangeEventArgs e)
    {
        _selectedValue = e.Value?.ToString() ?? string.Empty;
        MarkStateTouched();
        OnSelectedIndexChanged?.Invoke(this, EventArgs.Empty);
        Host?.HostCore.NotifyPostBackEvent();
    }

    public string GetControlValue() => SelectedValue;
}
