+        /// <summary>
+        /// Pixel data is grayscale.
+        /// </summary>
+        ColorSpaceGray = 0x0040,
+        ColorSpaceYcbcr = 0x0080,
+        ColorSpaceYcck = 0x0100,
+
+        // Low-word: image size info
+
+        HasRealDpi = 0x1000,
+        HasRealPixelSize = 0x2000,
+
+        // High-word
+
+        ReadOnly = 0x00010000,
