<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet-coverage settings (tools.py): the tools written new (the converter, its analysis and analyzers, Studio), by the DLL's name. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*FrameworkOnCore\.(Converter|Analysis|Analyzers|Studio)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <EnableStaticNativeInstrumentation>False</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
  </CodeCoverage>
</Configuration>
