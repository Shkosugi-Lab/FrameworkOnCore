        "</div>",
        "<input name=\"txtName\" type=\"text\" id=\"txtName\">",
        "<select name=\"ddlKind\" onchange=\"javascript:setTimeout('__doPostBack(\\'ddlKind\\',\\'\\')', 0)\" id=\"ddlKind\">",
