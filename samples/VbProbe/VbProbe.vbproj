<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Visual Basic, against the original on IIS (experiments/wf4c/sample-parity.ps1): the VB runtime's functions
       (Format, FormatNumber, Str, Val, IsNumeric, StrConv, Asc/Chr, Like, the date functions, Rnd, Err), late binding,
       Handles and WithEvents, XML literals, and a page whose code is in its markup (compiled by the server's vbc). -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{1B6E3F8A-27C4-4D59-A0E1-6F3B8C2D9A17}</ProjectGuid>
    <ProjectTypeGuids>{349c5851-65df-11da-9384-00065b846f21};{F184B08F-C81C-45F6-A57F-5ABD9991F28F}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>VbProbe</RootNamespace>
    <AssemblyName>VbProbe</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <MyType>Web</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OutputPath>bin\</OutputPath>
    <DocumentationFile>VbProbe.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
    <Import Include="System.Web" />
    <Import Include="System.Web.UI" />
    <Import Include="System.Web.UI.WebControls" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Runtime.aspx" />
    <Content Include="Markup.aspx" />
    <Content Include="Events.aspx" />
    <Content Include="Web.config" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Probe.vb" />
    <Compile Include="Runtime.aspx.vb"><DependentUpon>Runtime.aspx</DependentUpon><SubType>ASPXCodebehind</SubType></Compile>
    <Compile Include="Events.aspx.vb"><DependentUpon>Events.aspx</DependentUpon><SubType>ASPXCodebehind</SubType></Compile>
    <Compile Include="Events.aspx.designer.vb"><DependentUpon>Events.aspx</DependentUpon></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
</Project>
