From 3abe7b438b0a4f1ef5c30736d96d46a6725b8597 Mon Sep 17 00:00:00 2001
From: shkosugi <sin.kosugi@gmail.com>
Date: Wed, 30 Sep 2026 23:39:12 +0900
Subject: [PATCH] Codegen directory cleanup on Linux: a loaded assembly's file
 is in use, as on Windows

After the pre-application-start methods, a changed application hash has the codegen directory
cleaned (BuildResultCache.RemoveAllCodegenFiles, TryDeleteFile; Util.RemoveOrRenameFile for its
subdirectories). Windows does not delete an assembly the process has loaded (in use: a .delete
marker is left, or the file renamed), and applications count on it: nopCommerce 3.90 shadow-copies
its plugins into the dynamic directory in its PreApplicationStart method and loads them, and the
page compilation then references them. Linux deleted them: a site's first start failed to compile
(CS0006, the plugins' files not found) and restarted (InitializationError), every new deployment.

Util.IsLoadedAssemblyFile (not on Windows, where the file system says so): a file that is the
location of an assembly loaded in the process is treated as in use by both deletions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Compilation/BuildResultCache.cs           | 10 ++++--
 src/WebFormsForCore.Web/UI/Util.cs            | 35 +++++++++++++++++++
 2 files changed, 42 insertions(+), 3 deletions(-)

diff --git a/src/WebFormsForCore.Web/Compilation/BuildResultCache.cs b/src/WebFormsForCore.Web/Compilation/BuildResultCache.cs
index e03bbf8..4bac07c 100644
--- a/src/WebFormsForCore.Web/Compilation/BuildResultCache.cs
+++ b/src/WebFormsForCore.Web/Compilation/BuildResultCache.cs
@@ -706,9 +706,13 @@ namespace System.Web.Compilation
 
 			try
 			{
-				f.Delete();
-				Debug.Trace("DiskBuildResultCache", "TryDeleteFile removed " + f.Name);
-				return true;
+				// WebFormsForCore: a loaded assembly's file is in use, as on Windows (Util.IsLoadedAssemblyFile).
+				if (!Util.IsLoadedAssemblyFile(f.FullName))
+				{
+					f.Delete();
+					Debug.Trace("DiskBuildResultCache", "TryDeleteFile removed " + f.Name);
+					return true;
+				}
 			}
 			catch { }
 
diff --git a/src/WebFormsForCore.Web/UI/Util.cs b/src/WebFormsForCore.Web/UI/Util.cs
index 5e8f478..b638d3e 100644
--- a/src/WebFormsForCore.Web/UI/Util.cs
+++ b/src/WebFormsForCore.Web/UI/Util.cs
@@ -466,6 +466,37 @@ namespace System.Web.UI
 		 * If the file doesn't exist, do nothing.  If it does try to delete it if possible.
 		 * If that fails, rename it with by appending a .delete extension to it
 		 */
+		/*
+		 * WebFormsForCore: whether the file is an assembly this process has loaded. Windows does not delete such a
+		 * file (it is in use), and ASP.NET counts on it: the codegen directory's cleanup after the pre-application-start
+		 * methods (a changed application hash) leaves the assemblies they copied there and loaded (nopCommerce's plugins,
+		 * shadow-copied into the dynamic directory), which the page compilation then references. Linux deletes them: the
+		 * first start failed to compile (CS0006, the plugins' files not found), and the application restarted.
+		 */
+		internal static bool IsLoadedAssemblyFile(string path)
+		{
+			if (OperatingSystem.IsWindows())
+				return false;
+			string full = Path.GetFullPath(path);
+			foreach (Assembly assembly in AppDomain.CurrentDomain.GetAssemblies())
+			{
+				if (assembly.IsDynamic)
+					continue;
+				string location;
+				try
+				{
+					location = assembly.Location;
+				}
+				catch (NotSupportedException)
+				{
+					continue;
+				}
+				if (location.Length > 0 && string.Equals(location, full, StringComparison.Ordinal))
+					return true;
+			}
+			return false;
+		}
+
 		internal static void RemoveOrRenameFile(string filename)
 		{
 			FileInfo fi = new FileInfo(filename);
@@ -480,6 +511,10 @@ namespace System.Web.UI
 		{
 			try
 			{
+				// WebFormsForCore: a loaded assembly's file is in use, as on Windows (renamed, not deleted).
+				if (IsLoadedAssemblyFile(f.FullName))
+					throw new IOException(f.FullName + " is in use");
+
 				// First, just try to delete the file
 				f.Delete();
 
-- 
2.55.0.windows.3

