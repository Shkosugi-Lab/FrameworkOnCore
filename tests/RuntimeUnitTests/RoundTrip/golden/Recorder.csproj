<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8's round trips the port's are compared with: see Program.cs. Not part of the test project
       (RuntimeUnitTests.csproj removes this folder from its compilation). The values, formats and cases are the tests' own
       files; the assembly has the tests' name and key (the values' types: the same identity as the tests' assembly, which
       reads what BinaryFormatter wrote of them). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FrameworkOnCore.Runtime.Tests</AssemblyName>
    <RootNamespace>FrameworkOnCore.Runtime.Tests</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\..\FrameworkOnCore.Runtime\src\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Security" />
    <Compile Include="..\Values.cs" Link="Values.cs" />
    <Compile Include="..\Formats.cs" Link="Formats.cs" />
    <Compile Include="..\Controls.cs" Link="Controls.cs" />
    <Compile Include="..\MachineKeyCases.cs" Link="MachineKeyCases.cs" />
    <Compile Include="..\..\Fuzz\FuzzInput.cs" Link="FuzzInput.cs" />
  </ItemGroup>
</Project>
