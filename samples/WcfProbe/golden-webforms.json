    {
      "Name": "wcf-ajax script proxy",
      "Path": "/ajax.svc/js",
      "Title": "",
      "Text": [
        "var Ajax=function() {",
        "Ajax.initializeBase(this);",
        "this._timeout = 0;",
        "this._userContext = null;",
        "this._succeeded = null;",
        "this._failed = null;",
        "}",
        "Ajax.prototype={",
        "_get_path:function() {",
        "var p = this.get_path();",
        "if (p) return p;",
        "else return Ajax._staticInstance.get_path();},",
        "Hello:function(name,succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'Hello',true,{name:name},succeededCallback,failedCallback,userContext); },",
        "Lookup:function(id,succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'Lookup',false,{id:id},succeededCallback,failedCallback,userContext); },",
        "Cheaper:function(than,succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'Cheaper',false,{than:than},succeededCallback,failedCallback,userContext); },",
        "When:function(year,succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'When',false,{year:year},succeededCallback,failedCallback,userContext); },",
        "Nothing:function(succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'Nothing',false,{},succeededCallback,failedCallback,userContext); },",
        "Fail:function(why,succeededCallback, failedCallback, userContext) {",
        "return this._invoke(this._get_path(), 'Fail',false,{why:why},succeededCallback,failedCallback,userContext); }}",
        "Ajax.registerClass('Ajax',Sys.Net.WebServiceProxy);",
        "Ajax._staticInstance = new Ajax();",
        "Ajax.set_path = function(value) { Ajax._staticInstance.set_path(value); }",
        "Ajax.get_path = function() { return Ajax._staticInstance.get_path(); }",
        "Ajax.set_timeout = function(value) { Ajax._staticInstance.set_timeout(value); }",
        "Ajax.get_timeout = function() { return Ajax._staticInstance.get_timeout(); }",
        "Ajax.set_defaultUserContext = function(value) { Ajax._staticInstance.set_defaultUserContext(value); }",
        "Ajax.get_defaultUserContext = function() { return Ajax._staticInstance.get_defaultUserContext(); }",
        "Ajax.set_defaultSucceededCallback = function(value) { Ajax._staticInstance.set_defaultSucceededCallback(value); }",
        "Ajax.get_defaultSucceededCallback = function() { return Ajax._staticInstance.get_defaultSucceededCallback(); }",
        "Ajax.set_defaultFailedCallback = function(value) { Ajax._staticInstance.set_defaultFailedCallback(value); }",
        "Ajax.get_defaultFailedCallback = function() { return Ajax._staticInstance.get_defaultFailedCallback(); }",
        "Ajax.set_enableJsonp = function(value) { Ajax._staticInstance.set_enableJsonp(value); }",
        "Ajax.get_enableJsonp = function() { return Ajax._staticInstance.get_enableJsonp(); }",
        "Ajax.set_jsonpCallbackParameter = function(value) { Ajax._staticInstance.set_jsonpCallbackParameter(value); }",
        "Ajax.get_jsonpCallbackParameter = function() { return Ajax._staticInstance.get_jsonpCallbackParameter(); }",
        "Ajax.set_path(\"http://localhost:5096/Ajax.svc\");",
        "Ajax.Hello= function(name,onSuccess,onFailed,userContext) {Ajax._staticInstance.Hello(name,onSuccess,onFailed,userContext); }",
        "Ajax.Lookup= function(id,onSuccess,onFailed,userContext) {Ajax._staticInstance.Lookup(id,onSuccess,onFailed,userContext); }",
        "Ajax.Cheaper= function(than,onSuccess,onFailed,userContext) {Ajax._staticInstance.Cheaper(than,onSuccess,onFailed,userContext); }",
        "Ajax.When= function(year,onSuccess,onFailed,userContext) {Ajax._staticInstance.When(year,onSuccess,onFailed,userContext); }",
        "Ajax.Nothing= function(onSuccess,onFailed,userContext) {Ajax._staticInstance.Nothing(onSuccess,onFailed,userContext); }",
        "Ajax.Fail= function(why,onSuccess,onFailed,userContext) {Ajax._staticInstance.Fail(why,onSuccess,onFailed,userContext); }",
        "var gtc = Sys.Net.WebServiceProxy._generateTypedConstructor;",
        "Type.registerNamespace('probe.example.catalog');",
