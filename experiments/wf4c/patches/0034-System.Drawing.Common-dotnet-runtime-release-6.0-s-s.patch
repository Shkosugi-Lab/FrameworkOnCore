diff --git a/src/WebFormsForCore.Drawing.Common/System/Drawing/Drawing2D/AdjustableArrowCap.cs b/src/WebFormsForCore.Drawing.Common/System/Drawing/Drawing2D/AdjustableArrowCap.cs
