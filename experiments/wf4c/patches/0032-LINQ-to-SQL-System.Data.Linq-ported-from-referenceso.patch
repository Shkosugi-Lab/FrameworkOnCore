+                // intialize arg values
+                for (int i = 0, n = cq.Arguments.Count; i < n; i++) {
+                    gen.Emit(OpCodes.Dup);
+                    this.GenerateConstInt(i);
+                    Type clrType = cq.Arguments[i].ClrType;
+                    if (cq.Arguments[i].NodeType == SqlNodeType.ColumnRef) {
