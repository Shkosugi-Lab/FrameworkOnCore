@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms LoginStatus equivalent: one link, whose text and target depend on whether
   anyone is signed in.

   The link is rendered - it used to be nothing at all - and clicking it raises
   LoggingOut / LoggedOut so a page that handles those still runs. The sign-out itself is
   NOT performed here: authentication is ASP.NET Core's in the converted application, and
   signing someone out of a scheme this layer knows nothing about would be a guess. The
   residual says so. *@
@if (Visible)
{
    <a @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
       href="@(IsAuthenticated ? LogoutPageUrl : LoginPageUrl)"
       @onclick="Clicked" @onclick:preventDefault="@(IsAuthenticated && string.IsNullOrEmpty(LogoutPageUrl))">
        @(IsAuthenticated ? LogoutText : LoginText)
    </a>
}

@code {
    [Parameter] public string LoginText { get; set; } = "Login";
    [Parameter] public string LogoutText { get; set; } = "Logout";
    [Parameter] public string LoginImageUrl { get; set; }
    [Parameter] public string LogoutImageUrl { get; set; }

    /// <summary>WebForms LogoutPageUrl / LoginPageUrl: where the link goes.</summary>
    [Parameter] public string LogoutPageUrl { get; set; }
    [Parameter] public string LoginPageUrl { get; set; } = "~/login.aspx";

    /// <summary>WebForms LogoutAction (Refresh / Redirect / RedirectToLoginPage). Carried, not acted on.</summary>
    [Parameter] public string LogoutAction { get; set; } = "Refresh";

    // LoginCancelEventArgs, as WebForms declared it: WingtipToys signs the user out in
    // this handler and its signature is (object, LoginCancelEventArgs).
    [Parameter] public EventHandler<LoginCancelEventArgs> OnLoggingOut { get; set; }
    [Parameter] public EventHandler OnLoggedOut { get; set; }

    public event EventHandler<LoginCancelEventArgs> LoggingOut
    {
        add => OnLoggingOut += value;
        remove => OnLoggingOut -= value;
    }

    public event EventHandler LoggedOut
    {
        add => OnLoggedOut += value;
        remove => OnLoggedOut -= value;
    }

    private static bool IsAuthenticated
        => HttpContext.Current?.User?.Identity?.IsAuthenticated == true;

    private void Clicked()
    {
        if (!IsAuthenticated)
        {
            return;
        }

        var cancel = new LoginCancelEventArgs();
        OnLoggingOut?.Invoke(this, cancel);
        if (cancel.Cancel)
        {
            return;
        }

        OnLoggedOut?.Invoke(this, EventArgs.Empty);
        Host?.HostCore.NotifyPostBackEvent();
    }
}
