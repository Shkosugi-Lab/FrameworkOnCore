<%@ Page Language="C#" AutoEventWireup="false" CodeBehind="DataSourceScenario.aspx.cs" Inherits="WebControlsProbe.DataSourceScenario" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Data source controls scenario</title>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ObjectDataSource ID="odsProducts" runat="server" TypeName="WebControlsProbe.ProductStore" SelectMethod="SelectAll" UpdateMethod="Update" DeleteMethod="Delete"
            OnSelecting="ObjectSelecting" OnSelected="ObjectSelected" OnUpdating="ObjectUpdating" OnUpdated="ObjectUpdated" OnDeleted="ObjectDeleted" />
        <asp:GridView ID="gvObject" runat="server" DataSourceID="odsProducts" DataKeyNames="Code" AutoGenerateColumns="false" AutoGenerateEditButton="true" AutoGenerateDeleteButton="true">
            <Columns>
                <asp:BoundField DataField="Code" HeaderText="Code" ReadOnly="true" />
                <asp:BoundField DataField="Name" HeaderText="Name" />
                <asp:BoundField DataField="Price" HeaderText="Price" />
            </Columns>
        </asp:GridView>
        <asp:SqlDataSource ID="sdsProducts" runat="server" ProviderName="WebControlsProbe.Data" ConnectionString="memory"
            SelectCommand="select" UpdateCommand="update" InsertCommand="insert" DeleteCommand="delete"
            OnSelecting="SqlSelecting" OnSelected="SqlSelected" OnUpdated="SqlUpdated" OnInserted="SqlInserted" OnDeleted="SqlDeleted">
            <UpdateParameters>
                <asp:Parameter Name="Code" Type="String" />
                <asp:Parameter Name="Name" Type="String" />
                <asp:Parameter Name="Price" Type="Decimal" />
            </UpdateParameters>
            <InsertParameters>
                <asp:Parameter Name="Code" Type="String" />
                <asp:Parameter Name="Name" Type="String" />
                <asp:Parameter Name="Price" Type="Decimal" />
            </InsertParameters>
            <DeleteParameters>
                <asp:Parameter Name="Code" Type="String" />
            </DeleteParameters>
        </asp:SqlDataSource>
        <asp:GridView ID="gvSql" runat="server" DataSourceID="sdsProducts" DataKeyNames="Code" AutoGenerateColumns="false" AutoGenerateEditButton="true" AutoGenerateDeleteButton="true" AllowSorting="true">
            <Columns>
                <asp:BoundField DataField="Code" HeaderText="Code" ReadOnly="true" SortExpression="Code" />
                <asp:BoundField DataField="Name" HeaderText="Name" SortExpression="Name" />
                <asp:BoundField DataField="Price" HeaderText="Price" SortExpression="Price" />
            </Columns>
        </asp:GridView>
        <asp:DetailsView ID="dvSqlInsert" runat="server" DataSourceID="sdsProducts" DefaultMode="Insert" AutoGenerateRows="false" AutoGenerateInsertButton="true">
            <Fields>
                <asp:BoundField DataField="Code" HeaderText="Code" />
                <asp:BoundField DataField="Name" HeaderText="Name" />
                <asp:BoundField DataField="Price" HeaderText="Price" />
            </Fields>
        </asp:DetailsView>
        <asp:AccessDataSource ID="adsProducts" runat="server" DataFile="~/App_Data/probe.mdb" SelectCommand="SELECT * FROM Products" />
        <asp:XmlDataSource ID="xdsProducts" runat="server" DataFile="~/App_Data/products.xml" XPath="products/product" />
        <asp:GridView ID="gvXml" runat="server" DataSourceID="xdsProducts" />
        <asp:GridView ID="gvHidden" runat="server" DataSourceID="xdsProducts" Visible="false" />
        <asp:LinqDataSource ID="ldsProducts" runat="server" ContextTypeName="WebControlsProbe.ProbeLinqContext" TableName="Products"
            Where="Price &gt; @Minimum" OrderBy="Name" OnSelecting="LinqSelecting">
            <WhereParameters>
                <asp:ControlParameter Name="Minimum" ControlID="txtMinimum" PropertyName="Text" Type="Decimal" DefaultValue="0" />
            </WhereParameters>
        </asp:LinqDataSource>
        <p>Minimum price: <asp:TextBox ID="txtMinimum" runat="server" Text="2" /></p>
        <asp:GridView ID="gvLinq" runat="server" DataSourceID="ldsProducts" AutoGenerateColumns="false" AllowPaging="true" PageSize="3" AllowSorting="true">
            <Columns>
                <asp:BoundField DataField="Code" HeaderText="Code" SortExpression="Code" />
                <asp:BoundField DataField="Name" HeaderText="Name" SortExpression="Name" />
                <asp:BoundField DataField="Price" HeaderText="Price" SortExpression="Price" />
            </Columns>
        </asp:GridView>
        <asp:LinqDataSource ID="ldsSearched" runat="server" ContextTypeName="WebControlsProbe.ProbeLinqContext" TableName="Products" OrderBy="Code" />
        <asp:QueryExtender ID="qeSearch" runat="server" TargetControlID="ldsSearched">
            <asp:SearchExpression DataFields="Name" SearchType="Contains">
                <asp:ControlParameter ControlID="txtSearch" PropertyName="Text" />
            </asp:SearchExpression>
        </asp:QueryExtender>
        <p>Search: <asp:TextBox ID="txtSearch" runat="server" Text="e" /></p>
        <asp:GridView ID="gvSearched" runat="server" DataSourceID="ldsSearched" AutoGenerateColumns="false">
            <Columns>
                <asp:BoundField DataField="Code" HeaderText="Code" />
                <asp:BoundField DataField="Name" HeaderText="Name" />
            </Columns>
        </asp:GridView>
        <p>
            Model state: <asp:TextBox ID="txtModelName" runat="server" />
            <asp:ModelErrorMessage ID="memName" runat="server" ModelStateKey="Name" AssociatedControlID="txtModelName" />
            <asp:ModelErrorMessage ID="memBound" runat="server" ModelStateKey='<%# "Name" %>' CssClass="bound" />
            <asp:Button ID="btnModel" runat="server" Text="Check the model" OnClick="CheckModel" />
        </p>
        <p>Dynamic: <asp:PlaceHolder ID="Dynamic" runat="server" /></p>
        <p>
            <asp:Button ID="btnSubmit" runat="server" Text="Submit" />
            <asp:Button ID="btnShow" runat="server" Text="Show hidden" OnClick="ShowHidden" />
        </p>
        <pre id="log"><asp:Literal ID="Log" runat="server" EnableViewState="false" /></pre>
    </form>
</body>
</html>
