@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms Table family (declarative usage; code-behind Rows.Add is the dynamic-control
   domain and out of scope). TableRow / TableCell / TableHeaderCell render inside. *@
@if (Visible)
{
    <table @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
           cellspacing="@(CellSpacing >= 0 ? CellSpacing : (int?)null)"
           cellpadding="@(CellPadding >= 0 ? CellPadding : (int?)null)">
        <tbody>@ChildContent</tbody>
    </table>
}

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public int CellPadding { get; set; } = -1;
    [Parameter] public int CellSpacing { get; set; } = -1;

    /// <summary>
    /// WebForms Table.Rows equivalent.
    ///
    /// Empty, and it stays empty: Blazor builds the row tree from the markup inside
    /// ChildContent, so there is no per-table row list to hand back. Ported code that
    /// walks a table ("innerTable.Rows.Count") compiles and finds nothing, which is what
    /// it would find - the same bargain DataControlFieldCell.Controls records.
    ///
    /// Adding to it does NOT render a row. A table built entirely in code-behind is
    /// reported as a residual against the control rather than silently made to look as
    /// though it worked.
    /// </summary>
    public List<TableRow> Rows { get; } = [];

    /// <summary>
    /// WebForms Table.GridLines equivalent. The enum, not a string: ported code compares
    /// it against GridLines members. None is the original's default.
    /// </summary>
    [Parameter] public GridLines GridLines { get; set; } = GridLines.None;
}
