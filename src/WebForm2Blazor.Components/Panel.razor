@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@if (Visible)
{
    @if (!string.IsNullOrEmpty(GroupingText))
    {
        @* WebForms GroupingText equivalent: a fieldset + legend nested inside the outer
           div (the ID stays on the div, matching the legacy rendering) *@
        <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
             onkeypress="@DefaultButtonScript">
            <fieldset>
                <legend>@GroupingText</legend>
                @ChildContent
            </fieldset>
        </div>
    }
    else
    {
        <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
             onkeypress="@DefaultButtonScript">@ChildContent</div>
    }
}

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>Heading rendered as fieldset + legend (WebForms GroupingText equivalent).</summary>
    [Parameter] public string GroupingText { get; set; }

    /// <summary>ID of the button triggered by the Enter key (WebForms DefaultButton equivalent).</summary>
    [Parameter] public string DefaultButton { get; set; }

    private string DefaultButtonScript
        => string.IsNullOrEmpty(DefaultButton)
            ? null
            : $"if((event.key||'')==='Enter'&&event.target.tagName!=='TEXTAREA'){{var b=document.getElementById('{DefaultButton}');if(b){{b.click();event.preventDefault();return false;}}}}";
}
