+        /// </summary>
+        private void EnsureValidDashPattern()
+        {
+            int retval = 0;
+            int status = Gdip.GdipGetPenDashCount(new HandleRef(this, NativePen), out retval);
+            Gdip.CheckStatus(status);
+
+            if (retval == 0)
