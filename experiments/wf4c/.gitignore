# Every top-level subfolder is generated by run-sample.ps1 / convert-project.ps1 or is the
# old upstream clone (_upstream) / local feed - except the compatibility shims and the folders below.
/*/
# The original build's log (FrameworkOnCore --build-original: <out>.original.build.log).
/*.original.build.log
!/shims/
shims/*/bin/
shims/*/obj/
!/icu/
icu/*/bin/
icu/*/obj/
!/casefs/
casefs/out/
casefs/test/*/bin/
casefs/test/*/obj/
!/api-probe/
api-probe/bin/
api-probe/obj/
