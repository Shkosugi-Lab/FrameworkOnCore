<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- As the ASP.NET 1.1/2.0 applications the mobile controls are from: no jQuery mapping, validation scripts as before. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Web.Mobile, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
    <!-- The same numbers and messages wherever it runs (the server's culture otherwise). -->
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
    <!-- Device filters: by a capability's value, and by a method of the application's (the DeviceSpecific choices and
         MobileCapabilities.HasCapability ask them). -->
    <deviceFilters>
      <filter name="isHtml32" compare="PreferredRenderingType" argument="html32" />
      <filter name="isWml11" compare="PreferredRenderingType" argument="wml11" />
      <filter name="isProbe" type="MobileProbe.DeviceFilters, MobileProbe" method="IsProbe" />
    </deviceFilters>
    <pages>
      <controls>
        <add tagPrefix="mobile" namespace="System.Web.UI.MobileControls" assembly="System.Web.Mobile, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </controls>
    </pages>
  </system.web>
</configuration>