<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- ClientIDMode is left at the framework default (Predictable) on purpose: this
         suite also measures the ClientID prefix that naming containers (ContentPlaceHolder,
         user control) put in front of a control's DOM id. -->
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>
</configuration>
