<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converts a .NET Framework web application to .NET 10 on WebFormsForCore, to run on Linux
       (LINUX-CONVERTER-DESIGN.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FrameworkOnCore.Converter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build errors are located in the syntax tree to stub members (never by text). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <!-- Visual Basic's sources: the rewrites write in the file's language (SourceLanguage). -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Run in the converted applications' build (BuildFixer): copied next to the converter. -->
    <ProjectReference Include="..\FrameworkOnCore.Analyzers\FrameworkOnCore.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rules are data: adding one is the usual maintenance. -->
    <None Include="rules\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not "Program.cs.txt": "cs" would be read as a culture (Czech), into a satellite assembly. -->
    <EmbeddedResource Include="templates\ProgramTemplate.txt" LogicalName="ProgramTemplate.txt" />
    <EmbeddedResource Include="templates\ProgramTemplate.vb.txt" LogicalName="ProgramTemplate.vb.txt" />
  </ItemGroup>
</Project>
