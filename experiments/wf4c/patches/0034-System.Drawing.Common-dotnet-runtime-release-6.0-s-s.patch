+                Gdip.CheckStatus(Gdip.GdipCreateMatrix3(ref rect, p, out IntPtr nativeMatrix));
+                NativeMatrix = nativeMatrix;
+            }
+        }
+
+        public unsafe Matrix(Rectangle rect, Point[] plgpts)
