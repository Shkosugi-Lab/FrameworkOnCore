    { "action": "snapshot", "name": "handler-a handler of web.config's" },
    { "action": "goto", "path": "/a.aprobe" },
    { "action": "snapshot", "name": "handler-an asynchronous handler" },
    { "action": "goto", "path": "/AsyncPage.aspx" },
    { "action": "snapshot", "name": "async-an asynchronous page: async void Page_Load, RegisterAsyncTask" },
    { "action": "goto", "path": "/Transfer.aspx" },
    { "action": "fill", "target": "txtValue", "value": "carried" },
    { "action": "click", "target": "btnTransfer" },
    { "action": "snapshot", "name": "transfer-Server.Transfer with the form" },
    { "action": "goto", "path": "/Transfer.aspx" },
    { "action": "fill", "target": "txtValue", "value": "carried" },
    { "action": "click", "target": "btnTransferNoForm" },
    { "action": "snapshot", "name": "transfer-Server.Transfer without the form" },
