@namespace WebForm2Blazor.Components
@inherits WebControl
@implements IColumnContainer
@implements ICommandSink
@using System.Collections.Specialized

@* Collects the <BoundField> / <TemplateField> declared inside <Columns>. The fields render nothing themselves. *@
<CascadingValue Value="(IColumnContainer)this" IsFixed="true">@ColumnsContent</CascadingValue>

@if (Visible)
{
    @if (_rowContainers.Count == 0 && EmptyDataTemplate is not null)
    {
        @EmptyDataTemplate
    }
    else if (_rowContainers.Count == 0 && !string.IsNullOrEmpty(EmptyDataText))
    {
        <span @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">@EmptyDataText</span>
    }
    else if (_rowContainers.Count == 0)
    {
        @* No rows and nothing declared to show instead: WebForms renders NOTHING AT ALL -
           no table, no header, no footer (measured against the original: WingtipToys'
           empty shopping cart has one table on the page, the converted one had two).
           Falling through to the table below printed a header for a grid the original
           never drew. *@
    }
    else
    {
        @* Reproduces the WebForms default rendering: GridLines=Both renders border="1"
           rules="all", and CellSpacing=0 renders cellspacing="0" + border-collapse:collapse.
           These are defaults that never appear in markup - without them the grid lines vanish. *@
        <table @attributes="ExtraAttributes" style="@TableStyle" id="@ClientID" class="@CssClass"
               cellspacing="@CellSpacing"
               cellpadding="@(CellPadding >= 0 ? CellPadding : (int?)null)"
               border="@(IsGridLinesNone ? 0 : 1)" rules="@RulesValue">
            @if (!string.IsNullOrEmpty(Caption))
            {
                <caption>@Caption</caption>
            }
            @if (ShowHeader && !DataGridMode)
            {
            <thead>
                <tr @attributes="_headerRow?.AttributeBag"
                    class="@(_headerRow?.CssClass ?? HeaderStyleCssClass)"
                    style="@ComposeRowStyle(HeaderStyleBackColor, HeaderStyleForeColor, HeaderStyleFontBold)">
                    @foreach (var column in VisibleColumns)
                    {
                        <th scope="col" align="@column.HeaderAlignAttribute" class="@column.HeaderStyleCssClass" style="@column.HeaderCellStyle">
                            @if (column is TemplateField { HeaderTemplate: not null } headerTemplateField)
                            {
                                @headerTemplateField.HeaderTemplate
                            }
                            else if (AllowSorting && !string.IsNullOrEmpty(column.SortExpression))
                            {
                                var expression = column.SortExpression;
                                <a href="javascript:void(0)" @onclick="() => HandleSort(expression)">@column.HeaderText</a>
                            }
                            else
                            {
                                @column.HeaderText
                            }
                        </th>
                    }
                </tr>
            </thead>
            }
            <tbody>
                @if (ShowHeader && DataGridMode)
                {
                    @* The legacy DataGrid renders its header as a plain td row inside the
                       body - no thead / th / scope (measured on 4.8). UseAccessibleHeader
                       is what turns those cells into th, and it is off by default. *@
                    <tr @attributes="_headerRow?.AttributeBag"
                        class="@(_headerRow?.CssClass ?? HeaderStyleCssClass)"
                        style="@ComposeRowStyle(HeaderStyleBackColor, HeaderStyleForeColor, HeaderStyleFontBold)">
                        @foreach (var column in VisibleColumns)
                        {
                            @if (UseAccessibleHeader)
                            {
                                <th scope="col" class="@column.HeaderStyleCssClass" style="@column.HeaderCellStyle">
                                    @LegacyHeaderContent(column)
                                </th>
                            }
                            else
                            {
                                <td class="@column.HeaderStyleCssClass" style="@column.HeaderCellStyle">
                                    @LegacyHeaderContent(column)
                                </td>
                            }
                        }
                    </tr>
                }
                @for (var rowIndex = 0; rowIndex < _gridRows.Count; rowIndex++)
                {
                    var gridRow = _gridRows[rowIndex];
                    var container = gridRow.Container;
                    var commandContext = new GridViewRowCommandContext(this, rowIndex);
                    <tr @attributes="gridRow.AttributeBag"
                        class="@(gridRow.CssClass ?? RowClass(rowIndex))" style="@RowInlineStyle(rowIndex)">
                        @foreach (var column in VisibleColumns)
                        {
                            <td align="@column.ItemAlignAttribute" class="@column.ItemStyleCssClass" style="@column.ItemCellStyle">
                                @if (column is TemplateField templateField && SelectRowTemplate(templateField, rowIndex) is { } rowTemplate)
                                {
                                    @* Commands raised inside a TemplateField bubble to RowCommand
                                       (and RowDeleting / RowEditing for the standard command names) *@
                                    <CascadingValue TValue="RepeaterItem" Value="container" IsFixed="true">
                                        <CascadingValue TValue="ICommandSink" Value="(ICommandSink)commandContext" IsFixed="true">
                                            @(DataItemScope.Render(container, rowTemplate(container)))
                                        </CascadingValue>
                                    </CascadingValue>
                                }
                                else if (column is BoundField boundField)
                                {
                                    @boundField.GetCellText(container.DataItem)
                                }
                                else if (column is LegacyColumnField legacyColumn)
                                {
                                    @* The ported column renders the cell itself, through
                                       the WebForms protocol: its template is instantiated
                                       into a cell bound to this row's data item. *@
                                    @((MarkupString)legacyColumn.RenderCell(container.DataItem, rowIndex, ListItemType.Item))
                                }
                            </td>
                        }
                    </tr>
                }
                @if (ShowFooter && DataGridMode)
                {
                    @* The legacy DataGrid keeps its footer inside tbody, like its header *@
                    <tr class="@FooterStyleCssClass">
                        @foreach (var column in VisibleColumns)
                        {
                            <td class="@column.FooterStyleCssClass">@FooterContent(column)</td>
                        }
                    </tr>
                }
                @if (AllowPaging && PageCount > 1)
                {
                    @* Same DOM structure as the WebForms Numeric pager (a nested table inside a td).
                       Matching the structure is what makes the parity comparison with the
                       pre-conversion app hold. *@
                    <tr class="@PagerStyleCssClass">
                        <td colspan="@VisibleColumns.Count()">
                            <table>
                                <tbody>
                                    <tr>
                                        @for (var pagerIndex = 0; pagerIndex < PageCount; pagerIndex++)
                                        {
                                            var targetPage = pagerIndex;
                                            <td>
                                                @if (targetPage == PageIndex)
                                                {
                                                    <span>@(targetPage + 1)</span>
                                                }
                                                else
                                                {
                                                    <a href="javascript:void(0)" @onclick="() => HandlePageClick(targetPage)">@(targetPage + 1)</a>
                                                }
                                            </td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
            </tbody>
            @if (ShowFooter && !DataGridMode)
            {
                @* WebForms puts the footer row in its own tfoot, after tbody (measured on 4.8) *@
                <tfoot>
                    <tr class="@FooterStyleCssClass">
                        @foreach (var column in VisibleColumns)
                        {
                            <td class="@column.FooterStyleCssClass">@FooterContent(column)</td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    }
}

@code {
    private readonly List<DataControlField> _columns = new();
    private List<object> _allRows = new();
    private readonly List<RepeaterItem> _rowContainers = new();
    private readonly List<GridViewRow> _gridRows = new();
    private GridViewRow _headerRow;
    private bool _columnsChanged;
    private bool _pendingRowDataBound;
    private bool _pendingItemDataBound;
    private int _pageIndex;
    private string _sortExpression;
    private SortDirection _sortDirection = SortDirection.Ascending;

    /// <summary>The declarative &lt;Columns&gt; markup. Named apart from <see cref="Columns"/>
    /// so that collection can keep the WebForms name code-behind mutates.</summary>
    [Parameter] public RenderFragment ColumnsContent { get; set; }

    /// <summary>
    /// WebForms GridView.Columns equivalent: the live column list. Declarative columns
    /// register here as they initialise, and code-behind can add more before DataBind.
    /// </summary>
    public List<DataControlField> Columns => _columns;

    /// <summary>
    /// The columns that actually render. WebForms honours DataControlField.Visible, and
    /// mojoPortal hides columns by role from code-behind; declaring the property without
    /// acting on it would compile and then show the column anyway.
    ///
    /// Visible defaults to true, so a grid that never touches it renders exactly as before.
    /// </summary>
    private IEnumerable<DataControlField> VisibleColumns => _columns.Where(column => column.Visible);

    /// <summary>
    /// WebForms GridView.HeaderRow / FooterRow / TopPagerRow / BottomPagerRow equivalents.
    ///
    /// HeaderRow is the row this grid actually renders (null when ShowHeader is off, as in
    /// the original). The other three answer null: this grid renders its footer and its
    /// pager inline rather than as addressable row objects, so there is no row to hand
    /// back - and a fabricated one would let a caller style something that is not there.
    ///
    /// mojoPortal's grid adapters walk these to reach the pager's inner table
    /// ("BottomPagerRow.Cells[0].Controls[0]"). That walk now compiles and finds nothing,
    /// which is the honest answer for a tree Blazor builds from markup - the same bargain
    /// DataControlFieldCell.Controls already records.
    /// </summary>
    public GridViewRow HeaderRow => _headerRow;

    /// <inheritdoc cref="HeaderRow"/>
    public GridViewRow FooterRow => null;

    /// <inheritdoc cref="HeaderRow"/>
    public GridViewRow TopPagerRow => null;

    /// <inheritdoc cref="HeaderRow"/>
    public GridViewRow BottomPagerRow => null;

    /// <summary>
    /// WebForms GridView.PagerSettings equivalent.
    ///
    /// Carried; this grid renders the Numeric pager whose DOM the parity comparison is
    /// built on, and does not switch on Mode. Changing that is a rendering change with a
    /// golden master behind it, so the settings are read back rather than acted on.
    /// </summary>
    public PagerSettings PagerSettings { get; } = new();
    [Parameter] public bool AutoGenerateColumns { get; set; } = true;
    [Parameter] public string EmptyDataText { get; set; }

    /// <summary>Rendered instead of EmptyDataText when the grid has no rows.</summary>
    [Parameter] public RenderFragment EmptyDataTemplate { get; set; }

    /// <summary>Accepted for markup compatibility; the numeric pager renders instead.</summary>
    [Parameter] public RenderFragment PagerTemplate { get; set; }

    /// <summary>Rendered as a &lt;caption&gt; (WebForms Caption equivalent).</summary>
    [Parameter] public string Caption { get; set; }

    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>
    /// Legacy DataGrid rendering (the converter maps asp:DataGrid onto this component
    /// with this flag fixed): the header renders as a plain td row inside the body.
    /// </summary>
    [Parameter] public bool DataGridMode { get; set; }

    /// <summary>
    /// WebForms AutoGenerateEditButton / AutoGenerateDeleteButton equivalents. The compat
    /// GridView renders commands from TemplateField content rather than synthesising a
    /// command column, so these are accepted and add no column; the Edit / Delete buttons
    /// a page already declares keep working through RowCommand.
    /// </summary>
    [Parameter] public bool AutoGenerateEditButton { get; set; }

    /// <inheritdoc cref="AutoGenerateEditButton"/>
    [Parameter] public bool AutoGenerateDeleteButton { get; set; }

    /// <inheritdoc cref="AutoGenerateEditButton"/>
    [Parameter] public bool AutoGenerateSelectButton { get; set; }

    /// <summary>
    /// WebForms DataKeyNames equivalent - the key columns, as string[] like the original
    /// (code-behind assigns new[] { ... }). Markup writes them comma-separated and the
    /// converter renders the array literal.
    /// </summary>
    [Parameter] public string[] DataKeyNames { get; set; }

    /// <summary>
    /// WebForms UseAccessibleHeader equivalent. Only the legacy DataGrid rendering is
    /// affected: it emits td header cells by default and th when this is on. A GridView
    /// already renders th, so the flag makes no difference there (measured on 4.8).
    /// </summary>
    [Parameter] public bool UseAccessibleHeader { get; set; }

    /// <summary>
    /// WebForms EnableModelValidation equivalent. It controls how a data-source exception
    /// is surfaced during two-way binding; the compat GridView does no model binding of
    /// its own, so the flag is accepted and does nothing.
    /// </summary>
    [Parameter] public bool EnableModelValidation { get; set; }

    /// <summary>
    /// WebForms ShowFooter equivalent (default false). The footer cells take their content
    /// from a TemplateField's FooterTemplate, otherwise from the field's FooterText.
    /// </summary>
    [Parameter] public bool ShowFooter { get; set; }

    /// <summary>WebForms FooterStyle-CssClass equivalent (flattened by the converter, like the other row styles).</summary>
    [Parameter] public string FooterStyleCssClass { get; set; }

    private RenderFragment FooterContent(DataControlField column) => builder =>
    {
        if (column is TemplateField { FooterTemplate: not null } templateField)
        {
            builder.AddContent(0, templateField.FooterTemplate);
        }
        else
        {
            builder.AddContent(1, column.FooterText);
        }
    };

    private RenderFragment LegacyHeaderContent(DataControlField column) => builder =>
    {
        if (column is TemplateField { HeaderTemplate: not null } templateField)
        {
            builder.AddContent(0, templateField.HeaderTemplate);
        }
        else if (column is LegacyColumnField legacyColumn)
        {
            // The ported column builds its own header - DNN's TextColumn puts the
            // HeaderText in a Label through a HeaderTemplate - and falls back to the plain
            // text when it declares no header template.
            var header = legacyColumn.RenderCell(null, -1, ListItemType.Header);
            if (string.IsNullOrEmpty(header))
            {
                builder.AddContent(2, legacyColumn.HeaderTextOrColumn);
            }
            else
            {
                builder.AddContent(3, (MarkupString)header);
            }
        }
        else
        {
            builder.AddContent(1, column.HeaderText);
        }
    };

    // --- Row styles (WebForms HeaderStyle / RowStyle / AlternatingRowStyle equivalent).
    //     The converter flattens both markup forms - the "HeaderStyle-CssClass" attribute
    //     and the <HeaderStyle CssClass=.../> child element - onto these parameters. ---
    [Parameter] public string HeaderStyleCssClass { get; set; }
    [Parameter] public string HeaderStyleBackColor { get; set; }
    [Parameter] public string HeaderStyleForeColor { get; set; }
    [Parameter] public bool HeaderStyleFontBold { get; set; }
    [Parameter] public string RowStyleCssClass { get; set; }
    [Parameter] public string RowStyleBackColor { get; set; }
    [Parameter] public string RowStyleForeColor { get; set; }
    [Parameter] public bool RowStyleFontBold { get; set; }
    [Parameter] public string AlternatingRowStyleCssClass { get; set; }
    [Parameter] public string AlternatingRowStyleBackColor { get; set; }
    [Parameter] public string AlternatingRowStyleForeColor { get; set; }
    [Parameter] public bool AlternatingRowStyleFontBold { get; set; }

    // --- The same styles as OBJECTS, which is how code-behind asks for them.
    //
    // "gridView.HeaderStyle.CssClass" is the WebForms spelling and mojoPortal's grid
    // adapters use it 34 times. These are views over the parameters above, not separate
    // state: the markup writes the parameter, the code-behind reads the object, and both
    // see one value. A second set of fields would answer every one of those reads with
    // an empty string while the real value sat in the parameter.
    //
    // Built once and cached: a fresh object per get would make "HeaderStyle.CssClass = x"
    // write to a temporary and vanish.
    private TableItemStyle _headerStyleObject;
    private TableItemStyle _rowStyleObject;
    private TableItemStyle _alternatingRowStyleObject;
    private TableItemStyle _footerStyleObject;
    private TableItemStyle _pagerStyleObject;
    private TableItemStyle _selectedRowStyleObject;
    private TableItemStyle _editRowStyleObject;

    public TableItemStyle HeaderStyle => _headerStyleObject ??= new BoundTableItemStyle(
        () => HeaderStyleCssClass, value => HeaderStyleCssClass = value,
        () => HeaderStyleBackColor, value => HeaderStyleBackColor = value,
        () => HeaderStyleForeColor, value => HeaderStyleForeColor = value);

    public TableItemStyle RowStyle => _rowStyleObject ??= new BoundTableItemStyle(
        () => RowStyleCssClass, value => RowStyleCssClass = value,
        () => RowStyleBackColor, value => RowStyleBackColor = value,
        () => RowStyleForeColor, value => RowStyleForeColor = value);

    public TableItemStyle AlternatingRowStyle => _alternatingRowStyleObject ??= new BoundTableItemStyle(
        () => AlternatingRowStyleCssClass, value => AlternatingRowStyleCssClass = value,
        () => AlternatingRowStyleBackColor, value => AlternatingRowStyleBackColor = value,
        () => AlternatingRowStyleForeColor, value => AlternatingRowStyleForeColor = value);

    public TableItemStyle FooterStyle => _footerStyleObject ??= new BoundTableItemStyle(
        () => FooterStyleCssClass, value => FooterStyleCssClass = value);

    public TableItemStyle PagerStyle => _pagerStyleObject ??= new BoundTableItemStyle(
        () => PagerStyleCssClass, value => PagerStyleCssClass = value);

    // No flattened parameter behind these two: the compat GridView renders neither a
    // selected-row nor an edit-row class, so there is nothing to be a view OVER. They hold
    // their own value so the property round-trips, and the control ignores it - which the
    // per-control residual already says.
    public TableItemStyle SelectedRowStyle => _selectedRowStyleObject ??= new TableItemStyle();

    public TableItemStyle EditRowStyle => _editRowStyleObject ??= new TableItemStyle();

    /// <summary>WebForms DataKeys equivalent (aligned with the rows of the current page).</summary>
    public DataKeyCollection DataKeys { get; private set; } = new(new List<DataKey>());

    // --- Grid lines and spacing (reproducing the WebForms defaults verbatim) ---

    /// <summary>None / Horizontal / Vertical / Both (the WebForms default is Both).</summary>
    [Parameter] public string GridLines { get; set; } = "Both";

    [Parameter] public int CellPadding { get; set; } = -1;
    [Parameter] public int CellSpacing { get; set; }

    private bool IsGridLinesNone
        => string.Equals(GridLines, "None", StringComparison.OrdinalIgnoreCase);

    private string RulesValue => (GridLines ?? "Both").Trim().ToLowerInvariant() switch
    {
        "horizontal" => "rows",
        "vertical" => "cols",
        "none" => null,
        _ => "all",
    };

    private string TableStyle
    {
        get
        {
            var style = ComputedStyle ?? string.Empty;
            if (CellSpacing == 0)
            {
                style += "border-collapse:collapse;";
            }
            return style.Length == 0 ? null : style;
        }
    }

    // --- Paging (WebForms compatible) ---
    [Parameter] public bool AllowPaging { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string PagerStyleCssClass { get; set; }
    [Parameter] public GridViewPageEventHandler OnPageIndexChanging { get; set; }

    /// <summary>
    /// WebForms PageIndexChanging as a CLR event: code-behind wires handlers imperatively
    /// (control.PageIndexChanging += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewPageEventHandler PageIndexChanging;

    /// <summary>WebForms OnPageIndexChanging (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void PageIndexChangingHandler(GridViewPageEventArgs e)
    {
        OnPageIndexChanging?.Invoke(this, e);
        PageIndexChanging?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms declarative binding: resolves the named ObjectDataSource via the host and
    /// binds automatically on first render (WebForms binds during PreRender).
    /// </summary>
    [Parameter] public string DataSourceID { get; set; }

    /// <summary>WebForms 4.5 model binding: the template item type (informational here).</summary>
    [Parameter] public string ItemType { get; set; }

    /// <summary>WebForms 4.5 model binding: parameterless page method invoked for the data.</summary>
    [Parameter] public string SelectMethod { get; set; }

    // --- Sorting (WebForms compatible) ---
    [Parameter] public bool AllowSorting { get; set; }
    [Parameter] public GridViewSortEventHandler OnSorting { get; set; }

    /// <summary>
    /// WebForms Sorting as a CLR event: code-behind wires handlers imperatively
    /// (control.Sorting += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewSortEventHandler Sorting;

    /// <summary>WebForms OnSorting (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void SortingHandler(GridViewSortEventArgs e)
    {
        OnSorting?.Invoke(this, e);
        Sorting?.Invoke(this, e);
    }

    // --- Row commands and row events (WebForms compatible) ---
    [Parameter] public GridViewCommandEventHandler OnRowCommand { get; set; }

    /// <summary>
    /// WebForms RowCommand as a CLR event: code-behind wires handlers imperatively
    /// (control.RowCommand += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewCommandEventHandler RowCommand;

    /// <summary>WebForms OnRowCommand (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowCommandHandler(GridViewCommandEventArgs e)
    {
        OnRowCommand?.Invoke(this, e);
        RowCommand?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms RowDataBound equivalent. In WebForms it fires during DataBind; here the
    /// row's controls exist only after the row has rendered, so it fires right after the
    /// first render following DataBind. Fires for the header row and each data row.
    /// </summary>
    [Parameter] public GridViewRowEventHandler OnRowDataBound { get; set; }

    /// <summary>
    /// WebForms RowDataBound as a CLR event: code-behind wires handlers imperatively
    /// (control.RowDataBound += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewRowEventHandler RowDataBound;

    /// <summary>WebForms OnRowDataBound (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowDataBoundHandler(GridViewRowEventArgs e)
    {
        OnRowDataBound?.Invoke(this, e);
        RowDataBound?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms DataGrid.ItemDataBound equivalent - this component stands in for DataGrid
    /// too (see DataGridMode). Fires for the same data rows Items below exposes, on the
    /// same terms as RowDataBound above.
    /// </summary>
    [Parameter] public EventHandler<DataGridItemEventArgs> OnItemDataBound { get; set; }

    public event EventHandler<DataGridItemEventArgs> ItemDataBound;

    /// <summary>WebForms DataGrid.OnItemDataBound (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void ItemDataBoundHandler(DataGridItemEventArgs e)
    {
        OnItemDataBound?.Invoke(this, e);
        ItemDataBound?.Invoke(this, e);
    }

    /// <summary>Fired when a command named "Delete" is raised inside a row.</summary>
    [Parameter] public GridViewDeleteEventHandler OnRowDeleting { get; set; }

    /// <summary>
    /// WebForms RowDeleting as a CLR event: code-behind wires handlers imperatively
    /// (control.RowDeleting += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewDeleteEventHandler RowDeleting;

    /// <summary>WebForms OnRowDeleting (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowDeletingHandler(GridViewDeleteEventArgs e)
    {
        OnRowDeleting?.Invoke(this, e);
        RowDeleting?.Invoke(this, e);
    }

    /// <summary>Fired when a command named "Edit" is raised inside a row.</summary>
    [Parameter] public GridViewEditEventHandler OnRowEditing { get; set; }

    /// <summary>WebForms RowUpdating: the "Update" command of a row in edit mode.</summary>
    [Parameter] public GridViewUpdateEventHandler OnRowUpdating { get; set; }

    /// <summary>
    /// WebForms RowUpdating as a CLR event: code-behind wires handlers imperatively
    /// (control.RowUpdating += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewUpdateEventHandler RowUpdating;

    /// <summary>WebForms OnRowUpdating (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowUpdatingHandler(GridViewUpdateEventArgs e)
    {
        OnRowUpdating?.Invoke(this, e);
        RowUpdating?.Invoke(this, e);
    }

    /// <summary>WebForms RowCancelingEdit: the "Cancel" command of a row in edit mode.</summary>
    [Parameter] public GridViewCancelEditEventHandler OnRowCancelingEdit { get; set; }

    /// <summary>
    /// WebForms RowCancelingEdit as a CLR event: code-behind wires handlers imperatively
    /// (control.RowCancelingEdit += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewCancelEditEventHandler RowCancelingEdit;

    /// <summary>WebForms OnRowCancelingEdit (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowCancelingEditHandler(GridViewCancelEditEventArgs e)
    {
        OnRowCancelingEdit?.Invoke(this, e);
        RowCancelingEdit?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms RowCreated. Blazor builds the row as part of rendering rather than in a
    /// separate creation phase, so this fires together with RowDataBound.
    /// </summary>
    [Parameter] public GridViewRowEventHandler OnRowCreated { get; set; }

    /// <summary>
    /// WebForms RowCreated as a CLR event: code-behind wires handlers imperatively
    /// (control.RowCreated += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewRowEventHandler RowCreated;

    /// <summary>WebForms OnRowCreated (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowCreatedHandler(GridViewRowEventArgs e)
    {
        OnRowCreated?.Invoke(this, e);
        RowCreated?.Invoke(this, e);
    }

    /// <summary>
    /// WebForms RowEditing as a CLR event: code-behind wires handlers imperatively
    /// (control.RowEditing += Handler), which a markup-only parameter cannot express.
    /// </summary>
    public event GridViewEditEventHandler RowEditing;

    /// <summary>WebForms OnRowEditing (renamed: see WebFormsControlBase, "Event naming").</summary>
    protected virtual void RowEditingHandler(GridViewEditEventArgs e)
    {
        OnRowEditing?.Invoke(this, e);
        RowEditing?.Invoke(this, e);
    }

    /// <summary>WebForms DataSource equivalent. Applied by DataBind().</summary>
    public object DataSource { get; set; }

    /// <summary>The current page (zero-based). Assigning from code-behind re-renders.</summary>
    public int PageIndex
    {
        get => _pageIndex;
        set
        {
            if (_pageIndex != value)
            {
                _pageIndex = Math.Max(0, value);
                RefreshView();
                StateHasChanged();
            }
        }
    }

    public int PageCount
        => !AllowPaging || PageSize <= 0 ? 1 : Math.Max(1, (_allRows.Count + PageSize - 1) / PageSize);

    /// <summary>WebForms Rows equivalent (the rows of the current page, with FindControl).</summary>
    public IReadOnlyList<GridViewRow> Rows => _gridRows;

    /// <summary>
    /// WebForms DataGrid.Items equivalent: THE SAME ROWS as <see cref="Rows"/>, under the
    /// name DataGrid gave them.
    ///
    /// This component stands in for both controls, and a .aspx written against DataGrid
    /// reaches its rows through Items - YAF's EditLanguage does, and casts each to
    /// DataGridItem. Every item forwards FindControl to its row, so a lookup through Items
    /// finds the same control a lookup through Rows finds.
    /// </summary>
    public DataGridItemCollection Items
    {
        get
        {
            var items = new DataGridItemCollection();
            foreach (var row in _gridRows)
            {
                items.Add(ToDataGridItem(row));
            }
            return items;
        }
    }

    private static DataGridItem ToDataGridItem(GridViewRow row) => new(
        row.RowIndex,
        row.RowIndex,
        row.RowState == DataControlRowState.Alternate
            ? ListItemType.AlternatingItem
            : ListItemType.Item)
    {
        DataItem = row.DataItem,
        RowFinder = row.FindControl,
    };

    void IColumnContainer.AddColumn(DataControlField column)
    {
        _columns.Add(column);
        _columnsChanged = true;
    }

    /// <summary>
    /// Ported column objects declared in &lt;Columns&gt; - DNN's textcolumn, imagecommandcolumn
    /// and friends. They are not components, so they cannot arrive through ColumnsContent;
    /// the converter passes their declarations and they are built here, in markup order,
    /// before any declarative column so the grid's column order matches the .aspx.
    /// </summary>
    [Parameter] public LegacyChild[] LegacyColumns { get; set; }

    private LegacyChild[] _builtLegacyColumns;

    private void BuildLegacyColumns()
    {
        if (ReferenceEquals(_builtLegacyColumns, LegacyColumns))
        {
            return;
        }

        _builtLegacyColumns = LegacyColumns;
        foreach (var declaration in LegacyColumns ?? [])
        {
            if (LegacyActivator.Create(declaration) is not TemplateColumn column)
            {
                // A column type that does not exist, or is not a column at all, is left
                // out rather than guessed at - the residual report names it.
                continue;
            }

            var field = new LegacyColumnField { Column = column, HeaderText = column.HeaderText };
            field.EnsureInitialized();
            _columns.Insert(Math.Min(_columns.Count, _legacyColumnCount++), field);
            _columnsChanged = true;
        }
    }

    private int _legacyColumnCount;

    void ICommandSink.RaiseCommand(object commandSource, CommandEventArgs args)
        => RowCommandHandler(new GridViewCommandEventArgs(commandSource, args));

    /// <summary>
    /// Receives commands bubbled from inside a row. Raises RowCommand, plus
    /// RowDeleting / RowEditing for the standard WebForms command names.
    /// </summary>
    internal void HandleRowCommand(object commandSource, CommandEventArgs args, int rowIndex)
    {
        RowCommandHandler(new GridViewCommandEventArgs(commandSource, args));

        // The WebForms edit flow: Edit / Update / Cancel raise their events and the
        // handler decides what EditIndex becomes. Nothing is assumed here - a page that
        // cancels the event (e.Cancel) or edits a different row stays in control.
        if (string.Equals(args.CommandName, "Delete", StringComparison.Ordinal))
        {
            RowDeletingHandler(new GridViewDeleteEventArgs(rowIndex, BuildKeys(rowIndex)));
        }
        else if (string.Equals(args.CommandName, "Edit", StringComparison.Ordinal))
        {
            RowEditingHandler(new GridViewEditEventArgs(rowIndex));
        }
        else if (string.Equals(args.CommandName, "Update", StringComparison.Ordinal))
        {
            RowUpdatingHandler(new GridViewUpdateEventArgs(rowIndex, BuildKeys(rowIndex)));
        }
        else if (string.Equals(args.CommandName, "Cancel", StringComparison.Ordinal))
        {
            RowCancelingEditHandler(new GridViewCancelEditEventArgs(rowIndex));
        }
    }

    /// <summary>
    /// WebForms EditIndex: the row rendered with EditItemTemplate (-1 = none). Assigning
    /// it from a RowEditing / RowCancelingEdit handler re-renders, as a postback would.
    /// </summary>
    public int EditIndex
    {
        get => _editIndex;
        set
        {
            if (_editIndex != value)
            {
                _editIndex = value;
                StateHasChanged();
            }
        }
    }

    private int _editIndex = -1;

    /// <summary>WebForms template precedence for a row: edit, then alternating, then item.</summary>
    private RenderFragment<RepeaterItem> SelectRowTemplate(TemplateField field, int rowIndex)
    {
        if (rowIndex == EditIndex && field.EditItemTemplate is not null)
        {
            return field.EditItemTemplate;
        }
        return rowIndex % 2 == 1 && field.AlternatingItemTemplate is not null
            ? field.AlternatingItemTemplate
            : field.ItemTemplate;
    }

    private OrderedDictionary BuildKeys(int rowIndex)
    {
        var keys = new OrderedDictionary();
        var dataKey = DataKeys[rowIndex];
        if (dataKey is not null)
        {
            foreach (var pair in dataKey.All)
            {
                keys[pair.Key] = pair.Value;
            }
        }
        return keys;
    }

    /// <summary>WebForms DataBind() equivalent.</summary>
    public override void DataBind()
    {
        _allRows = DataSourceHelper.Materialize(DataSource);

        if (AutoGenerateColumns && _columns.Count == 0 && _allRows.Count > 0)
        {
            // DataTable rows auto-generate from the table's columns, as in WebForms
            if (_allRows[0] is System.Data.DataRowView rowView)
            {
                foreach (System.Data.DataColumn column in rowView.Row.Table.Columns)
                {
                    _columns.Add(new BoundField { DataField = column.ColumnName, HeaderText = column.ColumnName });
                }
            }
            else
            {
                foreach (var property in _allRows[0].GetType().GetProperties())
                {
                    _columns.Add(new BoundField { DataField = property.Name, HeaderText = property.Name });
                }
            }
        }

        if (_pageIndex >= PageCount)
        {
            _pageIndex = PageCount - 1;
        }

        RefreshView();
        _pendingRowDataBound = true;
        _pendingItemDataBound = DataGridMode;
        StateHasChanged();
    }

    private void RefreshView()
    {
        var viewRows = AllowPaging && PageSize > 0
            ? _allRows.Skip(_pageIndex * PageSize).Take(PageSize).ToList()
            : _allRows;

        // Containers stay index-stable across binds so FindControl keeps resolving;
        // ItemIndex is absolute (page offset included), matching WebForms templates
        RowContainers.Rebind(_rowContainers, viewRows, AllowPaging && PageSize > 0 ? _pageIndex * PageSize : 0, ID, this);

        _gridRows.Clear();
        for (var i = 0; i < _rowContainers.Count; i++)
        {
            _gridRows.Add(new GridViewRow(DataControlRowType.DataRow, i, _rowContainers[i]) { Fields = _columns });
        }
        _headerRow = ShowHeader ? new GridViewRow(DataControlRowType.Header, -1, null) : null;

        // As in WebForms, DataKeys corresponds to the rows of the current page
        var keyNames = DataKeyNames ?? [];
        var keys = new List<DataKey>();
        if (keyNames.Length > 0)
        {
            foreach (var row in viewRows)
            {
                var values = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
                foreach (var name in keyNames)
                {
                    values[name] = DataBinder.Eval(row, name);
                }
                keys.Add(new DataKey(values));
            }
        }
        DataKeys = new DataKeyCollection(keys);
    }

    private string RowClass(int rowIndex)
        => rowIndex % 2 == 1 && !string.IsNullOrEmpty(AlternatingRowStyleCssClass)
            ? AlternatingRowStyleCssClass
            : RowStyleCssClass;

    private string RowInlineStyle(int rowIndex)
        => rowIndex % 2 == 1 && (AlternatingRowStyleBackColor != null || AlternatingRowStyleForeColor != null || AlternatingRowStyleFontBold)
            ? ComposeRowStyle(AlternatingRowStyleBackColor ?? RowStyleBackColor, AlternatingRowStyleForeColor ?? RowStyleForeColor, AlternatingRowStyleFontBold)
            : ComposeRowStyle(RowStyleBackColor, RowStyleForeColor, RowStyleFontBold);

    private static string ComposeRowStyle(string backColor, string foreColor, bool fontBold)
    {
        var style = string.Empty;
        if (!string.IsNullOrEmpty(backColor))
        {
            style += $"background-color:{backColor};";
        }
        if (!string.IsNullOrEmpty(foreColor))
        {
            style += $"color:{foreColor};";
        }
        if (fontBold)
        {
            style += "font-weight:bold;";
        }
        return style.Length == 0 ? null : style;
    }

    private void HandlePageClick(int newPageIndex)
    {
        var args = new GridViewPageEventArgs(newPageIndex);
        // The canonical pattern: the handler does gv.PageIndex = e.NewPageIndex; BindGrid();
        // PageIndexChangingHandler always runs, so a subclass overriding it is reached.
        var handled = OnPageIndexChanging is not null || PageIndexChanging is not null;
        PageIndexChangingHandler(args);
        if (!handled)
        {
            // Without a handler, page ourselves (WebForms throws here; we are more forgiving)
            PageIndex = args.NewPageIndex;
        }

        Host?.HostCore.NotifyPostBackEvent();
    }

    private void HandleSort(string sortExpression)
    {
        // As in WebForms, clicking the same column again toggles ascending/descending
        _sortDirection = sortExpression == _sortExpression && _sortDirection == SortDirection.Ascending
            ? SortDirection.Descending
            : SortDirection.Ascending;
        _sortExpression = sortExpression;

        var args = new GridViewSortEventArgs(sortExpression, _sortDirection);
        // The canonical pattern: the handler sorts and re-binds. SortingHandler always
        // runs, so a subclass overriding it is reached.
        var handled = OnSorting is not null || Sorting is not null;
        SortingHandler(args);
        if (!handled)
        {
            // Without a handler, sort ourselves via DataBinder.Eval
            var ordered = _allRows.OrderBy(row => DataBinder.Eval(row, sortExpression)).ToList();
            if (_sortDirection == SortDirection.Descending)
            {
                ordered.Reverse();
            }
            _allRows = ordered;
            _pageIndex = 0;
            RefreshView();
            StateHasChanged();
        }

        Host?.HostCore.NotifyPostBackEvent();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        BuildLegacyColumns();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && DataSource is null && !string.IsNullOrEmpty(DataSourceID)
            && Host?.HostCore.FindControl(DataSourceID) is ObjectDataSource dataSourceControl)
        {
            DataSource = dataSourceControl.Select();
            DataBind();
        }
        else if (firstRender && DataSource is null && !string.IsNullOrEmpty(SelectMethod))
        {
            DataSource = ModelBinding.InvokeSelectMethod(Host, SelectMethod);
            DataBind();
        }

        if (_columnsChanged)
        {
            _columnsChanged = false;
            StateHasChanged();
        }

        // The row controls have initialized by now; fire RowDataBound once per DataBind
        if (_pendingRowDataBound)
        {
            _pendingRowDataBound = false;

            // WebForms raised RowCreated during control creation and RowDataBound after
            // binding. Blazor builds the row while rendering, so the two coincide; both
            // fire, RowCreated first, keeping handler order the same as WebForms.
            if (_headerRow is not null)
            {
                RowCreatedHandler(new GridViewRowEventArgs(_headerRow));
                RowDataBoundHandler(new GridViewRowEventArgs(_headerRow));
            }
            foreach (var gridRow in _gridRows)
            {
                RowCreatedHandler(new GridViewRowEventArgs(gridRow));
                RowDataBoundHandler(new GridViewRowEventArgs(gridRow));
            }
        }

        // DataGrid.ItemDataBound: same rows and the same "after this render" timing as
        // RowDataBound above, under the DataGrid-only name ported code still calls it.
        if (_pendingItemDataBound)
        {
            _pendingItemDataBound = false;
            foreach (var gridRow in _gridRows)
            {
                ItemDataBoundHandler(new DataGridItemEventArgs(ToDataGridItem(gridRow)));
            }
        }
    }
}
