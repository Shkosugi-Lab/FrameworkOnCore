<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Validators' scripts as WebResource.axd (no jQuery mapping to register): the scenario layer's client validation. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- A .NET Framework 4.8 application's defaults: rendering, request validation (4.5: per control, ValidateRequestMode). -->
    <httpRuntime targetFramework="4.8" />
    <!-- The same numbers and messages wherever it runs (the server's culture otherwise). -->
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
    <!-- The login controls' (LoginScenario.aspx): forms authentication, the users and roles in memory (ProbeMembership.cs). -->
    <authentication mode="Forms">
      <forms loginUrl="~/LoginScenario.aspx" />
    </authentication>
    <membership defaultProvider="Probe">
      <providers>
        <clear />
        <add name="Probe" type="WebControlsProbe.ProbeMembershipProvider, WebControlsProbe" />
      </providers>
    </membership>
    <!-- The web parts' (WebPartsScenario.aspx): personalization in memory (ProbePersonalization.cs). -->
    <webParts>
      <personalization defaultProvider="Probe">
        <providers>
          <clear />
          <add name="Probe" type="WebControlsProbe.ProbePersonalizationProvider, WebControlsProbe" />
        </providers>
        <authorization>
          <allow users="*" verbs="enterSharedScope" />
        </authorization>
      </personalization>
    </webParts>
    <roleManager enabled="true" defaultProvider="Probe">
      <providers>
        <clear />
        <add name="Probe" type="WebControlsProbe.ProbeRoleProvider, WebControlsProbe" />
      </providers>
    </roleManager>
  </system.web>
  <!-- SqlDataSource's provider of the products in memory (ProbeDb.cs): no database server, the same everywhere. -->
  <system.data>
    <DbProviderFactories>
      <add name="Probe products" invariant="WebControlsProbe.Data" description="The probe site's products in memory" type="WebControlsProbe.ProbeDbFactory, WebControlsProbe" />
    </DbProviderFactories>
  </system.data>
</configuration>
