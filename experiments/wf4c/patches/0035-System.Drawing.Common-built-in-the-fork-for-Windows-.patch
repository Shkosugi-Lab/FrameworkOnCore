diff --git a/src/WebFormsForCore.Drawing.Common/WebFormsForCore.Drawing.Common.csproj b/src/WebFormsForCore.Drawing.Common/WebFormsForCore.Drawing.Common.csproj
new file mode 100644
index 0000000..7554936
--- /dev/null
+++ b/src/WebFormsForCore.Drawing.Common/WebFormsForCore.Drawing.Common.csproj
@@ -0,0 +1,98 @@
+<Project Sdk="Microsoft.NET.Sdk">
+  <!-- System.Drawing.Common with its Linux implementation: dotnet/runtime's release/6.0 source (MIT), the last with
+       it (Mono's, over libgdiplus); Windows' calls GDI+ as .NET Framework's System.Drawing did. Built twice, once per
+       platform, as dotnet/runtime built it: FocTargetOS=windows (the default, also the reference assembly) and
+       FocTargetOS=unix; the package has both (runtimes/win, runtimes/unix), and the host takes the one of the OS.
+       The sources are as they were; what the port changes is under Core\ and marked WebFormsForCore. -->
+  <PropertyGroup>
+    <TargetFramework>net10.0</TargetFramework>
+    <!-- 12: the sources' (C# 10, .NET 6) plus passing ref to .NET 8's in parameters (Marshal.QueryInterface); not 14,
+         which binds some calls differently (first-class spans). -->
+    <LangVersion>12</LangVersion>
+    <Nullable>enable</Nullable>
+    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
+    <ImplicitUsings>disable</ImplicitUsings>
+    <!-- The files are the platform's (System.Drawing.Common.Sources.props), not every .cs of the folder. -->
+    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
+    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
+    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
+    <AssemblyName>System.Drawing.Common</AssemblyName>
+    <RootNamespace>System.Drawing</RootNamespace>
+    <!-- Above Microsoft's 10.0.0.0: what was built against it binds to this one, and a build that has both takes it. -->
+    <AssemblyVersion>10.0.1.0</AssemblyVersion>
+    <FileVersion>10.0.1.0</FileVersion>
+    <Company>Estrellas de Esperanza</Company>
+    <Product>WebFormsForCore.Drawing.Common</Product>
+    <Copyright>Estrellas de Esperanza; .NET Foundation (dotnet/runtime, MIT)</Copyright>
+    <DefineConstants>$(DefineConstants);DRAWING_NAMESPACE;WebFormsForCore</DefineConstants>
+    <!-- The sources' own warnings (obsoletions, platform analyzers, nullability of .NET 6's annotations). -->
+    <NoWarn>$(NoWarn);CS0618;CA1416;CA1422;SYSLIB0003;SYSLIB0011;SYSLIB0051;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8625;CS8765;CS8767;CS8769;CS8768;CS8766;CS8612;CS8613;CS8614;CS8615;CS8616;CS8617;CS8622;CS8624;CS8631;CS8633</NoWarn>
+    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
+    <SignAssembly>True</SignAssembly>
+    <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
+
+    <!-- dotnet/runtime's properties the source items use. -->
+    <CommonPath>$(MSBuildThisFileDirectory)Common\</CommonPath>
+    <TargetsWindows Condition="'$(FocTargetOS)' == 'windows'">true</TargetsWindows>
+    <TargetsUnix Condition="'$(FocTargetOS)' == 'unix'">true</TargetsUnix>
+    <TargetsAnyOS>false</TargetsAnyOS>
+    <DefineConstants Condition="'$(TargetsWindows)' == 'true'">$(DefineConstants);FEATURE_WINDOWS_SYSTEM_COLORS;FEATURE_SYSTEM_EVENTS;TARGET_WINDOWS</DefineConstants>
+    <DefineConstants Condition="'$(TargetsUnix)' == 'true'">$(DefineConstants);TARGET_UNIX</DefineConstants>
+
+    <!-- One output per platform. -->
+    <BaseOutputPath>bin\$(FocTargetOS)\</BaseOutputPath>
+    <IntermediateOutputPath>obj\$(FocTargetOS)\$(Configuration)\</IntermediateOutputPath>
+
+    <PackageId>WebFormsForCore.Drawing.Common</PackageId>
+    <Title>WebFormsForCore.Drawing.Common</Title>
+    <Authors>simonegli8</Authors>
+    <Description>System.Drawing.Common for .NET 10 on Windows (GDI+) and Linux (libgdiplus): dotnet/runtime's release/6.0 source with its Unix implementation enabled</Description>
+    <PackageProjectUrl>https://github.com/webformsforcore/WebFormsForCore</PackageProjectUrl>
+    <PackageReadmeFile>README.md</PackageReadmeFile>
+    <PackageLicenseExpression>MIT</PackageLicenseExpression>
+    <IncludeSymbols>false</IncludeSymbols>
+  </PropertyGroup>
+
+  <ItemGroup>
+    <!-- CLS-compliant, as dotnet/runtime builds its libraries (ColorMatrix(float[][]), ImageCodecInfo's signatures say
+         which members are not). -->
+    <AssemblyAttribute Include="System.CLSCompliantAttribute">
+      <_Parameter1>true</_Parameter1>
+      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
+    </AssemblyAttribute>
+  </ItemGroup>  <Import Project="System.Drawing.Common.Sources.props" />
+
+  <ItemGroup>
+    <!-- dotnet/runtime's build generated the SR class from the strings (generate-drawing-sr.ps1). -->
+    <Compile Include="$(CommonPath)System\SR.cs" Link="Common\System\SR.cs" />
+    <Compile Include="Core\*.cs" />
+    <EmbeddedResource Include="Resources\Strings.resx" LogicalName="System.Drawing.Common.Strings.resources" />
+    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
+  </ItemGroup>
+
+  <ItemGroup>
+    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
+  </ItemGroup>
+
+  <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
+
+  <PropertyGroup>
+    <!-- Microsoft's System.Drawing.Common identity (cc7b13ffcd2ddd51), as WebFormsForCore.Configuration has its. -->
+    <StrongNamePublicKey></StrongNamePublicKey>
+    <StrongNamePublicKeyToken>cc7b13ffcd2ddd51</StrongNamePublicKeyToken>
+  </PropertyGroup>
+
+  <!-- Without DEBUG in every configuration, as the original was shipped (a failed Debug.Assert ends a .NET process). -->
+  <Target Name="FocWithoutDebugConstant" BeforeTargets="CoreCompile">
+    <PropertyGroup>
+      <DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace(';$(DefineConstants);', ';DEBUG;', ';').Trim(';'))</DefineConstants>
+    </PropertyGroup>
+  </Target>
+
+  <!-- The package: the Windows build as the reference and Windows' implementation, the Unix build (built first with
+       -p:FocTargetOS=unix, pack-fork.ps1) as the implementation elsewhere. -->
+  <ItemGroup Condition="'$(FocTargetOS)' == 'windows'">
+    <None Include="bin\windows\$(Configuration)\$(TargetFramework)\System.Drawing.Common.dll" Pack="true" PackagePath="runtimes\win\lib\$(TargetFramework)" Visible="false" />
+    <None Include="bin\unix\$(Configuration)\$(TargetFramework)\System.Drawing.Common.dll" Pack="true" PackagePath="runtimes\unix\lib\$(TargetFramework)" Visible="false" />
+  </ItemGroup>
+</Project>
