From 6660678361cc54b0805d65e12a4f7dc01803064f Mon Sep 17 00:00:00 2001
From: shkosugi <sin.kosugi@gmail.com>
Date: Sun, 27 Sep 2026 14:43:16 +0900
Subject: [PATCH 17/20] Response buffers: only the pool's are returned to it

HttpResponseBufferElement returned its buffer to ArrayPool.Shared in Recycle whatever
it held: a buffer it was given (Clone, a caller's data) is not the pool's, and
ArrayPool throws ("The buffer is not associated with this pool"). Response.Flush in
the middle of a page recycles them: DNN's Install.aspx, which writes its progress as
it goes, failed at its first line. Only a rented buffer is returned, once.
---
 src/WebFormsForCore.Web/HttpWriter.cs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/WebFormsForCore.Web/HttpWriter.cs b/src/WebFormsForCore.Web/HttpWriter.cs
index 1531337..ff5a6a1 100644
--- a/src/WebFormsForCore.Web/HttpWriter.cs
+++ b/src/WebFormsForCore.Web/HttpWriter.cs
@@ -91,10 +91,15 @@ namespace System.Web {
         const int BufferSize = BufferingParams.OUTPUT_BUFFER_SIZE;
         private ArrayPool<byte> Pool = ArrayPool<byte>.Shared;
         private byte[] _data;
+        // Rented from the pool (the default constructor): returned once, in Recycle. A buffer the element
+        // was given (Clone, a caller's data) is not the pool's: returning it throws ("The buffer is not
+        // associated with this pool"), as Response.Flush in the middle of a page did (DNN's Install.aspx).
+        private bool _rented;
 
         internal HttpResponseBufferElement()
         {
             _data = Pool.Rent(BufferSize);
+            _rented = true;
             _size = _data.Length;
             _free = _size;
             _recycle = false;
@@ -123,7 +128,8 @@ namespace System.Web {
         }
 
         internal override void Recycle() {
-            Pool.Return(_data);
+            if (_rented && _data != null) Pool.Return(_data);
+            _rented = false;
             _data = null;
             _free = 0;
         }
