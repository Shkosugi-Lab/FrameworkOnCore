{
  "_comment": "The RegularExpressionValidator's scenario layer (ValidatorsScenario.aspx; tests/WebControlsParity/README.md). A snapshot's tags are the mechanisms it covers. The log's request number is kept in view state: a postback the browser's validation held back leaves it as it was.",
  "ignorePatterns": [],
  "steps": [
    {
      "action": "goto",
      "path": "/ValidatorsScenario.aspx"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [render][databind][dynamic] first request"
    },
    {
      "action": "click",
      "target": "btnServer"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [servervalidate] empty: passes"
    },
    {
      "action": "fill",
      "target": "txtCode",
      "value": "abc"
    },
    {
      "action": "fill",
      "target": "txtDynamicTarget",
      "value": "abc"
    },
    {
      "action": "click",
      "target": "btnServer"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [servervalidate][dynamic] not digits"
    },
    {
      "action": "fill",
      "target": "txtCode",
      "value": "123"
    },
    {
      "action": "click",
      "target": "btnServer"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [servervalidate] digits"
    },
    {
      "action": "fill",
      "target": "txtCode",
      "value": "x1"
    },
    {
      "action": "click",
      "target": "btnManual"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [servervalidate] Validate() of the one validator"
    },
    {
      "action": "fill",
      "target": "txtCodeC",
      "value": "abc"
    },
    {
      "action": "click",
      "target": "btnRexC"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [clientvalidate] not digits in the browser: no request"
    },
    {
      "action": "fill",
      "target": "txtCodeC",
      "value": "123"
    },
    {
      "action": "click",
      "target": "btnRexC"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [clientvalidate] digits in the browser: posted"
    },
    {
      "action": "click",
      "target": "btnShow"
    },
    {
      "action": "click",
      "target": "btnServer"
    },
    {
      "action": "snapshot",
      "name": "RegularExpressionValidator [visible][servervalidate] the hidden validator shown, then validating"
    }
  ]
}
