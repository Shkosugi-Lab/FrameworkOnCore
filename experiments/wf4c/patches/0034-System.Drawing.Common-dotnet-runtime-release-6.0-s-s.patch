+            set { print_tofile = value; }
+        }
+
+        public bool SupportsColor
+        {
+            get { return supports_color; }
+        }
+
+        public int ToPage
+        {
+            get { return to_page; }
+            set
+            {
+                if (value < 0)
+                    throw new ArgumentException(SR.Format(SR.ValueLessThenZero, nameof(ToPage)));
+
+                to_page = value;
+            }
+        }
+
+        internal NameValueCollection PrinterCapabilities
+        {
