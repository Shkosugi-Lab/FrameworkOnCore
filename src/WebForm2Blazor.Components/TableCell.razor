@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@if (Visible)
{
    <td @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
        colspan="@(ColumnSpan > 0 ? ColumnSpan : (int?)null)"
        rowspan="@(RowSpan > 0 ? RowSpan : (int?)null)">@if (ChildContent is not null) { @ChildContent } else { @Text }</td>
}

@code {
    private string _text;

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public int ColumnSpan { get; set; }
    [Parameter] public int RowSpan { get; set; }

    /// <summary>WebForms TableCell.Text equivalent (settable from code-behind).</summary>
    [Parameter]
    public string Text
    {
        get => _text;
        set => SetAndRefresh(ref _text, value);
    }
}
