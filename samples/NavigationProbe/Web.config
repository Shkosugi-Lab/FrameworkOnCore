<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Off at the root: the error pages of the folders under E/ have their own (E/*/Web.config). -->
    <customErrors mode="Off" />
    <!-- Keys of its own: the forms ticket and the view state the same on every run. -->
    <machineKey validationKey="7721442E6D0DE48DD04DA275DB30837B9D6F23CA5DAE506C34BDFC3B66A9D5DDEC9504D8F458204EB45BE6C72C80C10F9F471DA610058940CB2A050E09E5E457"
                decryptionKey="F66A770C88EC1CF7315DA127EB65DA78EE8FDF8F71EA93685655F6D3DC74F2BE" validation="HMACSHA256" decryption="AES" />
    <authentication mode="Forms">
      <forms name=".NAVAUTH" loginUrl="~/F/Login.aspx" defaultUrl="~/F/Welcome.aspx" timeout="30" slidingExpiration="true" cookieless="UseCookies">
        <credentials passwordFormat="Clear">
          <user name="user" password="pass1" />
          <user name="admin" password="pass2" />
        </credentials>
      </forms>
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
      <controls>
        <add tagPrefix="nav" namespace="NavigationProbe" assembly="NavigationProbe" />
      </controls>
    </pages>
    <siteMap defaultProvider="NavSiteMap" enabled="true">
      <providers>
        <clear />
        <add name="NavSiteMap" type="System.Web.XmlSiteMapProvider" siteMapFile="~/Web.sitemap" securityTrimmingEnabled="true" />
      </providers>
    </siteMap>
  </system.web>
  <system.webServer>
    <modules>
      <add name="NavigationModule" type="NavigationProbe.NavigationModule" />
    </modules>
    <handlers>
      <add name="RedirectHandler" path="Y/Redirect.ashx" verb="*" type="NavigationProbe.RedirectHandler" preCondition="integratedMode" />
    </handlers>
  </system.webServer>
  <!-- Signed-in users only, one page of it for everyone; the Admin role only. -->
  <location path="F/Secure">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="F/Secure/Public.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="F/Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- The view state cut into fields of 64 characters (__VIEWSTATEFIELDCOUNT). -->
  <location path="P/Chunk">
    <system.web>
      <pages maxPageStateFieldLength="64" />
    </system.web>
  </location>
</configuration>
