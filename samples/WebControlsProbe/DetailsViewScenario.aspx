<%@ Page Language="C#" AutoEventWireup="false" CodeBehind="DetailsViewScenario.aspx.cs" Inherits="WebControlsProbe.DetailsViewScenario" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>DetailsView scenario</title>
</head>
<body>
    <form id="form1" runat="server">
        <h3>Manual (DataSource, handlers)</h3>
        <asp:DetailsView ID="dvManual" runat="server" AutoGenerateRows="false" AllowPaging="true" DataKeyNames="Code" OnPageIndexChanging="ManualPaging"
            OnModeChanging="ManualModeChanging" OnItemUpdating="ManualUpdating" OnItemInserting="ManualInserting" OnItemDeleting="ManualDeleting" OnItemCommand="ItemCommand">
            <Fields>
                <asp:TemplateField HeaderText="Code">
                    <ItemTemplate><%# Eval("Code") %></ItemTemplate>
                    <EditItemTemplate><%# Eval("Code") %></EditItemTemplate>
                    <InsertItemTemplate><asp:TextBox ID="txtDvNewCode" runat="server" Text='<%# Bind("Code") %>' /></InsertItemTemplate>
                </asp:TemplateField>
                <asp:TemplateField HeaderText="Name">
                    <ItemTemplate><%# Eval("Name") %></ItemTemplate>
                    <EditItemTemplate><asp:TextBox ID="txtDvName" runat="server" Text='<%# Bind("Name") %>' /></EditItemTemplate>
                    <InsertItemTemplate><asp:TextBox ID="txtDvNewName" runat="server" Text='<%# Bind("Name") %>' /></InsertItemTemplate>
                </asp:TemplateField>
                <asp:BoundField DataField="Price" HeaderText="Price" />
                <asp:CheckBoxField DataField="Active" HeaderText="Active" ReadOnly="true" />
                <asp:ButtonField CommandName="like" Text="Like" />
                <asp:CommandField ShowEditButton="true" ShowInsertButton="true" ShowDeleteButton="true" />
            </Fields>
        </asp:DetailsView>

        <h3>Automatic (ObjectDataSource)</h3>
        <asp:ObjectDataSource ID="odsAuto" runat="server" TypeName="WebControlsProbe.ProductStore" SelectMethod="SelectAll" UpdateMethod="Update" InsertMethod="Insert" DeleteMethod="Delete" OnUpdating="OdsUpdating" OnInserting="OdsInserting" />
        <asp:DetailsView ID="dvAuto" runat="server" DataSourceID="odsAuto" AutoGenerateRows="false" AllowPaging="true" DataKeyNames="Code"
            AutoGenerateEditButton="true" AutoGenerateInsertButton="true" AutoGenerateDeleteButton="true" OnItemUpdated="AutoUpdated" OnItemInserted="AutoInserted" OnItemDeleted="AutoDeleted">
            <Fields>
                <asp:BoundField DataField="Code" HeaderText="Code" ReadOnly="true" InsertVisible="true" />
                <asp:BoundField DataField="Name" HeaderText="Name" />
                <asp:BoundField DataField="Price" HeaderText="Price" />
            </Fields>
        </asp:DetailsView>

        <h3>Paging by callbacks</h3>
        <asp:DetailsView ID="dvCallback" runat="server" DataSourceID="odsAuto" AllowPaging="true" EnablePagingCallbacks="true" AutoGenerateRows="false">
            <Fields><asp:BoundField DataField="Name" HeaderText="Name" /></Fields>
        </asp:DetailsView>

        <h3>Empty, without view state, hidden, dynamic</h3>
        <asp:DetailsView ID="dvEmpty" runat="server" EmptyDataText="Nothing to show" />
        <asp:DetailsView ID="dvNoViewState" runat="server" EnableViewState="false" />
        <asp:DetailsView ID="dvHidden" runat="server" Visible="false" />
        <asp:PlaceHolder ID="Dynamic" runat="server" />

        <p>
            <asp:Button ID="btnSubmit" runat="server" Text="Submit" />
            <asp:Button ID="btnShow" runat="server" Text="Show hidden" OnClick="ShowHidden" />
        </p>
        <pre id="log"><asp:Literal ID="Log" runat="server" EnableViewState="false" /></pre>
    </form>
</body>
</html>
