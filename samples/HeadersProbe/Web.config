<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="en-US" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <!-- IIS's error answers as a remote client gets them (errorMode Custom: the same from this machine; the local client's
         detailed pages are not the host's) -->
    <httpErrors errorMode="Custom" />
    <!-- IIS's response headers: every response's (customHeaders, over the server's X-Powered-By), the redirects' -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Root" value="root" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
      <redirectHeaders>
        <add name="X-Redirect" value="moved" />
      </redirectHeaders>
    </httpProtocol>
    <!-- URL Rewrite and HTTP redirection together: which runs first (a rewrite of a redirected folder's URL, a rewrite to
         a redirected folder) -->
    <rewrite>
      <rules>
        <rule name="in-old" stopProcessing="true">
          <match url="^old/rw$" />
          <action type="Rewrite" url="Show.aspx?rw=1" />
        </rule>
        <rule name="to-old" stopProcessing="true">
          <match url="^tonew$" />
          <action type="Rewrite" url="old/o.htm" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <!-- a location's headers: one removed, one added -->
  <location path="loc">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Root" />
          <add name="X-Loc" value="loc" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <!-- IIS's HTTP redirection: a folder to another (the rest of the URL kept), exactly to a URL ($S, $Q), its sub-folders
       only, the statuses, wildcards, another server, a folder that turns it off, a single file -->
  <location path="old">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new" />
    </system.webServer>
  </location>
  <location path="old/keep">
    <system.webServer>
      <httpRedirect enabled="false" />
    </system.webServer>
  </location>
  <location path="exact">
    <system.webServer>
      <httpRedirect enabled="true" destination="/Show.aspx?from=$S&amp;q=$Q" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="child">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new/" childOnly="true" httpResponseStatus="Temporary" />
    </system.webServer>
  </location>
  <location path="wild">
    <system.webServer>
      <httpRedirect enabled="true" exactDestination="true" httpResponseStatus="Found">
        <add wildcard="*.php" destination="/Show.aspx?php=$V" />
        <add wildcard="/wild/a/*" destination="/Show.aspx?a=$0" />
      </httpRedirect>
    </system.webServer>
  </location>
  <location path="ext">
    <system.webServer>
      <httpRedirect enabled="true" destination="http://example.com/base" />
    </system.webServer>
  </location>
  <location path="Moved.aspx">
    <system.webServer>
      <httpRedirect enabled="true" destination="/Show.aspx" />
    </system.webServer>
  </location>
  <!-- what the documentation tells and the first cases did not show: the wildcards' $0-$9 and what they are matched
       against (a file's name, the folder's rest, the whole path), the folder the rest is taken from when a sub-folder
       sets only some attributes, $P, $V without exactDestination, 308, a destination without its '/' -->
  <location path="wild2">
    <system.webServer>
      <httpRedirect enabled="true" exactDestination="true">
        <add wildcard="/wild2/full/*" destination="/Show.aspx?full=$0" />
        <add wildcard="*_in.asp" destination="/Show.aspx?in=$0&amp;q=$Q" />
        <add wildcard="*/*.aspx" destination="/Show.aspx?a=$0&amp;b=$1" />
        <add wildcard="*.htm" destination="/Show.aspx?w0=$0" />
      </httpRedirect>
    </system.webServer>
  </location>
  <location path="base">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new" />
    </system.webServer>
  </location>
  <location path="base/deep">
    <system.webServer>
      <httpRedirect httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="pq">
    <system.webServer>
      <httpRedirect enabled="true" destination="/Show.aspx?x=1&amp;$P" exactDestination="true" />
    </system.webServer>
  </location>
  <location path="vnon">
    <system.webServer>
      <httpRedirect enabled="true" destination="http://example.com$V" />
    </system.webServer>
  </location>
  <location path="perm8">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new" httpResponseStatus="PermRedirect" />
    </system.webServer>
  </location>
  <location path="rel">
    <system.webServer>
      <httpRedirect enabled="true" destination="new" />
    </system.webServer>
  </location>
  <!-- a folder's own request limits (an upload folder's are larger, this one's smaller) -->
  <location path="upload">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="100" maxQueryString="10" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
