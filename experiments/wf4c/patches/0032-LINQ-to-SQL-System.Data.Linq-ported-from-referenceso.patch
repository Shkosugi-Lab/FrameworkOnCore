+                    foreach (MetaDataMember mm in this.type.PersistentDataMembers) {
+                        if (mm.IsAssociation && mm.Association.ThisKey.Contains(key)) {
+                            yield return mm;
+                        }
+                    }
+                }
+
+                internal override object CreateDataCopy(object instance) {
