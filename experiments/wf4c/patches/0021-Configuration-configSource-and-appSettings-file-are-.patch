From 59897992fca8e5f352ff1fa4072bd7a7c296edda Mon Sep 17 00:00:00 2001
From: shkosugi <sin.kosugi@gmail.com>
Date: Sun, 27 Sep 2026 17:03:22 +0900
Subject: [PATCH] Configuration: configSource and appSettings file are Windows
 relative paths

A path relative to a configuration file as .NET Framework reads it (configSource,
appSettings file) separates its directories with '\': configSource may not even
contain '/' (Config_source_invalid_chars). On Linux '\' is a character of a file's
name, and N2's web.config (configSource="App_Data\n2_host.config") could not be
read. '\' is made the directory separator there.
---
 .../System/System.Configuration/AppSettingsSection.cs    | 4 ++--
 .../System.Configuration/Internal/InternalConfigHost.cs  | 9 ++++++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/WebFormsForCore.Configuration/System/System.Configuration/AppSettingsSection.cs b/src/WebFormsForCore.Configuration/System/System.Configuration/AppSettingsSection.cs
index 1757038..07831d3 100644
--- a/src/WebFormsForCore.Configuration/System/System.Configuration/AppSettingsSection.cs
+++ b/src/WebFormsForCore.Configuration/System/System.Configuration/AppSettingsSection.cs
@@ -113,11 +113,11 @@ namespace System.Configuration {
                 configFile = ElementInformation.Source;
 
                 if (String.IsNullOrEmpty(configFile)) {
-                    sourceFileFullPath = File;
+                    sourceFileFullPath = Internal.InternalConfigHost.FrameworkRelativePath(File);
                 }
                 else {
                     configFileDirectory = System.IO.Path.GetDirectoryName(configFile);
-                    sourceFileFullPath = System.IO.Path.Combine(configFileDirectory, File);
+                    sourceFileFullPath = System.IO.Path.Combine(configFileDirectory, Internal.InternalConfigHost.FrameworkRelativePath(File));
                 }
 
                 if (System.IO.File.Exists(sourceFileFullPath)) {
diff --git a/src/WebFormsForCore.Configuration/System/System.Configuration/Internal/InternalConfigHost.cs b/src/WebFormsForCore.Configuration/System/System.Configuration/Internal/InternalConfigHost.cs
index c25e0c8..717eccf 100644
--- a/src/WebFormsForCore.Configuration/System/System.Configuration/Internal/InternalConfigHost.cs
+++ b/src/WebFormsForCore.Configuration/System/System.Configuration/Internal/InternalConfigHost.cs
@@ -68,6 +68,13 @@ namespace System.Configuration.Internal {
 
         [FileIOPermission(SecurityAction.Assert, AllFiles = FileIOPermissionAccess.PathDiscovery)]
         [SuppressMessage("Microsoft.Security", "CA2106:SecureAsserts", Justification = "The callers don't leak this information.")]
+        // A path relative to a configuration file, as .NET Framework reads it (configSource,
+        // appSettings file): '\' separates its directories - configSource may not even contain '/'
+        // (Config_source_invalid_chars). On Linux '\' is a character of a file's name: it is made the
+        // directory separator (N2's configSource="App_Data\n2_host.config").
+        static internal string FrameworkRelativePath(string path) =>
+            path == null || Path.DirectorySeparatorChar == '\\' ? path : path.Replace('\\', Path.DirectorySeparatorChar);
+
         static internal string StaticGetStreamNameForConfigSource(string streamName, string configSource) {
             //
             // Note (Microsoft 7/08/05):
@@ -92,7 +99,7 @@ namespace System.Configuration.Internal {
             string dirStream = UrlPath.GetDirectoryOrRootName(streamName);
 
             // combine with the new config source
-            string result = Path.Combine(dirStream, configSource);
+            string result = Path.Combine(dirStream, FrameworkRelativePath(configSource));
             result = Path.GetFullPath(result);
 
             // ensure the result is in or under the directory of the original source
-- 
