@namespace WebForm2Blazor.Components
@inherits WebFormsControlBase

@* WebForms PasswordRecovery equivalent.

   Same bargain as Login and ChangePassword: the application's own templates render when
   there are any, the default form otherwise, so the page shows a form rather than nothing.

   It does NOT recover a password. Membership is gone, and inventing a reset would be
   worse than doing nothing - VerifyingUser / SendingMail / UserLookupError are raised so
   an application that owns its user store can do the work it always did. *@
@if (Visible)
{
    <div @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass">
        @if (_sent)
        {
            @if (SuccessTemplate is not null)
            {
                @SuccessTemplate
            }
            else
            {
                <span class="passwordrecovery-success">@SuccessText</span>
            }
        }
        else if (UserNameTemplate is not null)
        {
            @UserNameTemplate
        }
        else
        {
            <div class="passwordrecovery-username">
                <label for="@(ClientID)_UserName">@UserNameLabelText</label>
                <input id="@(ClientID)_UserName" type="text" value="@UserName"
                       @onchange="e => UserName = e.Value?.ToString()" />
            </div>
            <button type="button" @onclick="Submit">@SubmitButtonText</button>
            @if (!string.IsNullOrEmpty(_failure))
            {
                <span class="passwordrecovery-failure">@_failure</span>
            }
        }
    </div>
}

@code {
    private string _failure;
    private bool _sent;

    [Parameter] public RenderFragment UserNameTemplate { get; set; }
    [Parameter] public RenderFragment QuestionTemplate { get; set; }
    [Parameter] public RenderFragment SuccessTemplate { get; set; }

    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string MembershipProvider { get; set; } = string.Empty;
    [Parameter] public string SuccessPageUrl { get; set; } = string.Empty;

    [Parameter] public string UserNameLabelText { get; set; } = "User Name:";
    [Parameter] public string SubmitButtonText { get; set; } = "Submit";
    [Parameter] public string SuccessText { get; set; } = "Your password has been sent to you.";
    [Parameter] public string UserNameFailureText { get; set; }
        = "We were unable to access your information. Please try again.";

    // --- The rest of the WebForms PasswordRecovery declaration surface, on the same terms
    //     as ChangePassword: carried for the adapter that renders, with 4.8's defaults. ---
    [Parameter] public string GeneralFailureText { get; set; }
        = "Your attempt to retrieve your password was not successful. Please try again.";
    [Parameter] public string QuestionFailureText { get; set; }
        = "Your answer could not be verified. Please try again.";
    [Parameter] public string QuestionLabelText { get; set; } = "Question:";
    [Parameter] public string AnswerLabelText { get; set; } = "Answer:";
    [Parameter] public string QuestionTitleText { get; set; } = "Identity Confirmation";
    [Parameter] public string UserNameTitleText { get; set; } = "Forgot Your Password?";
    [Parameter] public string SuccessTitleText { get; set; } = "Password Sent";
    [Parameter] public string UserNameInstructionText { get; set; }
        = "Enter your User Name to receive your password.";
    [Parameter] public string QuestionInstructionText { get; set; }
        = "Answer the following question to receive your password.";
    [Parameter] public string UserNameRequiredErrorMessage { get; set; } = "User Name is required.";
    [Parameter] public string AnswerRequiredErrorMessage { get; set; } = "Answer is required.";
    [Parameter] public string HelpPageText { get; set; } = string.Empty;
    [Parameter] public string HelpPageUrl { get; set; } = string.Empty;
    [Parameter] public string HelpPageIconUrl { get; set; } = string.Empty;
    [Parameter] public ButtonType SubmitButtonType { get; set; } = ButtonType.Button;
    [Parameter] public string SubmitButtonImageUrl { get; set; } = string.Empty;

    /// <summary>
    /// WebForms PasswordRecovery.MailDefinition equivalent.
    ///
    /// Carried and never used to send: membership is gone, so nothing here composes or
    /// posts the mail. The settings are what an application reads back when it sends the
    /// message itself from a SendingMail handler, which is the path that still works.
    /// </summary>
    public MailDefinition MailDefinition { get; } = new();

    [Parameter] public EventHandler<LoginCancelEventArgs> OnVerifyingUser { get; set; }
    [Parameter] public EventHandler OnUserLookupError { get; set; }
    [Parameter] public EventHandler OnSendingMail { get; set; }
    [Parameter] public EventHandler OnSendMailError { get; set; }

    public event EventHandler<LoginCancelEventArgs> VerifyingUser
    {
        add => OnVerifyingUser += value;
        remove => OnVerifyingUser -= value;
    }

    public event EventHandler UserLookupError
    {
        add => OnUserLookupError += value;
        remove => OnUserLookupError -= value;
    }

    public event EventHandler SendingMail
    {
        add => OnSendingMail += value;
        remove => OnSendingMail -= value;
    }

    public event EventHandler SendMailError
    {
        add => OnSendMailError += value;
        remove => OnSendMailError -= value;
    }

    /// <summary>
    /// WebForms order: VerifyingUser (cancellable), then SendingMail, or UserLookupError.
    /// With no SendingMail handler the attempt fails - there is no membership provider to
    /// ask, and telling the visitor a mail is on its way would be a lie.
    /// </summary>
    private void Submit()
    {
        _failure = null;

        var args = new LoginCancelEventArgs();
        OnVerifyingUser?.Invoke(this, args);

        if (args.Cancel || OnSendingMail is null)
        {
            _failure = UserNameFailureText;
            OnUserLookupError?.Invoke(this, EventArgs.Empty);
        }
        else
        {
            _sent = true;
            OnSendingMail.Invoke(this, EventArgs.Empty);
        }

        Host?.HostCore.NotifyPostBackEvent();
    }
}
