<?xml version="1.0" encoding="shift_jis"?>
<!-- Shift_JIS で保存した web.config(宣言は shift_jis)。日本語の設定値を読む。 -->
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="SiteTitle" value="ソフト開発の表示能力テスト" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- fileEncoding なし: ページは ANSI コードページ(日本語の Windows では Shift_JIS)で読まれる。 -->
    <globalization requestEncoding="shift_jis" responseEncoding="shift_jis" />
    <customErrors mode="Off" />
  </system.web>
</configuration>
