+            char[] data = str.ToCharArray();
+            Marshal.Copy(data, 0, address, data.Length);
+            Marshal.WriteInt16((IntPtr)(checked((long)address + data.Length * 2)), 0);
+
+            return checked((short)(str.Length + 1));
+        }
