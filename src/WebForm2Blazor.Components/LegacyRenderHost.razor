@namespace WebForm2Blazor.Components
@implements IWebFormsControl

@* Runs a ported legacy custom control (Render(HtmlTextWriter) style) unchanged and
   injects its buffered markup. Controls with markup children render as
   "legacy begin tag + Blazor child content + legacy end tag" (the WebControl
   protocol split). Display-only: postback events inside the legacy control do not
   work here - interactive controls need a hand-ported component via --control-map. *@
@* Visible=false renders nothing, as WebForms does. The begin tag, children and end tag
   stay glued together exactly as before so no whitespace is introduced between them. *@
@* HeaderContent / FooterContent are the control's <HeaderTemplate> / <FooterTemplate>.
   WebForms renders those inside the control, around what it produces, and they carry no
   data-bound expressions - which is exactly why they can be static Razor content here
   while a data-bound <ItemTemplate> cannot. *@
@if (Visible)
{
@if (HeaderContent is not null && !_headerTemplateTaken)
{
    @HeaderContent
}
@((MarkupString)(_beginHtml ?? string.Empty))@if (ChildContent is not null)
{
    @ChildContent
}
@((MarkupString)(_endHtml ?? string.Empty))@if (FooterContent is not null && !_footerTemplateTaken)
{
    @FooterContent
}
}

@code {
    private string _beginHtml;
    private string _endHtml;

    [Parameter] public string ID { get; set; }

    // The rest of the IWebFormsControl surface. This host stands in for a WebForms
    // control, so ported code that walks a control tree can read and set these.
    public string ClientID => ID;

    [Parameter] public bool Visible { get; set; } = true;

    [Parameter] public bool Enabled { get; set; } = true;

    [Parameter] public string CssClass { get; set; }

    public AttributeCollection Attributes { get; } = new(() => { });

    /// <summary>Programmatically added children. The legacy control renders its own; these do not.</summary>
    public ControlCollection Controls { get; } = [];

    /// <summary>The hosting page, or null outside one.</summary>
    public Page Page => Host as Page;

    /// <summary>Full type name of the ported legacy control class.</summary>
    [Parameter] public string TypeName { get; set; }

    /// <summary>Markup attribute values, applied to same-named properties with type conversion.</summary>
    [Parameter] public Dictionary<string, object> PropertyValues { get; set; }

    /// <summary>Markup children, rendered by Blazor between the legacy begin/end tags.</summary>
    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>The control's &lt;HeaderTemplate&gt;, rendered before its own output.</summary>
    [Parameter] public RenderFragment HeaderContent { get; set; }

    /// <summary>The control's &lt;FooterTemplate&gt;, rendered after its own output.</summary>
    [Parameter] public RenderFragment FooterContent { get; set; }

    /// <summary>
    /// Template name -> its static markup, for controls that declare ITemplate properties.
    /// The control decides where each goes, which is the only way a &lt;SeparatorTemplate&gt;
    /// can land between the items.
    /// </summary>
    [Parameter] public Dictionary<string, string> TemplateMarkup { get; set; }

    /// <summary>
    /// Entries of the control's collection elements (&lt;Items&gt;, &lt;Columns&gt;), built and added
    /// to the matching property the way the WebForms parser did.
    /// </summary>
    [Parameter] public LegacyChild[] CollectionChildren { get; set; }

    // Set when the legacy control accepted the template through its own ITemplate
    // property, so the fragment fallback does not render the same markup a second time.
    private bool _headerTemplateTaken;
    private bool _footerTemplateTaken;

    [CascadingParameter] protected IWebFormsHost Host { get; set; }

    /// <summary>The instantiated legacy control (code-behind can inspect it via FindControl).</summary>
    public object ControlInstance { get; private set; }

    protected override void OnInitialized() => Host?.HostCore.RegisterControl(this);

    [Inject] private NavigationManager Navigation { get; set; }

    /// <summary>What the last lifecycle run was for (see OnParametersSet).</summary>
    private string _lifecycleKey;

    protected override void OnParametersSet()
    {
        // ONE lifecycle per WebForms request, not one per Blazor render.
        //
        // Every re-render of the parent hands this host its parameters again - the
        // property dictionary is a new instance each time, so they always look changed -
        // and each time the control was created anew and taken through Init, Load and
        // PreRender. A WebForms control runs that once per request. BlogEngine's
        // WidgetZone renders every widget in OnLoad, and the BlogRoll widget fetches its
        // feeds over the network: one home page view ran it seven times, holding the
        // renderer for ~20 seconds before the page's own Load and PreRenderComplete (the
        // post list, the document title) were reached.
        //
        // So it runs again only for what WOULD be a new request: different markup inputs,
        // a different URL (navigation - the layout survives it here, the master page did
        // not there), or a postback since the last run.
        var key = LifecycleKey();
        if (key == _lifecycleKey)
        {
            return;
        }
        _lifecycleKey = key;

        try
        {
            RenderLegacyControl();
        }
        catch (Exception exception)
        {
            var message = System.Net.WebUtility.HtmlEncode(
                (exception.InnerException ?? exception).Message);
            _beginHtml = $"<span class=\"w2b-legacyrender-error\" title=\"{message}\">[{TypeName}: render error]</span>";
            _endHtml = null;
        }
    }

    /// <summary>The inputs a lifecycle run depends on, by value.</summary>
    private string LifecycleKey()
    {
        var key = new System.Text.StringBuilder();
        key.Append(TypeName).Append('\u0001').Append(ID).Append('\u0001').Append(CssClass)
            .Append('\u0001').Append(Enabled).Append('\u0001').Append(ChildContent is null)
            .Append('\u0001').Append(Navigation?.Uri)
            .Append('\u0001').Append(WebFormsHostCore.PostBackGeneration);
        foreach (var pair in PropertyValues ?? [])
        {
            key.Append('\u0002').Append(pair.Key).Append('=').Append(Convert.ToString(pair.Value, System.Globalization.CultureInfo.InvariantCulture));
        }
        foreach (var pair in TemplateMarkup ?? [])
        {
            key.Append('\u0003').Append(pair.Key).Append('=').Append(pair.Value);
        }
        foreach (var child in CollectionChildren ?? [])
        {
            key.Append('\u0004').Append(child.Collection).Append(':').Append(child.TypeName);
            foreach (var pair in child.Properties ?? [])
            {
                key.Append('\u0005').Append(pair.Key).Append('=').Append(pair.Value);
            }
        }
        return key.ToString();
    }

    private void RenderLegacyControl()
    {
        var type = ResolveType(TypeName)
            ?? throw new InvalidOperationException($"型 '{TypeName}' が見つかりません。");
        var instance = Activator.CreateInstance(type);
        ControlInstance = instance;

        // Before any property is set and long before the lifecycle runs: a ported control
        // reads Page in OnLoad / OnPreRender / Render as a matter of course.
        if (instance is LegacyWebControl hosted)
        {
            hosted.Page = Page;
        }

        SetProperty(type, instance, "ID", ID);
        foreach (var pair in PropertyValues ?? [])
        {
            SetProperty(type, instance, pair.Key, pair.Value?.ToString());
        }

        foreach (var group in (CollectionChildren ?? [])
            .GroupBy(child => child.Collection, StringComparer.OrdinalIgnoreCase))
        {
            var property = type.GetProperty(group.Key,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance
                | System.Reflection.BindingFlags.IgnoreCase);

            // The collection is usually created by the control's constructor and exposed
            // with a private setter (DNN's "public List<DnnFormItemBase> Items { get;
            // private set; }"), so it is READ and added to rather than replaced.
            if (property?.GetValue(instance) is not System.Collections.IList list)
            {
                continue;
            }

            foreach (var child in group)
            {
                if (ResolveType(child.TypeName) is not { } childType)
                {
                    continue;
                }

                var entry = Activator.CreateInstance(childType);
                foreach (var pair in child.Properties ?? [])
                {
                    SetProperty(childType, entry, pair.Key, pair.Value);
                }
                list.Add(entry);
            }
        }

        _headerTemplateTaken = false;
        _footerTemplateTaken = false;
        foreach (var pair in TemplateMarkup ?? [])
        {
            var property = type.GetProperty(pair.Key,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance
                | System.Reflection.BindingFlags.IgnoreCase);
            if (property is null || !property.CanWrite || !typeof(ITemplate).IsAssignableFrom(property.PropertyType))
            {
                // The control has no such template. Header and footer still have a
                // meaningful "before"/"after" position, and the fragment fallback renders
                // them; anything else (a separator) has nowhere to go without the control.
                continue;
            }

            property.SetValue(instance, new StaticMarkupTemplate(pair.Value));
            if (pair.Key.Equals("HeaderTemplate", StringComparison.OrdinalIgnoreCase))
            {
                _headerTemplateTaken = true;
            }
            else if (pair.Key.Equals("FooterTemplate", StringComparison.OrdinalIgnoreCase))
            {
                _footerTemplateTaken = true;
            }
        }

        using var buffer = new StringWriter();
        var writer = new HtmlTextWriter(buffer);

        if (ChildContent is not null && instance is LegacyWebControl wrapper)
        {
            // WebForms order: Init -> Load -> PreRender before rendering
            wrapper.RunLifecycle();

            // Same writer across both halves keeps the tag stack intact
            wrapper.RenderBeginTag(writer);
            _beginHtml = buffer.ToString();
            buffer.GetStringBuilder().Clear();
            wrapper.RenderEndTag(writer);
            _endHtml = buffer.ToString();
            return;
        }

        if (instance is LegacyWebControl legacyControl)
        {
            legacyControl.RunLifecycle();
            legacyControl.RenderControl(writer);
        }
        else
        {
            var render = type.GetMethod("RenderControl", [typeof(HtmlTextWriter)])
                ?? throw new InvalidOperationException($"'{TypeName}' に RenderControl(HtmlTextWriter) がありません。");
            render.Invoke(instance, [writer]);
        }
        _beginHtml = buffer.ToString();
        _endHtml = null;
    }

    // "Find the type, apply the markup attributes" lives in LegacyActivator, which the
    // grid's legacy columns use as well. Two copies of a rule is how this codebase has
    // repeatedly gone wrong - two hand-written lists of renderable base classes disagreed
    // and cost 69 unmapped controls - so there is one, and this delegates to it.
    private static void SetProperty(Type type, object instance, string name, string value)
        => LegacyActivator.SetProperty(type, instance, name, value);

    private static Type ResolveType(string typeName) => LegacyActivator.ResolveType(typeName);
}
