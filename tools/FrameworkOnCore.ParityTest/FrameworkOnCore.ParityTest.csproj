<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FrameworkOnCore.ParityTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <!-- The sql and totp steps: the database the application uses, read and set up directly (state checks, preconditions). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- SqlClient's own dependency is a vulnerable 9.0 (NU1902/NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
