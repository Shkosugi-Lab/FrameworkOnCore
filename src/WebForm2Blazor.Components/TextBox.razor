@namespace WebForm2Blazor.Components
@* A WebControl, as in System.Web, so a ported TextBox subclass (LegacyTextBox and what
   derives from it) is a TextBox wherever one is expected. *@
@inherits WebControl
@implements IValueControl

@if (Visible)
{
    @if (TextMode == TextBoxMode.MultiLine)
    {
        @* MultiLine renders cols="20" even when Columns is unset (WebForms default rendering) *@
        <textarea @attributes="ExtraAttributes" style="@ComputedStyle" id="@ClientID" class="@CssClass"
                  rows="@Rows" cols="@(Columns > 0 ? Columns : 20)" wrap="@(Wrap ? null : "off")"
                  disabled="@(!Enabled)" readonly="@ReadOnly"
                  @oninput="HandleInput" @onchange="HandleChange">@Text</textarea>
    }
    else
    {
        <input @attributes="ExtraAttributes" style="@ComputedStyle" type="@HtmlInputType" id="@ClientID"
               class="@CssClass" value="@EffectiveValue" disabled="@(!Enabled)"
               readonly="@ReadOnly" maxlength="@(MaxLength > 0 ? MaxLength : (int?)null)"
               @oninput="HandleInput" @onchange="HandleChange" />
    }
}

@code {
    /// <summary>Drawn by the markup above, not by the Render(HtmlTextWriter) protocol.</summary>
    protected override bool UsesRazorRendering => true;

    private string _text = string.Empty;

    /// <summary>WebForms TextBox.Text equivalent. Readable and writable from code-behind.</summary>
    [Parameter]
    public virtual string Text
    {
        get => _text;
        set
        {
            SetAndRefresh(ref _text, value ?? string.Empty);
            // A value set by code is the new baseline, as ViewState made it in WebForms:
            // TextChanged compares what the user committed against what the page last had.
            _committed = _text;
        }
    }

    private string _committed = string.Empty;

    /// <summary>
    /// WebForms TextBox.TextChanged. Raised once when the user COMMITS a different value
    /// (the DOM change event - blur or Enter), not per keystroke: WebForms raised it on the
    /// postback after the value differed from the one the page last rendered, and a
    /// per-keystroke event would run the handler many times for one edit. Ported code
    /// subscribes to it from code (n2cms's DatePicker does), which is why it is a C# event.
    /// </summary>
    public event EventHandler TextChanged;

    /// <summary>WebForms TextBox.OnTextChanged - virtual, so a ported subclass can react first.</summary>
    protected virtual void OnTextChanged(EventArgs e) => TextChanged?.Invoke(this, e);

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int MaxLength { get; set; }
    [Parameter] public int Rows { get; set; } = 2;
    [Parameter] public int Columns { get; set; }

    /// <summary>MultiLine wrapping (false renders wrap="off", WebForms compatible).</summary>
    [Parameter] public bool Wrap { get; set; } = true;

    /// <summary>
    /// WebForms TextBox.TextMode.
    ///
    /// The ENUM, as in System.Web. It was a string, and that broke both halves of the job:
    /// code-behind assigning "textBox.TextMode = TextBoxMode.Number" - which is the only
    /// way WebForms lets you write it - did not compile, and the renderer compared against
    /// two string literals, so every HTML5 mode silently rendered type="text".
    /// </summary>
    [Parameter] public virtual TextBoxMode TextMode { get; set; } = TextBoxMode.SingleLine;

    /// <summary>
    /// WebForms TextBox.AutoPostBack / CausesValidation. Plain properties, not parameters:
    /// the change event already raises TextChanged on commit (see HandleChange), which is
    /// what AutoPostBack=true produced; ported subclasses and code-behind set them.
    /// </summary>
    public bool AutoPostBack { get; set; }

    /// <inheritdoc cref="AutoPostBack"/>
    public bool CausesValidation { get; set; }

    /// <summary>
    /// WebForms TextBox.ValidationGroup equivalent. Only meaningful with AutoPostBack
    /// validation in WebForms; accepted here so markup ports unchanged (no behavior).
    /// </summary>
    [Parameter] public string ValidationGroup { get; set; }

    /// <summary>WebForms AutoCompleteType equivalent. No effect in modern browsers; accepted as a no-op.</summary>
    public string AutoCompleteType { get; set; }

    /// <summary>
    /// The input type WebForms renders for each mode. 4.5 added the HTML5 modes precisely
    /// so the browser would show a date picker or a numeric spinner, so rendering them all
    /// as type="text" is not a cosmetic difference - the control loses the behaviour it
    /// was set to have.
    ///
    /// The names that differ from the enum member are WebForms' own: Phone renders "tel",
    /// DateTimeLocal renders "datetime-local", and DateTime renders "datetime" (a type no
    /// browser implements any more, which is what 4.8 emits and therefore what matches).
    /// </summary>
    private string HtmlInputType => TextMode switch
    {
        TextBoxMode.Password => "password",
        TextBoxMode.Color => "color",
        TextBoxMode.Date => "date",
        TextBoxMode.DateTime => "datetime",
        TextBoxMode.DateTimeLocal => "datetime-local",
        TextBoxMode.Email => "email",
        TextBoxMode.Month => "month",
        TextBoxMode.Number => "number",
        TextBoxMode.Range => "range",
        TextBoxMode.Search => "search",
        TextBoxMode.Phone => "tel",
        TextBoxMode.Time => "time",
        TextBoxMode.Url => "url",
        TextBoxMode.Week => "week",
        _ => "text",
    };

    /// <summary>
    /// WebForms renders no value attribute when Text is empty, letting an expando
    /// value attribute (Value='<%# ... %>' with no Text property set) supply the
    /// input's value. The explicit attribute here overrides the @attributes splat,
    /// so reproduce that precedence explicitly.
    /// </summary>
    private string EffectiveValue
        => _text.Length == 0 && ExtraAttributes.TryGetValue("value", out var expando)
            ? expando?.ToString()
            : _text;

    private void HandleInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;
        MarkStateTouched(); // after user input, never roll back to the markup initial value
    }

    private void HandleChange(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;
        if (!string.Equals(_text, _committed, StringComparison.Ordinal))
        {
            _committed = _text;
            OnTextChanged(EventArgs.Empty);
        }
    }

    public string GetControlValue() => _text;
}
