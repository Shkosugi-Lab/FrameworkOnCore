@namespace WebForm2Blazor.Components
@inherits ValidatorBase
@using System.Text.RegularExpressions

@if (ShowError)
{
    <span @attributes="ExtraAttributes" style="@SpanStyle" id="@ClientID" class="@ResolvedCssClass">@DisplayText</span>
}

@code {
    [Parameter] public string ValidationExpression { get; set; }

    protected override bool EvaluateIsValid(string value, WebFormsHostCore host)
    {
        if (string.IsNullOrEmpty(value))
        {
            return true;
        }
        if (string.IsNullOrEmpty(ValidationExpression))
        {
            return true;
        }

        // As in WebForms, the whole string must match the pattern (implicit anchors)
        var match = Regex.Match(value, ValidationExpression);
        return match.Success && match.Index == 0 && match.Length == value.Length;
    }
}
