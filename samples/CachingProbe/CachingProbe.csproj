<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Caching as IIS runs it, against the converted application's (experiments/wf4c/sample-parity.ps1): the output cache
       (VaryByParam, a profile of web.config's, post-cache substitution, a page taken out, a page depending on a cache
       item), the cache headers of OutputCache's locations and of the cache policy set in code, the application cache
       (expirations, key and file dependencies, Add, Remove, the removal callbacks), and the static files: their cache
       headers (system.webServer/staticContent/clientCache) and types (mimeMap, the types IIS knows). -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
