<Project Sdk="Microsoft.NET.Sdk">
  <!-- Analyzers the converter runs in the converted applications' build (BuildFixer: -p:CustomAfterMicrosoftCommonTargets)
       to find, with the compiler's semantic model, what it rewrites. Their warnings locate the rewrites; the converted
       projects do not keep them. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Not shipped as a package: no release tracking. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The oldest compiler it runs in: .NET SDK 9's (params spans, ICollectionExpressionOperation; the converted
         applications build with .NET 10's). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
