From 0503b74913ef4588c793c61b0a23e02204d4d36d Mon Sep 17 00:00:00 2001
From: shkosugi <sin.kosugi@gmail.com>
Date: Wed, 30 Sep 2026 18:16:20 +0900
Subject: [PATCH] LINQ to SQL: built without DEBUG, as .NET Framework's
 System.Data.Linq was

The sources' 150 Debug.Assert (and #if DEBUG code) are checks of the original's development, compiled
out of the shipped assembly; some are not true for what it does (SqlProvider.SingleResult asserts an
execute result, which DataContext.Translate(DbDataReader) does not have), and on .NET a failed
Debug.Assert ends the process ("Process terminated. Assertion failed."). The project drops DEBUG in
every configuration, so a Debug build (a test's ProjectReference) is the shipped one too.

Found by FrameworkOnCore's System.Data.Linq parity cases (tests/DataLinqParity: every API of the
assembly, compared with .NET Framework 4.8's).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../WebFormsForCore.Data.Linq.csproj                   | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj b/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj
index faf0137..2546d6d 100644
--- a/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj
+++ b/src/WebFormsForCore.Data.Linq/WebFormsForCore.Data.Linq.csproj
@@ -67,6 +67,16 @@
 
     <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
 
+    <!-- Without DEBUG in every configuration, as .NET Framework's System.Data.Linq was built: the sources' 150
+         Debug.Assert (and #if DEBUG code) are checks of the original's development, some of them not true for what
+         the shipped assembly does (SingleResult asserts an execute result, which Translate(DbDataReader) does not
+         have), and on .NET a failed Debug.Assert ends the process. Found by the parity cases (tests/DataLinqParity). -->
+    <Target Name="FocWithoutDebugConstant" BeforeTargets="CoreCompile">
+        <PropertyGroup>
+            <DefineConstants>$([System.Text.RegularExpressions.Regex]::Replace(';$(DefineConstants);', ';DEBUG;', ';').Trim(';'))</DefineConstants>
+        </PropertyGroup>
+    </Target>
+
     <PropertyGroup>
         <!-- The ECMA key, System.Data.Linq's original identity (b77a5c561934e089). -->
         <StrongNamePublicKey>00000000000000000400000000000000</StrongNamePublicKey>
-- 
2.55.0.windows.3

